
# mdBook build output (regenerated locally)
docs/book/

# makepkg build artifacts in pkgbuilds/ (only PKGBUILDs are tracked)
pkgbuilds/*/src/
pkgbuilds/*/pkg/
pkgbuilds/*/*.pkg.tar.zst
pkgbuilds/*/*.log
pkgbuilds/kpeoplevcard-qt6/kpeoplevcard/

# Active-theme override, rewritten by every `theme set`/`theme random`
# (incl. each unlock) — merges over the tracked .chezmoidata/theme.yaml
# default; tracking it would keep the repo permanently dirty.
.chezmoidata/zz-theme-override.yaml

# py_compile drops these next to the script it checks; they are build
# artifacts, and under dot_local/bin/ chezmoi would DEPLOY them to
# ~/.local/bin/__pycache__/.
**/__pycache__/
*.pyc
