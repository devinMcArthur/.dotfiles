{
  // Omarchy-inspired minimal bar: flat, monochrome, no per-module cards.
  // Left: workspaces · Center: clock · Right: compact icon cluster.
  // Dropped from the old bar: weather, window title, temperature, backlight,
  // mic module (swayosd gives volume/mic/brightness feedback now), split
  // date/time clocks.
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 30,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "custom/power_profile",
    "custom/sysinfo",
    "bluetooth",
    "network",
    "pulseaudio",
    "battery"
  ],
  "hyprland/workspaces": {
    // Occupied workspaces only (persistent 1-10 was 10 numbers of noise
    // across three monitors); numbers stay pinned per-monitor via
    // hyprland.conf workspace rules.
    "disable-scroll": true,
    "all-outputs": true,
    "on-click": "activate"
  },
  "clock": {
    // Single centered clock, Omarchy-style. Click opens a calendar flyout
    // (yad, Windows-style — closes on unfocus or second click).
    "format": "{:%A %H:%M}",
    "on-click": "~/.config/waybar/scripts/calendar.sh",
    "tooltip-format": "{:%A, %e %B %Y}",
    "interval": 60
  },
  "idle_inhibitor": {
    // Caffeine toggle: click to keep the machine awake. Uses the Wayland
    // idle-inhibit protocol, which hypridle honors — no processes killed,
    // and the power-aware timeouts resume the moment it's deactivated.
    // (State resets if waybar restarts.)
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "tooltip-format-activated": "Caffeine: staying awake (idle/lock inhibited)",
    "tooltip-format-deactivated": "Idle timeouts active — click to stay awake"
  },
  "custom/power_profile": {
    // Power-profiles-daemon current profile; left-click cycles forward.
    "exec": "~/.config/waybar/scripts/power-profile.sh status",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/power-profile.sh next && pkill -SIGRTMIN+8 waybar",
    "signal": 8
  },
  "custom/sysinfo": {
    // CPU% + MEM% in the bar; hover for a rich popup (load, top procs).
    // Left-click opens btop in a Ghostty window.
    "exec": "~/.config/waybar/scripts/sysinfo.sh",
    "return-type": "json",
    "interval": 2,
    "tooltip": true,
    "on-click": "ghostty --class=sysmon -e btop"
  },
  "bluetooth": {
    // Click opens bluetui (same floating TUI as Super+Shift+B)
    "on-click": "ghostty --class=tui.bluetooth -e bluetui",
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": " {num_connections}",
    "tooltip-format": "{device_alias}",
    "tooltip-format-connected": " {device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}"
  },
  "network": {
    // Click opens impala (same floating TUI as Super+I). Hover: SSID with
    // band + signal, IP, and LIVE ⇣/⇡ throughput (Omarchy's trick — the
    // 3s interval keeps the bandwidth numbers ticking while you hover).
    "on-click": "ghostty --class=tui.wifi -e impala",
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰀂",
    "format-linked": "󰀂",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({frequency} GHz · {signalStrength}%)\n{ifname} · {ipaddr}\n⇣ {bandwidthDownBytes}   ⇡ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}/{cidr}\n⇣ {bandwidthDownBytes}   ⇡ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "tooltip-format": "{desc} — {volume}%",
    "on-click": "pamixer -t",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    }
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "interval": 10
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
