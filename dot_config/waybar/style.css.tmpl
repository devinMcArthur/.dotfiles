/* Omarchy-inspired minimal bar — flat, monochrome, no per-module cards.
   Palette: Catppuccin Mocha. Color is reserved for state (urgent, critical,
   caffeine active); everything at rest is quiet text on the bar. */

* {
    border: none;
    border-radius: 0;
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
    font-weight: 500;
    min-height: 0;
}

window#waybar {
    /* alpha() not #rrggbbaa: waybar/wofi are GTK3, whose CSS parser
       rejects 8-digit hex ("Junk at end of value") and kills the bar. */
    background: alpha(#{{ .theme.colors.base }}, 0.9);   /* base */
    color: #{{ .theme.colors.text }};                          /* text */
}

tooltip {
    background: #{{ .theme.colors.base }};
    border: 1px solid #{{ .theme.colors.surface0 }};               /* surface0 */
    border-radius: 8px;
}

/* --- Workspaces (left) --------------------------------------------------- */
#workspaces button {
    padding: 0 6px;
    margin: 0 1px;
    background: transparent;
    color: #{{ .theme.colors.overlay0 }};                          /* overlay0 — inactive */
}

#workspaces button.active {
    color: #{{ .theme.colors.text }};
}

#workspaces button.urgent {
    color: #{{ .theme.colors.red }};                          /* red */
}

#workspaces button:hover {
    background: transparent;
    color: #{{ .theme.colors.text }};
    box-shadow: none;
    text-shadow: none;
}

#workspaces {
    margin-left: 8px;
}

/* --- Right-side cluster: even quiet spacing, no boxes -------------------- */
#clock,
#idle_inhibitor,
#custom-power_profile,
#custom-sysinfo,
#bluetooth,
#network,
#pulseaudio,
#battery,
#tray {
    background: transparent;
    padding: 0;
    margin: 0 8px;
}

#battery {
    margin-right: 12px;
}

/* --- State colors (the only color on the bar) ---------------------------- */
#idle_inhibitor.activated {
    color: #{{ .theme.colors.red }};                          /* red — holding machine awake */
}

#custom-sysinfo.warning {
    color: #{{ .theme.colors.yellow }};                          /* yellow */
}

#custom-sysinfo.critical {
    color: #{{ .theme.colors.red }};
}

#network.disconnected {
    color: #{{ .theme.colors.red }};
}

#battery.warning {
    color: #{{ .theme.colors.yellow }};
}

#battery.critical:not(.charging) {
    color: #{{ .theme.colors.red }};
}
