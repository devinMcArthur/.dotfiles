[Unit]
Description=Periodically drop herdr attach sessions with no client

[Timer]
# Two minutes. Orphans appear on every dropped connection and each one
# can block a reconnect, so the window where a pane is unusable should be
# shorter than the time it takes to notice and ask. Only the newest attach per
# pane survives, so a live client is never the one reaped.
OnBootSec=2min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
