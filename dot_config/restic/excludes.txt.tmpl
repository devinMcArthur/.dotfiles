# restic excludes for laptop-backup — reproducible machinery stays out.
# Real data (work/, personal/, learning/, .config profiles, dotfiles,
# .claude memories, SecondBrain) stays IN. ~130G excluded of ~251G home.

# Caches & trash
{{ .chezmoi.homeDir }}/.cache
{{ .chezmoi.homeDir }}/.local/share/Trash
{{ .chezmoi.homeDir }}/Downloads

# VM & emulator disk images (rebuildable; win11 has its own snapshots)
{{ .chezmoi.homeDir }}/vms
{{ .chezmoi.homeDir }}/.android
{{ .chezmoi.homeDir }}/Android

# Package-manager & toolchain stores (reinstallable)
{{ .chezmoi.homeDir }}/.npm
{{ .chezmoi.homeDir }}/.nvm
{{ .chezmoi.homeDir }}/.gradle
{{ .chezmoi.homeDir }}/.cargo/registry
{{ .chezmoi.homeDir }}/.cargo/git
{{ .chezmoi.homeDir }}/go/pkg
{{ .chezmoi.homeDir }}/.bun/install/cache
{{ .chezmoi.homeDir }}/.local/share/pnpm
{{ .chezmoi.homeDir }}/.local/share/nvim
{{ .chezmoi.homeDir }}/.local/share/voxtype/models

# Per-project build/dependency dirs (regenerated by installs/builds)
**/node_modules
**/target/debug
**/target/release
**/.venv
**/__pycache__
**/.pytest_cache
**/.direnv

# App-embedded caches inside kept trees
**/Cache
**/CachedData
**/GPUCache
