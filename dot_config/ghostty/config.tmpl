# Terminal palette from the shared theme ({{ .theme.name }} — see
# .chezmoidata/theme.yaml). Theming the terminal also themes everything
# that renders with ANSI colors: bat/delta ("ansi" syntax theme), zsh
# highlighting, TUIs without their own theme, etc.
theme = {{ .theme.ghostty }}
background-opacity=0.8
window-decoration=false
confirm-close-surface=false

# Optional include, written by `ghostty-crt` (Super+Alt+C). The leading ?
# means "load if present" — with the CRT off the file is empty and this
# line costs nothing.
config-file = ?crt.conf
