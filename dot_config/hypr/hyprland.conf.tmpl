### MY PROGRAMS ###
###################

# See https://wiki.hyprland.org/Configuring/Keywords/ for more

$terminal = ghostty
$browser = firefox
$fileManager = thunar
$lock = $HOME/.local/bin/hypr-lock
$menu = wofi --show drun

#################
### AUTOSTART ###
#################

# Execute your favorite apps at launch.
#
# Portal env propagation: export Wayland/XDG vars to the systemd user
# session + D-Bus activation environment BEFORE portals get lazily
# activated by the first sandboxed app. `--all` covers WAYLAND_DISPLAY,
# XDG_CURRENT_DESKTOP, XCURSOR_*, QT_QPA_PLATFORMTHEME, GTK_THEME, etc.
# in one shot (replaces the old killall+restart workaround).
exec-once = dbus-update-activation-environment --systemd --all
exec-once = systemctl --user import-environment --all

# Polkit authentication agent (the password dialog 1Password's system-auth
# and pkexec pop up). Soteria: GTK4/libadwaita — modern dialog with proper
# spacing that follows the prefer-dark gsettings. (Replaced hyprpolkitagent,
# whose QML dialog had cramped layout and dark-on-dark text even with Qt
# Material theming; it stays installed as a fallback.) Like the old agent,
# its service WantedBy=graphical-session.target only triggers under UWSM,
# so we kick it manually; Restart=on-failure supervision comes free.
exec-once = systemctl --user start soteria.service

# Dictation daemon (F12 push-to-talk). Same WantedBy=graphical-session.target
# trap as soteria: the target never fires under greetd without UWSM, so the
# enabled unit sits dead until kicked.
exec-once = systemctl --user start voxtype.service

# Ends a dictation after ~2s of silence (so a spoken "submit" sends
# itself — no second Super+X). Disable: voxtype-autostop off
exec-once = $HOME/.local/bin/voxtype-autostop

# herdr (agent multiplexer) server. Starting it at login restores the
# saved session shape — workspaces, tabs, panes, cwd, layout — and
# resumes supported agent conversations (its Claude Code integration is
# installed), so a terminal running `herdr` attaches to everything
# already back in place instead of rebuilding it by hand. Headless: no
# window appears until you attach.
exec-once = $HOME/.local/bin/herdr server
# herdr-mirror daemon: puts the dev box's agents in this sidebar. The
# plugin also starts it when a mirrored workspace is focused, but after a
# reboot there is no mirrored workspace to focus until the daemon has run
# once — it creates them. So start it here too.
exec-once = $HOME/.local/bin/herdr-mirror start

# Voice commands: say "turing, workspace three" (wake word + fixed
# grammar, all local). Off: voice-control off | spoken "turing sleep"
exec-once = $HOME/.local/bin/voice-control

# --- Desktop shell: DankMaterialShell TRIAL (Quickshell) --------------------
# One process replaces the waybar+swaync+swayosd federation: bar with real
# interactive panels (network Wi-Fi toggle, bluetooth, audio), control
# center, notifications, OSD, spotlight launcher. Theme comes from the
# chezmoi-rendered ~/.config/DankMaterialShell/dank-theme.json (reactive —
# theme set / theme random re-render it and DMS live-updates).
# REVERT: comment `dms run`, uncomment the three lines below, restore the
# wofi Super+Space bind and swayosd volume/brightness binds (git has them).
exec-once = dms run
# exec-once = waybar
# exec-once = swaync
# exec-once = swayosd-server
exec-once = hypridle
# hyprpaper retired: DMS owns the wallpaper (theme set drives it via
# `dms ipc call wallpaper set`; two background layers raced otherwise).
# exec-once = hyprpaper

# Phone integration (DMS Phone Connect plugin backend) — kdeconnectd must
# run for discovery/pairing (/usr/bin/kdeconnectd since 24.x — used to be
# under /usr/lib/kdeconnect/).
exec-once = kdeconnectd
exec-once = wl-paste --type text  --watch cliphist store   # clipboard history (text)
exec-once = wl-paste --type image --watch cliphist store   # clipboard history (images)
# Keep Wayland clipboard contents alive after the setting app exits. Without
# this, swappy's Copy button and `wl-copy < file` both evaporate the moment
# the source process dies, so pasting into Claude TUI / Telegram / anything
# else races the offer's lifetime. wl-clip-persist re-claims the offer as
# its own and keeps it available indefinitely.
exec-once = wl-clip-persist --clipboard regular
# Collapse dual file+image clipboard offers (Quick Capture copies) to
# image-only so pastes into text-preferring apps get the picture, not a
# file:// URI. See clip-normalize.
exec-once = wl-paste --watch $HOME/.local/bin/clip-normalize

# Relaunch the win11 virt-viewer on monitor dock/undock so its SPICE
# guest re-sizes to the now-current monitor (virt-viewer doesn't do this
# reliably across a live monitor change; see ~/.local/bin/win-monitor-watch).
exec-once = $HOME/.local/bin/win-monitor-watch

# Surprise theme every boot (hypr-lock does the same after every unlock).
# The sleep lets waybar/hyprpaper/swaync come up first so the switch's
# kill-and-relaunch lands on running daemons. Disable: theme random off
exec-once = sleep 3 && $HOME/.local/bin/theme random

