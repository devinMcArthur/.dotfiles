# Refer to https://wiki.hyprland.org/Configuring/Variables/

general {
    # https://wiki.hyprland.org/Configuring/Variables/#general

    gaps_in = 3
    gaps_out = 8

    border_size = 2

    # Catppuccin Mocha: yellow→peach gradient (echoes the moon + sunset in the
    # wallpaper). Inactive: surface0.
    col.active_border = rgba({{ .theme.colors.accent }}aa) rgba({{ .theme.colors.accent2 }}aa) 45deg
    col.inactive_border = rgba({{ .theme.colors.surface0 }}aa)

    # Set to true enable resizing windows by clicking and dragging on borders and gaps
    resize_on_border = false

    # Please see https://wiki.hyprland.org/Configuring/Tearing/ before you turn this on
    allow_tearing = false

    layout = dwindle
}

# https://wiki.hyprland.org/Configuring/Dwindle-Layout/
dwindle {
    preserve_split = true
}

# https://wiki.hyprland.org/Configuring/Variables/#decoration
decoration {
    rounding = 10

    active_opacity = 1.0
    inactive_opacity = 1.0

    blur {
        enabled = true
        size = 5
        passes = 2
        vibrancy = 0.17
    }
}

# https://wiki.hyprland.org/Configuring/Variables/#animations
animations {
    enabled = true

    bezier = myBezier, 0.05, 0.9, 0.1, 1.05

    animation = windows, 1, 7, myBezier
    animation = windowsOut, 1, 7, default, popin 80%
    animation = border, 1, 10, default
    animation = borderangle, 1, 8, default
    animation = fade, 1, 7, default
    animation = workspaces, 1, 6, default
}

# https://wiki.hyprland.org/Configuring/Variables/#misc
misc {
    disable_hyprland_logo = true
}

#############
### INPUT ###
#############

# https://wiki.hyprland.org/Configuring/Variables/#input
input {
    kb_layout = us
    kb_variant =
    kb_model =
    kb_options =
    kb_rules =

    follow_mouse = 1

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    touchpad {
        # false = "down is down", true = "down is up"
        natural_scroll = false
    }

}

# https://wiki.hypr.land/Configuring/Advanced-and-Cool/Gestures/
# 3-finger horizontal swipe on the touchpad switches workspaces.
# (Modern syntax — v0.49+. Old `gestures { workspace_swipe = true }` was removed.)
gesture = 3, horizontal, workspace

###################
### KEYBINDINGS ###
###################

# See https://wiki.hyprland.org/Configuring/Keywords/
$mainMod = SUPER # Sets "Windows" key as main modifier

# Example binds, see https://wiki.hyprland.org/Configuring/Binds/ for more
bind = $mainMod, return, exec, $terminal  #open the terminal
bind = $mainMod, B, exec, $browser # open the browser
# Super+O -> work Outlook PWA: focus the window if it's already open,
# otherwise launch it. Same "take me there" pattern as Super+W (the VM).
# The ULID is the PWAsForFirefox site id (`firefoxpwa profile list`); the
# standalone PWA window carries WM class FFPWA-<ULID>.
bind = $mainMod, O, exec, hyprctl clients -j | grep -q FFPWA-01KT4N89YPWXMQDN8T4TENQ5A6 && hyprctl dispatch focuswindow class:FFPWA-01KT4N89YPWXMQDN8T4TENQ5A6 || firefoxpwa site launch 01KT4N89YPWXMQDN8T4TENQ5A6 # Outlook (work email) — focus or launch
# Super+Shift+P -> phone SMS (kdeconnect-sms): same focus-or-launch pattern.
bind = $mainMod SHIFT, P, exec, hyprctl clients -j | grep -q 'org.kde.kdeconnect.sms' && hyprctl dispatch focuswindow class:org.kde.kdeconnect.sms || kdeconnect-sms # SMS (phone) — focus or launch
bind = $mainMod, Q, killactive, # close the active window
bind = $mainMod, M, exec, dms ipc call powermenu toggle # power menu (DMS; wlogout remains as the waybar-federation revert path)
# (Removed Super+Shift+M = exit — too close to the power menu bind, easy
# to mishit. Use the power menu's Logout entry to terminate Hyprland.)
bind = $mainMod, E, exec, $fileManager # Show the graphical file browser
bind = $mainMod, T, togglefloating, # toggle window float / tile
bind = $mainMod, SPACE, exec, dms ipc call launcher toggle # app launcher (DMS; wofi remains for scripts)
bind = $mainMod, P, pseudo, # dwindle
bind = $mainMod, Y, layoutmsg, togglesplit # dwindle
bind = $mainMod, F, fullscreen
bind = $mainMod, I, exec, ghostty --class=tui.wifi -e impala # Wi-Fi manager (impala TUI; nmtui still available in a shell)
bind = $mainMod SHIFT, B, exec, ghostty --class=tui.bluetooth -e bluetui # bluetooth manager (bluetui TUI)
bind = $mainMod, W, exec, $HOME/.local/bin/win # smart launcher for the win11 KVM VM (starts + attaches virt-viewer)
# Escape from the VM. virt-viewer in fullscreen uses the Wayland
# keyboard-shortcuts-inhibit protocol to grab ALL keys (including Super),
# so normal Hyprland binds stop working while focused on the viewer.
# `bindp` (bypass flag) overrides that grab — this chord ALWAYS reaches
# Hyprland, regardless of any app's inhibit request. Effect: jump to
# workspace 1, which unfocuses virt-viewer and restores all binds.
bindp = $mainMod SHIFT, W, workspace, 1
# Graceful VM shutdown from anywhere (bypass flag means it works even
# when virt-viewer is grabbing the keyboard). Sends Windows the ACPI
# power-button signal; same effect as Start → Power → Shut down.
bindp = $mainMod SHIFT, Q, exec, $HOME/.local/bin/win stop
bind = $mainMod SHIFT, slash, exec, $HOME/.local/bin/laptop-docs # Super+? → open laptop reference site (mdBook). Displaced the previous `movewindow mon:eDP-1` bind below — restore it if you want the comma/period/slash monitor-movement symmetry back.

# Screenshots: Quick Capture (DMS plugin) — audition passed, replacing the
# grim+swappy flow. Region/window/monitor into the full annotator
# (draw/arrows/text, OCR, QR, PDF export, history); Super+C = scrolling
# capture for taller-than-screen content. Old flow remains available as
# `hypr-screenshot` from a shell.
bind = $mainMod, S, exec, dms ipc call quickCapture screenshot region edit   # screenshot region → annotate
bind = $mainMod SHIFT, S, exec, dms ipc call quickCapture screenshot window edit # screenshot window → annotate
bind = $mainMod CTRL, S, exec, dms ipc call quickCapture screenshot output edit  # screenshot monitor → annotate
bind = $mainMod, C, exec, dms ipc call quickCapture screenshot scroll edit   # scrolling capture → annotate

# Screen recording: gpu-screen-recorder toggle (same bind stops + saves to ~/Videos)
bind = $mainMod ALT, S, exec, $HOME/.local/bin/hypr-record region            # record region (press again to stop)
bind = $mainMod ALT SHIFT, S, exec, $HOME/.local/bin/hypr-record output      # record monitor (press again to stop)

# OCR: select a region, extracted text lands on the clipboard (tesseract)
bind = $mainMod SHIFT, T, exec, $HOME/.local/bin/hypr-ocr                    # grab text from screen → clipboard

# Emoji picker (wofi-emoji: copies to clipboard / types into focused field)
bind = $mainMod CTRL, E, exec, wofi-emoji                                    # emoji picker

# Reminders: "<minutes> <message>" prompt → notification when time's up
bind = $mainMod CTRL, R, exec, $HOME/.local/bin/hypr-remind                  # set a reminder

# Dictation (voxtype, local whisper.cpp): tap Super+X to start recording,
# tap again to stop + transcribe into the focused input. Toggle, not
# hold-to-talk: a release bind on a modifier chord misfires when Super is
# released before X. Daemon: systemctl --user status voxtype
bind = SUPER, X, exec, voxtype record toggle                                 # dictation: toggle record/transcribe
bind = SUPER SHIFT, X, exec, voxtype record cancel                           # dictation: discard recording

# Claude Code spoken replies (claude-tts, local piper TTS): mute/unmute.
# Same flag the bar's Claude Voice pill flips; muting cuts speech mid-word.
bind = SUPER CTRL, V, exec, claude-tts toggle                                # claude voice: mute/unmute

# Type an instruction instead of speaking it: same grammar, same local
# model, same allowlist as the voice commands (see voice-control).
# Remote dev box: terminal straight into herdr over mosh. The address
# lives in ~/.config/devbox/host so rebuilding the box does not mean
# editing this file — `devbox host dev@<ip>`.
bind = $mainMod, D, exec, ghostty --title=devbox -e $HOME/.local/bin/devbox        # remote dev box (herdr)

bind = $mainMod, semicolon, exec, voice-control prompt                          # type a command (voice-control)

# Lock screen
bind = $mainMod, escape, exec, $lock                                           # lock the screen

# Clipboard history (cliphist + wofi with image thumbnails)
bind = $mainMod, V, exec, cliphist-menu                                        # clipboard history
bind = $mainMod ALT, V, exec, cliphist wipe                                    # wipe clipboard history

# Color picker (copies hex to clipboard)
bind = $mainMod SHIFT, C, exec, hyprpicker -a                                  # pick color under cursor

# Keybind cheatsheet
bind = $mainMod, F1, exec, $HOME/.local/bin/hypr-cheatsheet                                      # show keybind cheatsheet

# Theme switcher (wofi picker over themes/*.yaml — Omarchy's bind)
bind = $mainMod CTRL SHIFT, SPACE, exec, $HOME/.local/bin/theme menu                            # theme switcher menu

# Move focus with mainMod + arrow keys
bind = $mainMod, h, movefocus, l
bind = $mainMod, j, movefocus, d
bind = $mainMod, k, movefocus, u
bind = $mainMod, l, movefocus, r

# Move window in workspace with mainMod + shift + vim keys

bind = $mainMod SHIFT, H, movewindow, l
bind = $mainMod SHIFT, L, movewindow, r
bind = $mainMod SHIFT, K, movewindow, u
bind = $mainMod SHIFT, J, movewindow, d 

# Switch workspaces with mainMod + [0-9]
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Scroll through existing workspaces with mainMod + scroll
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Multi-monitor controls
bind = $mainMod, comma, focusmonitor, desc:Acer Technologies KA272 0x13800DD9
bind = $mainMod, period, focusmonitor, desc:Acer Technologies KA272 0x13800FAE
bind = $mainMod, slash, focusmonitor, eDP-1
bind = $mainMod SHIFT, comma, movewindow, mon:desc:Acer Technologies KA272 0x13800DD9
bind = $mainMod SHIFT, period, movewindow, mon:desc:Acer Technologies KA272 0x13800FAE
# bind = $mainMod SHIFT, slash, movewindow, mon:eDP-1  # displaced by Super+? → laptop-docs above
bind = $mainMod CTRL, comma, movecurrentworkspacetomonitor, desc:Acer Technologies KA272 0x13800DD9
bind = $mainMod CTRL, period, movecurrentworkspacetomonitor, desc:Acer Technologies KA272 0x13800FAE
bind = $mainMod CTRL, slash, movecurrentworkspacetomonitor, eDP-1
bind = $mainMod, Tab, swapactiveworkspaces, desc:Acer Technologies KA272 0x13800DD9 desc:Acer Technologies KA272 0x13800FAE

# Cycle workspaces on current monitor only
bind = $mainMod, bracketleft, workspace, m-1
bind = $mainMod, bracketright, workspace, m+1

# Special workspace (scratchpad)
bind = $mainMod, grave, togglespecialworkspace, scratch
bind = $mainMod SHIFT, grave, movetoworkspace, special:scratch

# Quick-notes scratchpad — dropdown ghostty+nvim, see hypr-notes script
bind = $mainMod, N, exec, $HOME/.local/bin/hypr-notes # quick notes scratchpad (dropdown nvim)

# AI-agent scratchpad — dropdown ghostty+claude, see hypr-agent script
bind = $mainMod, A, exec, $HOME/.local/bin/hypr-agent # AI agent scratchpad (dropdown claude)

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Framework Brightness — direct brightnessctl (DMS trial: swayosd retired;
# DMS's own OSD reacts to system changes).
bindel = ,XF86MonBrightnessDown, exec, brightnessctl s 10%-
bindel = ,XF86MonBrightnessUp, exec, brightnessctl s +10%

# Framework Volume + Media — direct wpctl; DMS watches PipeWire and draws
# its OSD on any change, so no OSD client needed in the bind.
bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindl  = , XF86AudioMute,        exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindl  = , XF86AudioMicMute,     exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle  # mic mute
bindl  = , XF86AudioPlay,        exec, playerctl play-pause
bindl  = , XF86AudioPause,       exec, playerctl play-pause
bindl  = , XF86AudioNext,        exec, playerctl next
bindl  = , XF86AudioPrev,        exec, playerctl previous

# will switch to a submap called resize
bind = ALT, R, submap, resize

# will start a submap called "resize"
submap = resize

# sets repeatable binds for resizing the active window
binde = , right, resizeactive, 10 0
binde = , left, resizeactive, -10 0
binde = , up, resizeactive, 0 -10
binde = , down, resizeactive, 0 10

# use reset to go back to the global submap
bind = , escape, submap, reset

# will reset the submap, which will return to the global submap
submap = reset

##############################
### WINDOWS AND WORKSPACES ###
##############################

# See https://wiki.hyprland.org/Configuring/Window-Rules/ for more
windowrule = opacity 0.8 0.8, match:class ghostty
windowrule = opacity 0.8 0.8, match:class thunar
windowrule = opacity 0.9 0.9, match:class firefox
windowrule = opacity 0.8 0.8, match:class slack

# Win11 VM viewer — live on workspace 5 ("the Windows room").
# Using v1 hyprlang syntax (match:class) because Hyprland 0.55 deprecated
# hyprlang in favor of Lua AND broke the v2 filter syntax (`class:^(...)$`)
# in the hyprlang `windowrule` parser. Bare action words like `float` /
# `tile` also stopped parsing (parser confuses them with v2 filter field
# names). Net effect: combined class+title rules are not expressible in
# hyprlang 0.55.2. The auth-dialog float rule was dropped here — will be
# restored once we migrate this whole config to hyprland.lua.
windowrule = workspace 5 silent, match:class virt-viewer

# Quick-notes scratchpad (SUPER+N → hypr-notes): pin to special:notes,
# float centered as a dropdown. NOTE: 0.56 parser accepts the value-form
# actions ("float on", "center on") — bare `float` still doesn't parse.
# Percentage sizes ("size 60% 70%") also parse but silently don't apply;
# pixels below are ~60%x70% of the laptop panel's 1920x1280 logical res.
# Class has a dot because ghostty --class requires a valid GTK app-id.
windowrule = workspace special:notes, match:class scratch.notes
windowrule = float on, match:class scratch.notes
windowrule = size 1152 896, match:class scratch.notes
windowrule = center on, match:class scratch.notes
windowrule = opacity 0.8 0.8, match:class scratch.notes

# Network/bluetooth TUIs (SUPER+I → impala, SUPER+SHIFT+B → bluetui): float
# centered like a quick panel instead of tiling into the layout. Same pixel
# caveat as scratch.notes (percentage sizes silently don't apply on 0.56).
windowrule = float on, match:class tui.wifi
windowrule = size 1000 700, match:class tui.wifi
windowrule = center on, match:class tui.wifi
windowrule = opacity 0.8 0.8, match:class tui.wifi
windowrule = float on, match:class tui.bluetooth
windowrule = size 1000 700, match:class tui.bluetooth
windowrule = center on, match:class tui.bluetooth
windowrule = opacity 0.8 0.8, match:class tui.bluetooth

# AI-agent scratchpad (SUPER+A → hypr-agent): same dropdown treatment as
# scratch.notes, sized wider for a chat TUI (panel logical res 1920x1280).
windowrule = workspace special:agent, match:class scratch.agent
windowrule = float on, match:class scratch.agent
windowrule = size 1440 1000, match:class scratch.agent
windowrule = center on, match:class scratch.agent
windowrule = opacity 0.9 0.9, match:class scratch.agent

# Theme picker (Super+Ctrl+Shift+Space → yad image list): float centered.
windowrule = float on, match:class theme.picker
windowrule = center on, match:class theme.picker

# Calendar flyout (bar clock click → yad calendar): float, Windows-style.
# Positioning is done by calendar.sh via movewindowpixel — windowrule
# `move` formulas (50%-w/2) silently don't parse on 0.56.
windowrule = float on, match:class bar.calendar
