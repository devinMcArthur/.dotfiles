# Authentication: run PAM (password) and fprintd (fingerprint) in parallel
# threads, accept whichever finishes first. PAM stack should NOT include
# pam_fprintd — it's handled directly here, otherwise password input blocks
# behind the fingerprint scan timeout.
auth {
    pam {
        enabled = true
        module  = hyprlock
    }

    fingerprint {
        enabled         = true
        ready_message   = Scan fingerprint or type password
        present_message = Scanning fingerprint…
        retry_delay     = 250
    }
}

background {
    monitor =
    path = ~/Pictures/wallpapers/{{ .theme.wallpaper }}   # supports png, jpg, webp (no animations, though)
    color = rgba({{ .theme.colors.base }}ff)        # Catppuccin Mocha base

    # all these options are taken from hyprland, see https://wiki.hyprland.org/Configuring/Variables/#blur for explanations
    blur_passes = 1 # 0 disables blurring
    blur_size = 7
    noise = 0.0117
    contrast = 0.8916
    brightness = 0.8172
    vibrancy = 0.1696
    vibrancy_darkness = 0.0
}

# --- Clock + date (theme-colored, above the input field) -------------------
label {
    monitor =
    text = $TIME
    color = rgb({{ .theme.colors.text }})
    font_size = 110
    font_family = Noto Sans
    shadow_passes = 2
    shadow_size = 4
    position = 0, 310
    halign = center
    valign = center
}
label {
    monitor =
    text = cmd[update:60000] date +"%A, %B %e"
    color = rgb({{ .theme.colors.subtext0 }})
    font_size = 22
    font_family = Noto Sans
    shadow_passes = 2
    shadow_size = 3
    position = 0, 215
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 400, 100
    outline_thickness = 2
    dots_size = 0.33 # Scale of input-field height, 0.2 - 0.8
    dots_spacing = 0.15 # Scale of dots' absolute size, -1.0 - 1.0
    dots_center = false
    dots_rounding = -1 # -1 default circle, -2 follow input-field rounding
    dots_fade_time = 200 # Milliseconds until a dot fully fades in
    dots_text_format = # Text character used for the input indicator. Leave empty for a rectangle that will be rounded via dots_rounding (default).
    # Catppuccin Mocha palette
    outer_color = rgb({{ .theme.colors.surface0 }})        # surface0
    inner_color = rgb({{ .theme.colors.mantle }})        # mantle
    font_color  = rgb({{ .theme.colors.text }})     # text
    font_family = Noto Sans # Font used for placeholder_text, fail_text and dots_text_format.
    fade_on_empty = true
    fade_timeout = 2000 # Milliseconds before fade_on_empty is triggered.
    placeholder_text = <i>Input Password...</i> # Text rendered in the input box when it's empty.
    hide_input = false
    rounding = -1 # -1 means complete rounding (circle/oval)
    check_color = rgb({{ .theme.colors.yellow }})     # yellow (verifying)
    fail_color  = rgb({{ .theme.colors.red }})     # red (auth failed)
    fail_text = <i>$FAIL <b>($ATTEMPTS)</b></i> # can be set to empty
    fail_timeout = 2000 # milliseconds before fail_text and fail_color disappears
    fail_transition = 300 # transition time in ms between normal outer_color and fail_color
    capslock_color = -1
    numlock_color = -1
    bothlock_color = -1 # when both locks are active. -1 means don't change outer color (same for above)
    invert_numlock = false # change color if numlock is off
    swap_font_color = false # see below

    position = 0, -20
    halign = center
    valign = center
}
