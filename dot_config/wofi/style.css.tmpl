/* ~/.config/wofi/style.css — chezmoi-managed.
 * Catppuccin Mocha palette. Soft, rounded, blurred-feel even without
 * compositor blur (Hyprland does its own blur on the layer).
 */

* {
  font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
  font-size: 13px;
}

window {
  margin: 0;
  padding: 0;
  background-color: alpha(#{{ .theme.colors.base }}, 0.96);    /* base, near-opaque (alpha() — GTK3 rejects #rrggbbaa) */
  border: 2px solid #{{ .theme.colors.surface2 }};                   /* surface2 */
  border-radius: 14px;
  color: #{{ .theme.colors.text }};                              /* text */
}

#outer-box {
  margin: 0;
  padding: 12px;
  border: none;
  background-color: transparent;
  border-radius: 14px;
}

#input {
  margin: 0 0 10px 0;
  padding: 10px 14px;
  border: 1px solid #{{ .theme.colors.surface1 }};                   /* surface1 */
  border-radius: 10px;
  background-color: #{{ .theme.colors.mantle }};                   /* mantle */
  color: #{{ .theme.colors.text }};
  caret-color: #{{ .theme.colors.yellow }};                        /* yellow */
}

#input:focus {
  border-color: #{{ .theme.colors.peach }};                       /* peach */
  outline: none;
}

#input image {
  color: #{{ .theme.colors.subtext0 }};                              /* subtext0 */
  margin-right: 8px;
}

#inner-box {
  margin: 0;
  padding: 0;
  border: none;
  background-color: transparent;
}

#scroll {
  margin: 0;
  padding: 0;
  border: none;
  background-color: transparent;
}

#entry {
  margin: 1px 0;
  padding: 8px 10px;
  border: none;
  border-radius: 8px;
  background-color: transparent;
  color: #{{ .theme.colors.text }};
}

#entry:hover {
  background-color: #{{ .theme.colors.surface0 }};                   /* surface0 */
}

#entry:selected {
  background-color: #{{ .theme.colors.surface1 }};                   /* surface1 */
  color: #{{ .theme.colors.yellow }};                              /* yellow */
}

#entry:selected #text {
  color: #{{ .theme.colors.yellow }};
}

#text {
  color: #{{ .theme.colors.text }};
  margin-left: 6px;
}

#img {
  margin-right: 8px;
}

#img:selected {
  background-color: transparent;
}
