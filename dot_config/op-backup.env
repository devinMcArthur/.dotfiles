# laptop-backup secrets — op:// references resolved at runtime by
# ~/.local/bin/laptop-backup (never at rest, same pattern as op-dev.env).
# Kept separate from op-dev.env so with-secrets doesn't inject backup
# credentials into claude/pi environments.
# Plain KEY="value" lines are exported as-is; op:// lines via `op read`.
AWS_ACCESS_KEY_ID="op://Dev Secrets/cloudflare-turing-backup/access_key_id"
AWS_SECRET_ACCESS_KEY="op://Dev Secrets/cloudflare-turing-backup/secret_access_key"
RESTIC_PASSWORD="op://Dev Secrets/cloudflare-turing-backup/restic_password"
# hostname field = https://<account>.r2.cloudflarestorage.com/turing-backup
R2_ENDPOINT="op://Dev Secrets/cloudflare-turing-backup/hostname"
