# herdr — agent multiplexer. Rendered by chezmoi from .chezmoidata theme
# tokens, so `theme set` re-themes it like everything else (the theme
# script calls `herdr server reload-config`, which applies live).
#
# tmux is still installed and still works — it keeps the SSH and
# long-haul-persistence role, where twenty years of tmux beats a young
# project. herdr owns the local agent workflow.

# herdr writes this key itself after the first run. Left out of the
# template it causes a permanent conflict — chezmoi prompts "changed
# since chezmoi last wrote it" on every apply, which on a headless box
# is a hard failure (no TTY). Same lesson as .pi/agent/settings.json:
# either do not manage app-written files, or encode what the app writes.
onboarding = false

[theme]
{{- $builtin := dict
    "catppuccin-mocha" "catppuccin"
    "gruvbox"          "gruvbox"
    "nord"             "nord"
    "rose-pine"        "rose-pine"
    "tokyo-night"      "tokyo-night"
    "matte-black"      "vesper" }}
name = "{{ if hasKey $builtin .theme.name }}{{ index $builtin .theme.name }}{{ else }}catppuccin{{ end }}"

# Base theme above gets the broad strokes; these pin the tokens that
# matter to the exact palette this repo is rendering everywhere else.
[theme.custom]
sidebar_bg    = "#{{ .theme.colors.mantle }}"
active_row_bg = "#{{ .theme.colors.surface0 }}"
selection_bg  = "#{{ .theme.colors.surface1 }}"
panel_bg      = "#{{ .theme.colors.base }}"
accent        = "#{{ .theme.colors.accent }}"
red           = "#{{ .theme.colors.red }}"
green         = "#{{ .theme.colors.green }}"

[keys]
# prefix stays ctrl+b. tmux here is ctrl+a, so the two can be nested
# without fighting — useful while migrating, harmless afterwards.
#
# Tab switching is prefix+h/l, not herdr's prefix+p/n — h/l is the vim
# horizontal pair, and tabs are what actually gets switched here (most
# tabs hold a single agent pane).
#
# That takes prefix+h/l away from pane focus, which is herdr's default
# for them, so pane focus moves out to prefix+alt+h/j/k/l. The result is
# a consistent ladder by scope: workspaces on prefix+shift, tabs bare,
# panes on prefix+alt. prefix+alt is already proven here (focus_agent,
# the scratch popup) — it is the bare alt chords that terminals eat.
#
# NOT ctrl+h/ctrl+l for anything: ctrl+h is ASCII backspace in a
# terminal, so the binding can never fire — it silently did nothing.
#
# prefix+s is the tmux choose-tree reflex, and as of 2026-09-19 it is
# herdr's OWN goto again, with our herdr-tab-picker moved out to
# prefix+shift+s. The swap is about machines, not taste.
#
# A keybinding can only run something of ours as a popup, and a popup is a
# separate process that speaks the socket API. That API has no machine
# concept at all — 103 methods, not one `machine.*` — because "which
# machine am I viewing" is state inside the CLIENT, and no server can
# change it. So our picker can LIST the box's tabs (`--machine box tab
# list` proxies to the box's server) but focusing one only moves focus
# over there; this client never budges. Measured on 0.9.1 for tab focus,
# workspace focus and agent focus alike.
#
# goto is the client, so it can cross machines. That is the one thing our
# picker cannot do, and it outranks goto bottoming out at panes — which is
# still not configurable in 0.9.1, and remains the reason the picker was
# written at all. herdr-mirror sidestepped this by copying the box's panes
# into the LOCAL server, which is why focusing them used to work.
#
# settings keeps prefix+g; prefix+shift+g (new_worktree) is untouched.
goto     = "prefix+s"
settings = "prefix+g"

previous_tab = "prefix+h"
next_tab     = "prefix+l"

focus_pane_left  = "prefix+alt+h"
focus_pane_down  = "prefix+alt+j"
focus_pane_up    = "prefix+alt+k"
focus_pane_right = "prefix+alt+l"

previous_workspace = "prefix+shift+h"
next_workspace     = "prefix+shift+l"
switch_workspace   = "prefix+shift+1..9"

# Agent hopping — unbound by default, and the whole reason for herdr:
# walk the sidebar to whichever agent is blocked.
next_agent     = "prefix+a"
previous_agent = "prefix+shift+a"
focus_agent    = "prefix+alt+1..9"

# Screen-history replay stays OFF (herdr's default): restored panes would
# re-render old output, and these panes carry 1Password material, tokens
# and command output. Layout and agent-session resume come back anyway.

# Scratch popup — the tmux `bind -n M-g display-popup -E -w 80% -h 80%`
# habit, kept. A session-modal terminal that does not disturb the layout;
# Ctrl+D exits the shell, which closes the popup, exactly as before.
#
# Bound BOTH ways deliberately: the bare alt+g matches the old reflex,
# but alt chords are the first thing a terminal or an outer tmux eats
# (see the ctrl+h lesson above), so prefix+alt+g is the guaranteed path.
# Our tab picker, now on prefix+shift+s. Lists every tab on every machine
# and focuses the chosen one — a local tab jumps, a box tab can only be
# pre-positioned (see the goto note above). Kept because tabs, not panes,
# are the useful leaf.
[[keys.command]]
key = "prefix+shift+s"
type = "popup"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-tab-picker"
width = "60%"
height = "50%"

[[keys.command]]
key = "alt+g"
type = "popup"
command = "{{ .chezmoi.homeDir }}/.local/bin/zsh-popup"
width = "80%"
height = "80%"

[[keys.command]]
key = "prefix+alt+g"
type = "popup"
command = "{{ .chezmoi.homeDir }}/.local/bin/zsh-popup"
width = "80%"
height = "80%"

# Images in a pane. Claude Code sends screenshots and diagrams through the
# Kitty graphics protocol; without this herdr shows the placeholder
# `[image] /path/...` and the picture never arrives. Ghostty speaks the
# protocol, so the only missing piece was herdr passing it through.
#
# Marked experimental upstream, and it only helps panes rendered locally —
# a mirrored pane's stream carries no graphics.
[experimental]
kitty_graphics = true
