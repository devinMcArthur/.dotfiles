{{- if eq .chezmoi.os "linux" -}}
{{- if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash
# Enable the daily laptop-backup timer (user-level, no sudo). The service
# itself skips cleanly when the 1Password vault is locked; staleness is
# surfaced by `laptop-backup status` and the laptop-update stage.

set -euo pipefail

systemctl --user daemon-reload
if ! systemctl --user is-enabled --quiet laptop-backup.timer 2>/dev/null; then
  systemctl --user enable --now laptop-backup.timer
  echo "==> laptop-backup.timer enabled (daily, persistent)"
fi
{{ end -}}
{{ end -}}
