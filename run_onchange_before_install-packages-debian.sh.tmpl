{{- if and (eq .chezmoi.os "linux") (ne .chezmoi.osRelease.id "arch") -}}
#!/usr/bin/env bash
# Server counterpart to install-packages (which is Arch/pacman only).
#
# A remote box gets the half of this setup that has no screen: shell,
# editor, multiplexer, git tooling, CLI utilities — plus the two things
# that make remote work bearable (mosh) and worth doing (an agent).
#
# Deliberately absent: Hyprland, the bar, themes, audio, voice, the
# Framework hardware bits. .chezmoiignore drops their config too, so a
# server never grows a half-configured desktop.

set -euo pipefail

echo "==> Installing server packages (apt)..."
export DEBIAN_FRONTEND=noninteractive

APT_PKGS=(
  zsh git curl wget less man-db unzip jq
  neovim tmux
  ripgrep fd-find fzf bat htop
  build-essential
  mosh                # the reason remote feels local: local echo over jitter
  ca-certificates
  gh                  # the private repo lives on GitHub; cloning needs it
  zoxide eza git-delta # same shell muscle memory as the laptop
)

# GitHub CLI is not in Debian/Ubuntu's repos — add the upstream one.
# Needed before the first apt-get update so it lands in one pass.
if ! command -v gh >/dev/null 2>&1; then
  sudo install -m 0755 -d /usr/share/keyrings
  curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | sudo tee /usr/share/keyrings/githubcli-archive-keyring.gpg >/dev/null
  sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
fi

sudo apt-get update -qq
sudo apt-get install -y -qq "${APT_PKGS[@]}"

# Node, system-wide. The laptop gets it from nvm, which is a shell
# construct — Tilt's local_resource steps (db-migrate, codegen) run npm
# from a plain non-login shell and simply fail with "npm: not found".
# LTS rather than the laptop's 25.x: these steps are tooling, not the app
# (the app itself builds in node:18 containers).
if ! command -v node >/dev/null 2>&1; then
  curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash - >/dev/null 2>&1
  sudo apt-get install -y -qq nodejs
  echo "    node $(node --version 2>/dev/null) installed"
fi

# dbmate — the migration runner bow-mark's `npm run db:migrate` shells
# out to. Packaged on Arch (pacman: dbmate), nowhere in Debian, so take
# the upstream release binary and pin the version the laptop runs.
DBMATE_VERSION="2.35.0"
if ! command -v dbmate >/dev/null 2>&1; then
  sudo curl -fsSL -o /usr/local/bin/dbmate \
    "https://github.com/amacneil/dbmate/releases/download/v${DBMATE_VERSION}/dbmate-linux-amd64"
  sudo chmod +x /usr/local/bin/dbmate
  echo "    dbmate $(dbmate --version 2>/dev/null | head -1) installed"
fi

# Cluster tooling. Installed WITHOUT credentials: a rented box gets the
# binaries so `doctl auth init` / `aws configure` are one interactive
# step away, but nothing that reaches production is planted here.
DOCTL_VERSION="1.115.0"
if ! command -v doctl >/dev/null 2>&1; then
  curl -fsSL "https://github.com/digitalocean/doctl/releases/download/v${DOCTL_VERSION}/doctl-${DOCTL_VERSION}-linux-amd64.tar.gz" \
    | sudo tar -xz -C /usr/local/bin doctl && echo "    doctl $(doctl version 2>/dev/null | head -1 | awk '{print $3}') installed"
fi
if ! command -v aws >/dev/null 2>&1; then
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/awscli.zip" "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
    && (cd "$tmp" && unzip -q awscli.zip && sudo ./aws/install >/dev/null 2>&1) \
    && echo "    aws cli installed"
  rm -rf "$tmp"
fi

# starship: the same prompt as the laptop, so the shell looks like home.
if ! command -v starship >/dev/null 2>&1; then
  curl -fsSL https://starship.rs/install.sh | sh -s -- --yes >/dev/null
  echo "    starship installed"
fi

# Claude Code — the point of a remote box: an agent that keeps working
# when the laptop sleeps, loses Wi-Fi or dies.
if [ ! -x "$HOME/.local/bin/claude" ]; then
  # Do NOT swallow the output: the first attempt left a versions/ dir and
  # no launcher, and the error was invisible because it went to /dev/null.
  curl -fsSL https://claude.ai/install.sh | bash || true
  [ -x "$HOME/.local/bin/claude" ] \
    || echo "    WARN: claude did not install — run the installer by hand and read the error"
fi

# herdr comes from run_onchange_after_herdr-install (no OS gate — the
# same static binary serves both machines).

# Debian names a couple of tools differently; bridge them so muscle
# memory and the shell config keep working.
mkdir -p "$HOME/.local/bin"
# Resolve via command -v rather than assuming /usr/bin: the Debian
# rename (fdfind/batcat) is what matters, not the path.
for pair in "fdfind:fd" "batcat:bat"; do
  src="${pair%%:*}"; dst="${pair##*:}"
  p="$(command -v "$src" 2>/dev/null)" && ln -sf "$p" "$HOME/.local/bin/$dst"
done

echo "==> Server packages done. Missing vs the laptop, by design:"
echo "    desktop (Hyprland/DMS/themes), audio, voice, Framework hardware."
{{ end -}}
