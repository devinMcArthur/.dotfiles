# Prompt: starship (see ~/.config/starship.toml).
eval "$(starship init zsh)"

# 1Password SSH agent. Replaces the oh-my-zsh ssh-agent plugin (which
# raced on parallel tmux pane restores post-reboot and prompted for the
# key passphrase in every pane). The socket is owned by the 1P desktop
# app and survives reboots; key passphrase lives in the vault. Enable
# under 1Password → Settings → Developer → "Use the SSH agent".
#
# Conditional so the export is a no-op when 1P isn't running (e.g.,
# initial setup before the toggle is flipped), preventing broken
# SSH_AUTH_SOCK references that would make ssh-add / git fail.
if [[ -S "$HOME/.1password/agent.sock" ]]; then
  export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
fi

# Secrets live in 1Password (see ~/.config/op-dev.env). We resolve them
# lazily, on-demand, per-command — NOT at shell startup.
#
# Implementation note: we deliberately do NOT use `op run --env-file=...`
# as a wrapper here. `op run` masks secrets in child stdout/stderr by
# pipe-interposing, which destroys the child's TTY — breaking pi's TUI
# (renders half-screen, can't exit) and claude (errors with "use stdin
# or --print"). Instead we resolve each op:// ref via `op read` directly
# in a subshell, export the values into that subshell's env, and `exec`
# into the target command. The target inherits the env normally and
# keeps its full TTY. Secrets never touch the parent shell.
#
# Offline note: works as long as the 1Password desktop app is running
# and unlocked (vault cached locally). Failures surface as explicit op
# errors, not silent empty env vars.
with-secrets() {
  (
    local key ref val
    while IFS='=' read -r key ref; do
      [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue
      ref=${ref#\"}; ref=${ref%\"}
      [[ "$ref" == op://* ]] || continue
      val=$(op read "$ref" 2>/dev/null) || {
        printf 'with-secrets: failed to read %s\n' "$ref" >&2
        return 1
      }
      [[ -n "$val" ]] && export "$key=$val"
    done < "$HOME/.config/op-dev.env"
    exec "$@"
  )
}

# Auto-inject for known TUI consumers.
command -v op >/dev/null 2>&1 && {
  alias pi='with-secrets pi-safe'
  # claude: prefer the 1Password-injected key, but do NOT refuse to start
  # without it. herdr resumes agent panes at login, when the vault is
  # still locked — with-secrets returns 1 before exec in that case, so a
  # plain alias would leave every restored pane dead on arrival. Claude
  # Code falls back to its own stored login when ANTHROPIC_API_KEY is
  # absent, which is the right outcome for an unattended restore.
  claude() {
    local ref
    ref="$(sed -n 's/^ANTHROPIC_API_KEY=//p' "$HOME/.config/op-dev.env" 2>/dev/null | tr -d '"')"
    if [[ -n "$ref" ]] && op read "$ref" >/dev/null 2>&1; then
      with-secrets claude "$@"
    else
      print -u2 "claude: 1Password locked — starting without ANTHROPIC_API_KEY"
      command claude "$@"
    fi
  }
}

# Silence Node's `ExperimentalWarning: SQLite is an experimental feature...`
# emitted at startup by the pi-knowledge-search worker (uses node:sqlite).
# Belt + suspenders: pi-safe sets this too, but if pi gets launched some
# other way (direct invocation, bypassed alias) we still want it silenced.
# Harmless for other Node apps — only experimental-feature warnings are
# affected, errors and other warnings still surface.
export NODE_OPTIONS="--disable-warning=ExperimentalWarning${NODE_OPTIONS:+ $NODE_OPTIONS}"

# Initialize completion system. Required before antidote loads plugins that
# register completions via `compdef` (e.g. omz git plugin).
autoload -Uz compinit && compinit

# Plugin manager: antidote (https://getantidote.github.io/).
# Plugin list: ~/.zsh_plugins.txt
source /usr/share/zsh-antidote/antidote.zsh
antidote load

# zsh-autosuggestions tuning ---------------------------------------------------
# Default fg=8 is invisible on many terminals. Use the theme's overlay0
# (palette: .chezmoidata/theme.yaml).
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#{{ .theme.colors.overlay0 }}'
# Combine history + completions for richer suggestions.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
# Accept full suggestion with Ctrl-Space (in addition to default → and End).
bindkey '^ ' autosuggest-accept

# --- ls replacement: eza ----------------------------------------------------
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -l --group-directories-first --icons=auto --git'
  alias la='eza -la --group-directories-first --icons=auto --git'
  alias lt='eza --tree --level=2 --icons=auto'
  alias lta='eza --tree --level=2 --icons=auto -a'
fi

# --- Waybar respawn --------------------------------------------------------
# exec-once only fires at Hyprland startup; a crash mid-session leaves no bar.
alias waybar-restart='killall waybar 2>/dev/null; nohup waybar >/dev/null 2>&1 & disown'

# --- Laptop reference site (mdBook) -----------------------------------------
# Opens http://localhost:3030 in a browser, starting `mdbook serve` if needed.
# Same script the Hyprland Super+F1 binding calls.
alias laptop-docs='$HOME/.local/bin/laptop-docs'

# --- fzf: colors from the shared palette (.chezmoidata/theme.yaml) ----------
# bg:-1 keeps fzf transparent so ghostty's background shows through.
export FZF_DEFAULT_OPTS="--color=bg:-1,bg+:#{{ .theme.colors.surface0 }},fg:#{{ .theme.colors.text }},fg+:#{{ .theme.colors.text }},hl:#{{ .theme.colors.red }},hl+:#{{ .theme.colors.red }},info:#{{ .theme.colors.mauve }},prompt:#{{ .theme.colors.mauve }},pointer:#{{ .theme.colors.rosewater }},marker:#{{ .theme.colors.lavender }},spinner:#{{ .theme.colors.rosewater }},header:#{{ .theme.colors.red }}"

# --- zoxide: smarter cd (`z <partial>` jumps to frecent dirs, `zi` fuzzy) ---
# Sesh already uses zoxide's db for session matching; this exposes `z`/`zi`
# directly in the shell. Run last so it can override compinit-registered cd.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# --- atuin: encrypted searchable history, replaces Ctrl-R -------------------
# Config: ~/.config/atuin/config.toml (offline-only, no sync).
# --disable-up-arrow leaves Up bound to traditional zsh history as a fallback;
# Ctrl-R opens atuin's fuzzy picker over the full DB.
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-up-arrow)"

# --- tmux helpers (restored from old oh-my-zsh tmux plugin) -----------------
# ts [name]  → new session (named if arg given)
# ta [name]  → attach (to named session if arg given)
ts() {
  if [[ -z $1 || ${1:0:1} == '-' ]]; then tmux new-session "$@"
  else tmux new-session -s "$@"; fi
}
ta() {
  if [[ -z $1 || ${1:0:1} == '-' ]]; then tmux attach "$@"
  else tmux attach -t "$@"; fi
}

# --- Omarchy-inspired shell helpers -----------------------------------------
# compress <file-or-dir> → <name>.tar.gz ; decompress <file.tar.gz>
compress() { tar -czvf "${1%/}.tar.gz" "${1%/}"; }
alias decompress='tar -xzvf'

# try [name] → cd into a fresh dated scratch dir under ~/tries.
# For experiments that deserve a directory but not a home. `try zig-http`
# on 2026-08-25 → ~/tries/2026-08-25-zig-http.
try() {
  local slug="${*:-scratch}"
  local dir="$HOME/tries/$(date +%F)-${slug// /-}"
  mkdir -p "$dir" && cd "$dir"
}

# SSH port forwards (secure-context testing on remote dev boxes without SSL):
#   fip <host> <port...>  → forward remote ports to localhost
#   lip                   → list active forwards
#   dip <port...>         → disconnect forwards
fip() {
  local host="$1"; shift 2>/dev/null
  if [[ -z "$host" || $# -eq 0 ]]; then
    echo "usage: fip <host> <port...>" >&2; return 2
  fi
  local p
  for p in "$@"; do
    ssh -fN -o ExitOnForwardFailure=yes -L "$p:localhost:$p" "$host" \
      && echo "localhost:$p ← $host:$p"
  done
}
lip() { pgrep -af '^ssh -fN' || echo 'no active forwards'; }
dip() {
  local p
  for p in "$@"; do
    pkill -f "^ssh -fN.*-L $p:localhost:$p" \
      && echo "closed :$p" || echo "no forward on :$p"
  done
}

# iso2sd <image.iso> — write an ISO to a USB drive. DESTRUCTIVE: erases the
# target drive. Only lists USB-transport disks, and requires confirmation.
iso2sd() {
  [[ -f "$1" ]] || { echo "usage: iso2sd <image.iso>" >&2; return 2 }
  local drive
  drive=$(lsblk -dno NAME,SIZE,MODEL,TRAN | awk '$NF=="usb"' \
    | fzf --prompt='write ISO to> ' --header='USB drives (everything on it will be ERASED)') || return
  drive="${drive%% *}"
  [[ -n "$drive" ]] || return 1
  echo "About to ERASE /dev/$drive and write: $1"
  read -q "?Press y to continue: " || { echo; return 1 }
  echo
  sudo dd if="$1" of="/dev/$drive" bs=4M status=progress oflag=sync && sync
}

# --- Images in the terminal, tmux and all -----------------------------------
# tmux blocks the Kitty graphics protocol unless it is passed through, which
# is why images "don't work" in a multiplexer by default. allow-passthrough
# is on (see .tmux.conf) and `kitten icat` detects tmux on its own; this is
# the short name, a chafa fallback for anywhere the protocol is unavailable
# (an ssh session, a plain tty), and a no-argument form that shows the most
# recent screenshot — the common case after a Super+S capture.
icat() {
  # null_glob: a missing screenshot directory must not abort the command,
  # which is what a bare glob does under zsh.
  setopt local_options null_glob
  local -a files=("$@")
  if (( ! $# )); then
    local -a shots=(~/Pictures/Screenshots/*(.) ~/Pictures/screenshots/*(.))
    (( $#shots )) || { echo "icat: no screenshots found" >&2; return 1; }
    # Newest across BOTH directories, so mtime ordering has to span them.
    files=("$(print -l $shots | xargs -r ls -t 2>/dev/null | head -1)")
    echo "${files[1]:t}"
  fi
  if command -v kitten >/dev/null 2>&1; then
    kitten icat --align left "${files[@]}"
  elif command -v chafa >/dev/null 2>&1; then
    chafa "${files[@]}"
  else
    echo "icat: install kitty (kitten) or chafa" >&2; return 1
  fi
}

# --- PATH (deduplicated via typeset -U; leftmost wins) -----------------------
typeset -U PATH path
export ANDROID_HOME="$HOME/Android/Sdk"
export BUN_INSTALL="$HOME/.bun"
path=(
  /opt/nvim-linux64/bin
  $HOME/.local/bin
  $BUN_INSTALL/bin
  $HOME/go/bin
  /usr/local/go/bin
  $ANDROID_HOME/platform-tools
  $ANDROID_HOME/emulator
  $ANDROID_HOME/tools
  $ANDROID_HOME/tools/bin
  $path
)
export PATH

# --- Lazy-load nvm, but eagerly expose the default node's bin ---------------
# Sourcing nvm.sh is the slow part (~250ms); adding the bin dir to PATH is free.
# This makes every globally-installed npm CLI (pi, tsc, prettier, …) work
# immediately, while still deferring nvm.sh until you actually switch versions.
export NVM_DIR="$HOME/.nvm"

if [ -d "$NVM_DIR/versions/node" ]; then
  _nvm_v="default"
  while [ -f "$NVM_DIR/alias/$_nvm_v" ]; do
    _nvm_v=$(<"$NVM_DIR/alias/$_nvm_v")
  done
  if [ ! -d "$NVM_DIR/versions/node/$_nvm_v" ]; then
    _nvm_v=$(ls "$NVM_DIR/versions/node" | sort -V | tail -1)
  fi
  [ -d "$NVM_DIR/versions/node/$_nvm_v/bin" ] && \
    PATH="$NVM_DIR/versions/node/$_nvm_v/bin:$PATH"
  unset _nvm_v
fi

_nvm_load() {
  unset -f nvm _nvm_load
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
}
nvm() { _nvm_load; nvm "$@"; }

# --- bun completions ---------------------------------------------------------
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# --- Tool completions (cached weekly under ~/.cache/zsh/) --------------------
_zsh_cache="${ZSH_CACHE_DIR:-$HOME/.cache/zsh}"
mkdir -p "$_zsh_cache"
for _tool in kubectl helm minikube skaffold; do
  command -v "$_tool" >/dev/null 2>&1 || continue
  _file="$_zsh_cache/_$_tool.zsh"
  if [[ ! -f $_file || -n $(find "$_file" -mtime +7 2>/dev/null) ]]; then
    "$_tool" completion zsh > "$_file" 2>/dev/null
  fi
  source "$_file"
done
unset _zsh_cache _tool _file

# --- AWS CLI completion (uses aws_completer, bash-style) ---------------------
if command -v aws_completer >/dev/null 2>&1; then
  autoload -Uz bashcompinit && bashcompinit
  complete -C aws_completer aws
fi

# --- Greeting (interactive terminals only, skip inside tmux/zellij/ssh) ------
if [[ -o interactive && -z "$TMUX" && -z "$ZELLIJ" && -z "$SSH_TTY" ]] && \
   command -v fastfetch >/dev/null 2>&1; then
  fastfetch
fi
