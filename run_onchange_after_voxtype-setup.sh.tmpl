{{- if eq .chezmoi.os "linux" -}}
{{- if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash
# Voxtype dictation setup: download the local Whisper model on first run and
# keep the transcription daemon enabled. Push-to-talk = hold F12 (see
# hyprland.conf); config = ~/.config/voxtype/config.toml. No sudo needed —
# everything is user-level.

set -euo pipefail

if ! command -v voxtype >/dev/null 2>&1; then
  echo "WARN: voxtype not installed (AUR install skipped?); re-run: chezmoi apply"
  exit 0
fi

if ! ls "$HOME/.local/share/voxtype/models/"*base.en* >/dev/null 2>&1; then
  echo "==> Downloading Whisper base.en model (~150MB, one-time)..."
  voxtype setup --download --model base.en --no-post-install
fi

if systemctl --user list-unit-files voxtype.service >/dev/null 2>&1; then
  systemctl --user enable --now voxtype.service
  # Config changes only take effect on restart; cheap and safe to always do.
  systemctl --user restart voxtype.service
  echo "==> Voxtype ready — hold F12 to dictate."
else
  echo "WARN: voxtype.service user unit not found; start the daemon manually"
  echo "      (voxtype daemon &) or add an exec-once to hyprland.conf."
fi
{{ end -}}
{{ end -}}
