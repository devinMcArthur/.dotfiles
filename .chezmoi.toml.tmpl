# Per-host chezmoi config, GENERATED at `chezmoi init` (not committed as a
# plain file — it carries the git identity, and this repo is public).
#
# machine: "laptop" or "server". Auto-detected from the distro, because
# this workstation is Arch and remote boxes are Debian-family; override
# at init with:  chezmoi init --promptString machine=server
#
# Everything gated on it lives in .chezmoiignore and the run_onchange
# scripts: a server skips Hyprland, the shell, themes, voice and the
# hardware setup, and keeps the shell, editor, multiplexer and CLI tools.
{{- $laptop := eq .chezmoi.osRelease.id "arch" -}}
{{- $defMachine := ternary "laptop" "server" $laptop -}}
{{- $defName := "Devin McArthur" -}}
{{- $defEmail := "itsdevinmcarthur@gmail.com" -}}
{{- $machine := $defMachine -}}
{{- $name := $defName -}}
{{- $email := $defEmail -}}
{{- /* Prompt only with a terminal: an unattended bootstrap (ssh, cloud-init)
       has no /dev/tty, and promptStringOnce hard-fails there — which is
       exactly the case a server bootstrap must survive. Interactive init
       still asks, and still reuses whatever the existing config holds. */ -}}
{{- if stdinIsATTY -}}
{{-   $machine = promptStringOnce . "machine" "machine class (laptop/server)" $defMachine -}}
{{-   $name = promptStringOnce . "name" "full name" $defName -}}
{{-   $email = promptStringOnce . "email" "git email" $defEmail -}}
{{- else -}}
{{-   if hasKey . "machine" }}{{ $machine = .machine }}{{ end -}}
{{-   if hasKey . "name" }}{{ $name = .name }}{{ end -}}
{{-   if hasKey . "email" }}{{ $email = .email }}{{ end -}}
{{- end }}

[data]
  name    = {{ $name | quote }}
  email   = {{ $email | quote }}
  machine = {{ $machine | quote }}

  # Profile selector — flip per machine.
  # Used in templates like:  {{ `{{ if eq .profile "work" }}` }} ... {{ `{{ end }}` }}
  profile = "personal"

[onepassword]
  command = "op"
  # Desktop-app integration handles auth on the laptop; a server needs a
  # service-account token in OP_SERVICE_ACCOUNT_TOKEN instead.
  prompt = false

[edit]
  command = "nvim"

[diff]
  pager = "less -R"
