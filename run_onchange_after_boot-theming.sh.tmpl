{{- if eq .chezmoi.os "linux" -}}
{{- if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash
# Boot + login theming (Omarchy-inspired), managed as one migration:
#   Greeter : DMS greeter (greetd-dms-greeter-bin, AUR) under Hyprland,
#             since 2026-10-22. It is DankMaterialShell's lock screen used as
#             the login screen, so it matches the desktop. `dms-greeter sync`
#             (run below, once) adds you to the `greeter` group, grants the
#             greeter read ACLs on your DMS state and wallpapers, and links
#             your per-user slot LIVE to that state: every `theme set` reaches
#             the login screen with no further sync and no sudo. Check with
#             `dms-greeter status`.
#             ReGreet (cage + Catppuccin card) was the greeter before; its
#             files below stay in place as the fallback.
#   Splash  : Plymouth `bgrt` theme (firmware logo + spinner), hook added to
#             mkinitcpio, `splash` kernel param. greetd already orders itself
#             After=plymouth-quit-wait.service, so handoff is native.
#   GRUB    : Catppuccin Mocha menu theme.
#
# Safety: every modified /etc file gets a timestamped .bak next to it; the
# pre-change initramfs images are kept as /boot/*.img.bak. Rebuilds
# (mkinitcpio/grub-mkconfig) run only when their inputs actually changed.
#
# ESCAPE HATCHES if boot looks wrong:
#   - No/broken splash: boot proceeds anyway (plymouth failure is cosmetic).
#     To disable: at the GRUB entry press `e`, remove `splash`, add
#     `plymouth.enable=0`, F10 to boot; then remove `splash` from
#     /etc/default/grub + `plymouth` from mkinitcpio HOOKS and rebuild.
#   - Broken greeter: Ctrl+Alt+F2 for a TTY, log in, then
#       sudo cp /etc/greetd/config.toml.regreet /etc/greetd/config.toml
#       sudo systemctl restart greetd
#     That is the ReGreet setup this replaced. (Older fallback:
#     config.toml.bak.tuigreet.) To make it stick, revert this script's
#     greeter section in git too, or the next full run rewrites it.

set -euo pipefail

GREETD_WANT='# greetd config — DMS greeter under Hyprland.
# Managed by chezmoi (run_onchange_after_boot-theming.sh). The ReGreet setup
# this replaced is kept at /etc/greetd/config.toml.regreet; copy it back over
# this file to revert (see the script header).

[terminal]
vt = 1

[default_session]
command = "/usr/bin/dms-greeter --command hyprland --cache-dir /var/cache/dms-greeter"
user = "greeter"'

# Whether we may prompt for a password. Sampled from stdin before any
# pipeline; the headless callers (theme switching on every unlock) redirect
# from /dev/null so this stays 0 and sudo is refused, never left waiting.
CAN_PROMPT=0
[ -t 0 ] && CAN_PROMPT=1

in_greeter_group() { id -nG "$USER" 2>/dev/null | tr ' ' '\n' | grep -qx greeter; }

# Fast path, NO sudo: everything already in place. Each check is readable
# without root.
# The greetd check matches the command, not the whole file: `dms-greeter
# sync` rewrites that line in its own format, and an exact comparison would
# then fail on every apply and ask for sudo forever.
if grep -qE '^command = ".*dms-greeter --command hyprland' /etc/greetd/config.toml 2>/dev/null \
   && pacman -Qq greetd-dms-greeter-bin >/dev/null 2>&1 \
   && in_greeter_group \
   && grep -qE '^HOOKS=.* plymouth ' /etc/mkinitcpio.conf \
   && grep -q 'splash' /etc/default/grub; then
  exit 0
fi

if ! sudo -n true 2>/dev/null && [ "$CAN_PROMPT" != 1 ]; then
  echo "ERROR: boot/login theming needs sudo — run 'chezmoi apply' in a terminal" >&2
  exit 1
fi

echo "==> Applying boot/login theming..."

# The DMS greeter is AUR-only; yay must run as you, not root.
if ! pacman -Qq greetd-dms-greeter-bin >/dev/null 2>&1; then
  echo "==> Installing the DMS greeter (AUR)..."
  yay -S --needed --noconfirm greetd-dms-greeter-bin
fi

sudo env USER_HOME="$HOME" GREETD_WANT="$GREETD_WANT" bash <<'ROOT'
set -euo pipefail

changed_initramfs=0
changed_grub=0

# Replace a file only when content differs; keep a timestamped backup.
write_if_changed() {
  local tmp="$1" dest="$2"
  if ! cmp -s "$tmp" "$dest" 2>/dev/null; then
    [ -e "$dest" ] && cp -a "$dest" "$dest.bak.$(date +%Y%m%d%H%M%S)"
    install -m644 "$tmp" "$dest"
    echo "    updated: $dest"
    return 0
  fi
  return 1
}
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# --- Greeter background (matches the desktop wallpaper) --------------------
if ! cmp -s "$USER_HOME/Pictures/wallpapers/evening-landscape.jpg" \
            /usr/share/backgrounds/greeter.jpg 2>/dev/null; then
  install -Dm644 "$USER_HOME/Pictures/wallpapers/evening-landscape.jpg" \
    /usr/share/backgrounds/greeter.jpg
  echo "    updated: /usr/share/backgrounds/greeter.jpg"
fi

# --- greetd: DMS greeter --------------------------------------------------
# Keep the ReGreet config (cage kiosk) as a ready-made fallback.
if [ ! -e /etc/greetd/config.toml.regreet ]; then
  cat > /etc/greetd/config.toml.regreet <<'EOF'
# ReGreet fallback: copy over config.toml and restart greetd to revert.
[terminal]
vt = 1

[default_session]
command = "cage -s -d -- regreet"
user = "greeter"
EOF
  echo "    saved fallback: /etc/greetd/config.toml.regreet"
fi
if ! grep -qE '^command = ".*dms-greeter --command hyprland' /etc/greetd/config.toml 2>/dev/null; then
  printf '%s\n' "$GREETD_WANT" > "$tmp/config.toml"
  write_if_changed "$tmp/config.toml" /etc/greetd/config.toml || true
fi

# --- regreet (fallback greeter): Catppuccin GTK theme ---------------------
GTK_THEME="$(ls /usr/share/themes 2>/dev/null | grep -im1 'catppuccin.*mocha' || true)"
if [ -z "$GTK_THEME" ]; then
  GTK_THEME="Adwaita-dark"
  echo "    WARN: no Catppuccin GTK theme in /usr/share/themes (AUR install"
  echo "          skipped?) — greeter falls back to Adwaita-dark for now."
fi
cat > "$tmp/regreet.toml" <<EOF
# Regreet config for turing — GTK4 greeter for greetd.
# Managed by chezmoi (run_onchange_after_boot-theming.sh).
# Background installed from ~/Pictures/wallpapers/ (chezmoi-managed).

[background]
path = "/usr/share/backgrounds/greeter.jpg"
fit = "Cover"

[GTK]
application_prefer_dark_theme = true
cursor_theme_name = "Adwaita"
cursor_blink = true
font_name = "JetBrainsMono Nerd Font 16"
icon_theme_name = "Papirus-Dark"
theme_name = "$GTK_THEME"

[commands]
reboot = ["systemctl", "reboot"]
poweroff = ["systemctl", "poweroff"]

[appearance]
greeting_msg = "Welcome back, Devin"

[widget.clock]
format = "%A %B %-d  ·  %H:%M"
resolution = "1s"
label_width = 280
EOF
write_if_changed "$tmp/regreet.toml" /etc/greetd/regreet.toml || true

# --- regreet: Catppuccin card CSS ------------------------------------------
cat > "$tmp/regreet.css" <<'EOF'
/* Catppuccin Mocha tinting for regreet.
   The login box is a semi-transparent card layered over the wallpaper. */

window {
  background-color: rgba(30, 30, 46, 0.0);    /* base, fully transparent — show wallpaper */
}

/* Central login card */
.background-card,
.main-box {
  background-color: rgba(30, 30, 46, 0.85);   /* base @ 85% */
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

/* Greeting text */
label {
  color: #cdd6f4;                              /* text */
}

/* Buttons (login / reboot / poweroff) */
button {
  background-color: rgba(49, 50, 68, 0.9);     /* surface0 */
  color: #cdd6f4;
  border: 1px solid rgba(108, 112, 134, 0.3);  /* overlay0 */
  border-radius: 8px;
  padding: 8px 16px;
}

button:hover {
  background-color: rgba(69, 71, 90, 1.0);     /* surface1 */
  border-color: #f9e2af;                       /* yellow accent */
}

/* Password / username input */
entry {
  background-color: rgba(24, 24, 37, 0.9);     /* mantle */
  color: #cdd6f4;
  border: 1px solid rgba(108, 112, 134, 0.5);
  border-radius: 8px;
  padding: 8px 12px;
}

entry:focus {
  border-color: #fab387;                       /* peach accent */
}

/* Combo boxes (session / user dropdowns) */
combobox {
  background-color: rgba(49, 50, 68, 0.9);
  color: #cdd6f4;
  border-radius: 8px;
}
EOF
write_if_changed "$tmp/regreet.css" /etc/greetd/regreet.css || true

# --- Plymouth: bgrt theme + mkinitcpio hook --------------------------------
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  if [ "$(plymouth-set-default-theme 2>/dev/null)" != "bgrt" ]; then
    plymouth-set-default-theme bgrt
    echo "    plymouth theme -> bgrt"
    changed_initramfs=1
  fi
  if ! grep -qE '^HOOKS=.* plymouth ' /etc/mkinitcpio.conf; then
    cp -a /etc/mkinitcpio.conf "/etc/mkinitcpio.conf.bak.$(date +%Y%m%d%H%M%S)"
    sed -i 's/^HOOKS=(base udev /HOOKS=(base udev plymouth /' /etc/mkinitcpio.conf
    grep -qE '^HOOKS=.* plymouth ' /etc/mkinitcpio.conf \
      || { echo "ERROR: failed to insert plymouth hook"; exit 1; }
    echo "    mkinitcpio: plymouth hook added"
    changed_initramfs=1
  fi
else
  echo "    WARN: plymouth not installed (package install skipped?) — no splash."
fi

if [ "$changed_initramfs" -eq 1 ]; then
  for img in /boot/initramfs-*.img; do
    [ -e "$img" ] && cp -a "$img" "$img.bak"
  done
  echo "    pre-change initramfs kept as /boot/*.img.bak"
  mkinitcpio -P
fi

# --- GRUB: splash param + Catppuccin menu theme ----------------------------
if ! grep -q 'splash' /etc/default/grub; then
  cp -a /etc/default/grub "/etc/default/grub.bak.$(date +%Y%m%d%H%M%S)"
  sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT="/&splash /' /etc/default/grub
  echo "    kernel cmdline: +splash"
  changed_grub=1
fi
GRUB_THEME_TXT="$(ls /usr/share/grub/themes/*/theme.txt 2>/dev/null | grep -im1 catppuccin || true)"
if [ -n "$GRUB_THEME_TXT" ] \
   && ! grep -q "^GRUB_THEME=\"$GRUB_THEME_TXT\"" /etc/default/grub; then
  [ "$changed_grub" -eq 1 ] || cp -a /etc/default/grub "/etc/default/grub.bak.$(date +%Y%m%d%H%M%S)"
  sed -i '/^GRUB_THEME=/d' /etc/default/grub
  printf 'GRUB_THEME="%s"\n' "$GRUB_THEME_TXT" >> /etc/default/grub
  echo "    grub theme -> $GRUB_THEME_TXT"
  changed_grub=1
elif [ -z "$GRUB_THEME_TXT" ]; then
  echo "    WARN: no Catppuccin GRUB theme found (AUR install skipped?) — menu unthemed."
fi

if [ "$changed_grub" -eq 1 ]; then
  grub-mkconfig -o /boot/grub/grub.cfg
fi
ROOT

# Theme, wallpaper and settings for the login screen. Runs as you (it reads
# your DMS state) and escalates with sudo itself for the system parts:
# greeter group membership, ACLs, the cache. Non-interactive, no PAM change.
if ! in_greeter_group || [ ! -e /var/cache/dms-greeter ]; then
  echo "==> Syncing your DMS theme to the login screen..."
  dms-greeter sync --yes
fi

echo "==> Boot/login theming applied. Takes effect at next boot"
echo "    (or preview the greeter now: sudo systemctl restart greetd — logs you out!)."
{{ end -}}
{{ end -}}
