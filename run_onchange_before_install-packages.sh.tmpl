{{- if eq .chezmoi.os "linux" -}}
{{- if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash
# Installs all packages required by the dotfiles.
# chezmoi run_onchange_*: re-runs whenever this rendered script changes,
# i.e. whenever the package lists below are edited.
# Idempotent: pacman/yay --needed skips already-installed packages.

set -euo pipefail

PACMAN_PKGS=(
  # Shell & prompt
  zsh starship

  # Multiplexers & editor
  tmux zellij neovim

  # Terminal & WM
  ghostty
  hyprland hypridle hyprlock hyprpaper hyprpicker hyprshot hyprpolkitagent

  # XDG desktop portals (screen-sharing, file pickers, etc. for sandboxed apps)
  xdg-desktop-portal xdg-desktop-portal-hyprland xdg-desktop-portal-gtk
  waybar wofi swaync

  # Wayland clipboard + history + screenshot annotation + media control
  cliphist wl-clipboard wl-clip-persist swappy grim slurp playerctl brightnessctl

  # Screen recording (hardware-encoded, Super+Alt+S via hypr-record) + OCR
  # text extraction (Super+Shift+T via hypr-ocr). wtype = wayland key
  # injection, used by wofi-emoji to type the picked emoji.
  gpu-screen-recorder tesseract tesseract-data-eng wtype

  # On-screen display for volume/brightness keys (swayosd-server is
  # exec-once'd from hyprland.conf; binds call swayosd-client)
  swayosd

  # Audio stack — was assumed-preinstalled, now pinned (waybar's pulseaudio
  # module + its pamixer clicks, and wpctl in Hyprland binds, depend on it)
  pipewire pipewire-pulse pipewire-alsa wireplumber pamixer

  # Bluetooth: bluez daemon + bluetui TUI (Super+Shift+B / waybar click)
  bluez bluez-utils bluetui

  # Networking: standalone iwd stack — iwd owns Wi-Fi + DHCP, systemd-
  # resolved does DNS, systemd-networkd does wired/dock DHCP (see
  # run_onchange_after_network-iwd.sh). impala = Wi-Fi TUI on Super+I.
  # networkmanager stays INSTALLED but DISABLED: it's the offline escape
  # hatch (`sudo net-rollback --classic`) and the PSK source for migration.
  # wireless-regdb = Wi-Fi regulatory database (kernel warned it was
  # missing at boot; without it the radio runs on conservative world
  # defaults — some 5GHz channels and tx power levels unavailable).
  networkmanager iwd impala wireless-regdb

  # Desktop apps — was assumed-preinstalled, now pinned ($browser and
  # $fileManager in hyprland.conf, firefox also default http/https handler)
  firefox thunar

  # Login / display manager (regreet = GTK4 greeter, cage = embedded
  # Wayland kiosk compositor that hosts it; tuigreet kept as fallback)
  greetd greetd-regreet cage greetd-tuigreet

  # Boot splash (bgrt theme: firmware logo + spinner) + greeter icon theme.
  # Wired up by run_onchange_after_boot-theming.sh (initramfs hook, GRUB
  # splash param, regreet GTK theming).
  plymouth papirus-icon-theme

  # GTK dialog toolkit — powers the bar clock's calendar flyout
  # (~/.config/waybar/scripts/calendar.sh)
  yad

  # Fingerprint reader
  fprintd libfprint

  # Power management (Framework laptop battery life)
  power-profiles-daemon

  # Firmware updates via LVFS (Framework BIOS/controllers; laptop-update
  # runs fwupdmgr as one of its stages)
  fwupd

  # Btrfs snapshots + auto pre/post around pacman + grub boot-into-snapshot
  snapper snap-pac grub-btrfs inotify-tools

  # fsck for the FAT32 ESP (/boot). fstab already has passno 2, but the
  # boot-time systemd-fsck was silently a no-op without fsck.fat — a hard
  # power-off left the FAT dirty bit set and it could never self-heal.
  dosfstools

  # LTS kernel as a fallback — boot menu offers it when mainline breaks
  linux-lts linux-lts-headers

  # Pacman mirror auto-refresh (weekly via reflector.timer)
  reflector

  # CLI utilities
  git git-delta github-cli jq fd ripgrep fzf eza zoxide atuin bat wget less man-db unzip openssh

  # Local LLM runner — hosts embedding model for pi-knowledge-search
  # (nomic-embed-text). Model lives in /usr/share/ollama/.ollama after
  # first `ollama pull`. Daemon listens on 127.0.0.1:11434.
  ollama
  wl-clipboard

  # TUIs & shell goodies
  lazygit lazydocker htop btop fastfetch

  # Terminal screensaver (Omarchy-style): figlet renders the hostname art,
  # tte (python-terminaltexteffects, AUR) animates it. See hypr-screensaver
  # + the hypridle screensaver stage.
  figlet

  # Laptop documentation site (rendered from ~/.local/share/chezmoi/docs/)
  mdbook

  # Virtualization stack — KVM/QEMU + libvirt + virt-manager GUI.
  # edk2-ovmf = UEFI firmware (required by Win11). swtpm = software TPM 2.0
  # (also Win11 requirement). virtiofsd = host↔guest shared folder.
  # virt-viewer = lightweight SPICE display window (used by the `win` launcher
  # for hotkey-driven attach without dragging in the full virt-manager UI).
  # dnsmasq is pulled in transitively by libvirt for the default NAT network.
  # dmidecode: libvirtd logged "Cannot find 'dmidecode'" every boot — it
  # reads host SMBIOS data to expose to guests.
  qemu-full libvirt virt-manager virt-viewer edk2-ovmf swtpm virtiofsd dmidecode

  # Progressive Web App support for Firefox (native connector half of
  # PWAsForFirefox). Used to install work Outlook (outlook.office.com) as
  # a standalone app window on the Gecko engine -- reliable native Wayland
  # on Hyprland, and immune to Microsoft's EWS retirement (it's the full
  # web app). The Firefox extension half must be added once from AMO:
  # https://addons.mozilla.org/firefox/addon/pwas-for-firefox
  firefoxpwa

  # Fonts (powerline glyphs in tmux theme & waybar)
  ttf-jetbrains-mono-nerd

  # Self-management (yay is AUR-only; bootstrap manually first — see README)
  chezmoi
)

AUR_PKGS=(
  1password

  # zsh plugin manager (note: distinct from the unrelated French app 'antidote')
  zsh-antidote

  # Logout menu for Hyprland
  wlogout

  # Framework laptop EC tooling (battery charge limit, fan curves, etc.)
  fw-ectool-git

  # Smart tmux session manager (zoxide-aware)
  sesh-bin

  # Discord client built for native Wayland (Electron + Vencord). Replaces the
  # official 'discord' pkg, which runs under XWayland and renders blurry at
  # fractional scale (eDP-1 @ 1.5x).
  vesktop-bin

  # Windows VM paravirt drivers + guest tools ISO. Mounts inside the Win11
  # installer to provide virtio storage/net drivers, plus spice-vdagent
  # for clipboard, dynamic resize, and USB redirection.
  virtio-win

  # Emoji picker: wofi frontend, copies to clipboard / types via wtype.
  # Bound to Super+Ctrl+E in hyprland.conf.
  wofi-emoji

  # Polkit agent (GTK4/libadwaita — replaces hyprpolkitagent's cramped QML
  # dialog; exec-once'd from hyprland.conf)
  soteria-bin

  # Login screen + boot menu theming (see run_onchange_after_boot-theming.sh):
  # Catppuccin Mocha GTK theme for regreet, matching GRUB menu theme.
  catppuccin-gtk-theme-mocha
  catppuccin-mocha-grub-theme-git

  # TerminalTextEffects CLI (`tte`) — the screensaver's animation engine.
  python-terminaltexteffects

  # Local push-to-talk dictation (whisper.cpp, offline). Hold F12 to talk
  # (hyprland.conf); config in ~/.config/voxtype/config.toml; model
  # downloaded by run_onchange_after_voxtype-setup.sh.
  # -bin because the source PKGBUILD is broken: it cargo-fetches locked
  # deps for Linux only, then builds --frozen and trips over a macOS-only
  # crate (core-foundation) in the lockfile.
  voxtype-bin
)

echo "==> Installing pacman packages..."
sudo pacman -S --needed --noconfirm "${PACMAN_PKGS[@]}"

if command -v yay >/dev/null 2>&1; then
  echo "==> Installing AUR packages via yay..."
  yay -S --needed --noconfirm --aur "${AUR_PKGS[@]}"
else
  echo "WARN: yay not found; skipping AUR packages: ${AUR_PKGS[*]}"
  echo "      Install yay first, then re-run: chezmoi apply"
fi

# Virtualization one-time setup: group memberships + libvirtd service +
# default NAT network autostart + qemu user/group set to current user (so
# VM disks under \$HOME are readable/writable by the qemu process; the
# default `root` qemu user creates ownership churn in home-dir image
# stores). Guarded so the sudo block only fires when state actually needs
# fixing (faillock lesson: one sudo invocation per bash call, and skip
# entirely on the common re-run path).
QEMU_CONF=/etc/libvirt/qemu.conf
if ! id -nG "$USER" | grep -qw libvirt \
   || ! id -nG "$USER" | grep -qw kvm \
   || ! systemctl is-enabled --quiet libvirtd.service 2>/dev/null \
   || ! systemctl is-active  --quiet libvirtd.service 2>/dev/null \
   || ! virsh -c qemu:///system net-info default 2>/dev/null | grep -q '^Autostart:.*yes' \
   || ! grep -qE "^user\s*=\s*\"$USER\"" "$QEMU_CONF" 2>/dev/null \
   || ! grep -qE "^group\s*=\s*\"$USER\"" "$QEMU_CONF" 2>/dev/null; then
  echo "==> Configuring virtualization (groups, libvirtd, default network, qemu.conf user)..."
  sudo sh -c "
    set -e
    usermod -aG libvirt,kvm '$USER'

    # qemu.conf: run qemu as the user (not root) so VM disks under \$HOME
    # are readable/writable without ownership churn. Idempotent.
    if ! grep -qE '^user\s*=\s*\"$USER\"' '$QEMU_CONF'; then
      cp '$QEMU_CONF' '$QEMU_CONF.bak.\$(date +%Y%m%d%H%M%S)'
      sed -i \
        -e 's/^#user = \"libvirt-qemu\"/user = \"$USER\"/' \
        -e 's/^#group = \"libvirt-qemu\"/group = \"$USER\"/' \
        '$QEMU_CONF'
      # If the commented sentinel lines aren't there (e.g., already edited
      # by hand), append a definitive override at end of file.
      grep -qE '^user\s*=\s*\"$USER\"' '$QEMU_CONF' || \
        printf '\nuser = \"$USER\"\ngroup = \"$USER\"\n' >> '$QEMU_CONF'
    fi

    systemctl enable --now libvirtd.service
    systemctl restart libvirtd.service
    # Wait briefly for libvirtd socket to come up before talking to it.
    for _ in 1 2 3 4 5; do
      [ -S /var/run/libvirt/libvirt-sock ] && break
      sleep 1
    done
    virsh net-autostart default 2>/dev/null || true
    virsh net-info default 2>/dev/null | grep -q 'Active:.*yes' || virsh net-start default 2>/dev/null || true
  "
  echo "    Note: log out and back into Hyprland to pick up new group membership."
fi

# Bluetooth daemon — bluetui and the waybar module both need it running.
# Guarded so the sudo call only fires when state actually needs fixing.
if ! systemctl is-enabled --quiet bluetooth.service 2>/dev/null \
   || ! systemctl is-active --quiet bluetooth.service 2>/dev/null; then
  echo "==> Enabling bluetooth.service..."
  sudo systemctl enable --now bluetooth.service
fi

# gh extensions (user-level, not pacman-managed). gh-dash = lazygit-style
# dashboard of your PRs/issues across repos (`gh dash`). Needs gh auth, so
# it's skipped on a fresh machine until `gh auth login` has run once.
if gh auth status >/dev/null 2>&1 \
   && ! gh extension list 2>/dev/null | grep -q 'dlvhdr/gh-dash'; then
  echo "==> Installing gh extension: gh-dash..."
  gh extension install dlvhdr/gh-dash
fi

# Switch login shell to zsh if it isn't already.
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$(command -v zsh)" ]; then
  echo "==> Changing login shell to zsh..."
  chsh -s "$(command -v zsh)"
fi

echo "==> Package install complete."
{{ end -}}
{{ end -}}
