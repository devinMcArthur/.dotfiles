[user]
	name = Devin McArthur
	email = assortedgerm@gmail.com
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	; "ansi" renders syntax with the terminal's 16-color palette, so delta
	; follows the ghostty theme (catppuccin-mocha) with zero maintenance.
	syntax-theme = ansi
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
