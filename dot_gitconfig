[user]
	name = Devin McArthur
	email = assortedgerm@gmail.com
[core]
	# Global hooks. The hook chains to the repo's own .git/hooks first —
	# core.hooksPath REPLACES that directory rather than merging with it,
	# so a global hook silently disables per-repo hooks otherwise.
	hooksPath = ~/.config/git/hooks
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	; "ansi" renders syntax with the terminal's 16-color palette, so delta
	; follows the ghostty theme (catppuccin-mocha) with zero maintenance.
	syntax-theme = ansi
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
