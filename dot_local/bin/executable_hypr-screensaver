#!/usr/bin/env bash
# hypr-screensaver — Omarchy-style terminal screensaver launcher.
# Opens a fullscreen ghostty on EVERY monitor running hypr-screensaver-run
# (random TerminalTextEffects over figlet ASCII art). Any key dismisses all
# of them together.
#
# Launched by hypridle before the lock stage (battery 4min / AC 15min);
# the waybar caffeine toggle inhibits it along with the rest of the idle
# pipeline. Manual: `hypr-screensaver` from any shell in the session.

set -euo pipefail

# `hypr-screensaver stop` — take the screensaver down.
#
# Killing the process does not work: ghostty runs gtk-single-instance
# (=detect, so on by default in a desktop session), which means these
# windows belong to the ONE ghostty process and there is no per-window
# process to signal. `pkill -f 'ghostty --class=screensaver.tui'` matches
# the launcher, which has already exited. That is why the screensaver
# outlived the lock screen and sat there until a keypress dismissed it.
#
# Closing the windows by class through Hyprland works regardless of which
# process owns them.
if [ "${1:-}" = stop ]; then
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl -j clients 2>/dev/null \
      | jq -r '.[] | select(.class == "screensaver.tui") | .address' 2>/dev/null \
      | while read -r addr; do
          [ -n "$addr" ] && hyprctl dispatch closewindow "address:$addr" >/dev/null 2>&1
        done
  fi
  # No pkill fallback. The bracket trick stops the pattern matching its own
  # text, but it cannot stop it matching a caller whose command line
  # legitimately contains the real class string — which killed the shell
  # testing this. closewindow already works whoever owns the window, so the
  # fallback bought nothing and risked the wrong process.
  exit 0
fi

# Missing engine → one clear notification instead of N windows of
# "command not found" (also keeps idle-triggered runs quiet but visible).
if ! command -v tte >/dev/null 2>&1; then
  notify-send -u critical -a "Screensaver" "tte not installed" \
    "Run: chezmoi apply  (installs python-terminaltexteffects + figlet)"
  exit 1
fi

# Already showing — don't stack a second set. ([.] so the pattern never
# matches a shell whose own cmdline quotes it, e.g. hypridle's on-timeout.)
pgrep -f 'ghostty --class=screensaver[.]tui' >/dev/null && exit 0

for m in $(hyprctl monitors -j | jq -r '.[].name'); do
  hyprctl dispatch focusmonitor "$m" >/dev/null
  # NOTE: --fullscreen requires an explicit value; the bare flag is a
  # ghostty config error (dialog + tiled window).
  # Big font so the figlet banner fills a meaningful chunk of the screen.
  hyprctl dispatch exec \
    "ghostty --class=screensaver.tui --fullscreen=true --font-size=32 -e $HOME/.local/bin/hypr-screensaver-run" \
    >/dev/null
  sleep 0.4   # let the window map on its monitor before focusing the next
done
