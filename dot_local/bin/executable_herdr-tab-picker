#!/usr/bin/env bash
# herdr-tab-picker — jump to a TAB, not a pane, across every machine.
#
# herdr's built-in `goto` picker bottoms out at panes, which is the wrong
# leaf here: nearly every tab holds a single agent, so the pane level is
# noise. Its depth is not configurable (checked against the full default
# config and the docs for 0.8.2 and 0.9.1), so this rebuilds the picker
# over the socket API instead — `tab list` already reports everything the
# rows need, and `tab focus` does the jump.
#
# Since 0.9.1 the box is a saved SSH machine rather than a mirrored
# workspace, and `herdr tab list` only ever reports the LOCAL server — so
# the box's tabs simply vanished from this picker. Each enabled machine is
# now queried too, with `herdr --machine <label> tab list`.
#
# Those queries cross ssh and cost ~1.4s each — measured 2.7s for the box's
# two calls, which made prefix+s look broken: three seconds of nothing, then
# a picker. So the rows are STREAMED into fzf rather than collected first.
# Local tabs are ready in ~10ms and the picker opens on them immediately;
# the box's rows append underneath when they arrive.
#
# Runs inside a herdr popup (see [[keys.command]] in config.toml), so it
# exits when a choice is made and the popup closes with it.

set -uo pipefail

command -v fzf >/dev/null 2>&1 || { echo "fzf not installed" >&2; sleep 2; exit 1; }

# Rows are TSV: machine, tab_id, display. machine is empty for local, and
# both leading fields are hidden from fzf (--with-nth=3..) because they are
# the selection payload, not something to read.
collect() {
  local machine="$1"
  local -a cmd=(herdr)
  [ -n "$machine" ] && cmd+=(--machine "$machine")

  # A machine is reached over ssh, so it can be slow or down. Never let one
  # unreachable box stop the picker from opening on local tabs.
  timeout 6 "${cmd[@]}" tab list 2>/dev/null | MACHINE="$machine" python3 -c '
import json, os, subprocess, sys

machine = os.environ.get("MACHINE", "")
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)

# Workspace labels are not on the tab records, so join them in — a bare
# "w3" tells you nothing when three workspaces are open.
names = {}
try:
    cmd = ["herdr"] + (["--machine", machine] if machine else []) + ["workspace", "list"]
    w = json.loads(subprocess.run(cmd, capture_output=True, text=True, timeout=6).stdout)
    for ws in w.get("result", {}).get("workspaces", []):
        names[ws["workspace_id"]] = ws.get("label") or ws["workspace_id"]
except Exception:
    pass

GLYPH = {"working": "◐", "blocked": "!", "done": "✓", "idle": "·", "unknown": " "}
for t in d.get("result", {}).get("tabs", []):
    ws = names.get(t["workspace_id"], t["workspace_id"])
    st = t.get("agent_status", "unknown")
    # Only a LOCAL tab can be the one you are sitting in; a remote focus is
    # the box focusing itself, which is not "here" and must not win the
    # opening cursor position.
    here = "*" if (t.get("focused") and not machine) else " "
    label = ("%s:%s" % (machine, ws))[:18] if machine else ws[:18]
    print("%s\t%s\t%s %s %-18s %-22s %s" % (
        machine, t["tab_id"], here, GLYPH.get(st, " "),
        label, t.get("label", "")[:22], st))
'
}

local_rows="$(collect "")"

[ -n "$local_rows" ] || { echo "no tabs" >&2; sleep 2; exit 1; }

# Local first, then each enabled machine — a disabled one is deliberately
# out of the way. Ordering matters beyond tidiness: the focused local row is
# always in the first chunk, so its line number is known before any remote
# query has returned and the opening cursor can be placed immediately.
stream_rows() {
  printf '%s\n' "$local_rows"
  while IFS=$'\t' read -r _id label _target _session state; do
    [ "${state:-}" = "enabled" ] || continue
    [ -n "${label:-}" ] || continue
    collect "$label"
  done < <(herdr machine list 2>/dev/null)
}

# Modal, like vim: the list starts in normal mode with j/k moving, and
# `/` is what begins a search. Without --no-input every keystroke goes
# straight into the query, so j and k filter instead of moving — which is
# the wrong reflex for a list you navigate far more often than you filter.
#
# Esc is context-sensitive via FZF_INPUT_STATE: it leaves search mode
# when searching, and closes the picker when already in normal mode. `q`
# closes it too, but only in normal mode — it is in $NAV, so search mode
# unbinds it along with the movement keys and you can type a q like any
# other character.
# `transform` is the only way to give one key two meanings — rebind()
# restores a key's original action, it cannot swap in a different one.
# Open on the tab you are already in, not on the first row — the useful
# starting point is "where am I", so a glance shows your neighbours and
# j/k moves relative to here. The focused row is the one marked "*".
# Bound to `start`, not `load`: load waits for every machine to answer, so
# the cursor would sit at the top for a second and then jump out from under
# you. The target row is in the local chunk, which fzf has already read.
pos="$(printf '%s\n' "$local_rows" | grep -nF $'\t*' | head -1 | cut -d: -f1)"
start_at=()
[ -n "$pos" ] && start_at=(--bind "start:pos($pos)")

NAV='j,k,g,G,q,ctrl-d,ctrl-u'
sel="$(stream_rows \
  | fzf "${start_at[@]}" \
        --with-nth=3.. --delimiter=$'\t' \
        --height=100% --reverse --prompt='tab > ' \
        --no-input \
        --bind "j:down,k:up,g:first,G:last,q:abort" \
        --bind "ctrl-d:half-page-down,ctrl-u:half-page-up" \
        --bind "/:show-input+unbind($NAV)" \
        --bind "esc:transform:[ \"\$FZF_INPUT_STATE\" = hidden ] \
                  && echo abort \
                  || echo 'clear-query+hide-input+rebind($NAV)'" \
        --header='j/k move   / search   enter jump   q/esc close')"

[ -n "$sel" ] || exit 0
machine="$(printf '%s' "$sel" | cut -f1)"
tab="$(printf '%s' "$sel" | cut -f2)"

if [ -z "$machine" ]; then
  herdr tab focus "$tab" >/dev/null 2>&1
else
  # Focusing a remote tab sets the focus ON THAT MACHINE; it does not pull
  # this client across — measured on 0.9.1, for both `tab focus` and
  # `workspace focus`, and there is no API method that does (herdr api
  # exposes only snapshot and schema). Switching machines is a sidebar
  # action. So pre-position the box and say so, rather than silently
  # appearing to do nothing.
  herdr --machine "$machine" tab focus "$tab" >/dev/null 2>&1
  printf '\n  %s is now on that tab — switch to it in the sidebar.\n' "$machine"
  sleep 1.6
fi
