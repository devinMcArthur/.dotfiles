#!/usr/bin/env bash
# devbox-speak — hear the remote box's Claude replies on this laptop.
#
#   devbox-speak          # follow the box's queue and speak each line
#   devbox-speak once     # drain whatever is queued, then exit
#
# The box has no audio, so claude-tts there runs in queue mode: its hooks
# append the cleaned reply text to ~/.local/state/claude-tts/say-queue
# instead of synthesizing. This tails that file over ssh and speaks each
# line HERE, with the same Kokoro voice as local sessions.
#
# Direction matters: the laptop pulls. The box cannot reach back through
# NAT, and an ssh tunnel in that direction would break every time the
# address changes (it changed overnight during the trial).
#
# The link drops often — a roaming laptop, and tailscale keys that expire.
# That is accepted; what is not is losing what was said meanwhile. This
# used to follow with `tail -n0`, which restarts at END OF FILE on every
# reconnect, so a disconnect silently swallowed every reply inside it.
# Measured 2026-09-22: eight service restarts overnight and an eight-hour
# hole in spoken-remote.log, 00:04 to 07:56, which read as "TTS is dead"
# rather than "TTS reconnected and skipped the backlog".
#
# So the read position is persisted as a BYTE OFFSET into the box's queue
# and the tail resumes from it.

set -uo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/devbox/host"
QUEUE=".local/state/claude-tts/say-queue"
# See devbox-target: the alias tracks the tailnet, the config file holds
# a public address that the firewall pins to one source ip.
host="$("$HOME/.local/bin/devbox-target")"
[ -n "$host" ] || { echo "no dev box set: devbox host user@address" >&2; exit 1; }

TTS="$HOME/.local/bin/claude-tts"

LOG="${XDG_STATE_HOME:-$HOME/.local/state}/claude-tts/spoken-remote.log"

# How far into the box's queue we have spoken. Survives restarts, which is
# the entire point — systemd restarted this eight times in one night.
OFFSET="${XDG_STATE_HOME:-$HOME/.local/state}/claude-tts/devbox-queue-offset"

# Ceiling on how much backlog a reconnect will replay, in bytes. Lines run
# ~100 bytes and each takes several seconds to speak, so an uncapped catch-up
# after a long outage would hold the speakers for many minutes and bury
# whatever is being said NOW. Roughly twenty lines.
BACKLOG_CAP=2000

# Where to resume from. Echoes a byte offset; needs one ssh round trip to
# learn the queue's current size.
resume_offset() {
  local size saved start
  size="$(ssh -o ConnectTimeout=10 -o BatchMode=yes "$host" \
            "stat -c %s $QUEUE 2>/dev/null || echo 0" 2>/dev/null)" || return 1
  case "$size" in ''|*[!0-9]*) return 1 ;; esac

  saved="$(cat "$OFFSET" 2>/dev/null)"
  case "$saved" in ''|*[!0-9]*) saved="" ;; esac

  if [ -z "$saved" ]; then
    # First ever run: start at the end. Speaking the whole historical queue
    # (143KB when this was written) would be hours of monologue.
    start="$size"
  elif [ "$saved" -gt "$size" ]; then
    # Queue truncated or rotated under us — the offset means nothing now.
    start=0
  else
    start="$saved"
  fi

  if [ "$size" -gt "$BACKLOG_CAP" ] && [ "$start" -lt $(( size - BACKLOG_CAP )) ]; then
    start=$(( size - BACKLOG_CAP ))
  fi
  printf '%s' "$start"
}

speak() {
  local line="$1"
  [ -n "${line//[[:space:]]/}" ] || return 0
  # Muted: drop the line rather than hold it. say_text would refuse it
  # anyway, but checking here skips the wait-for-playback dance, and
  # dropping is the point — unmuting should not unleash a backlog.
  # No pipe to grep -q here: it exits on the first match, claude-tts takes
  # SIGPIPE writing its second line, and `set -o pipefail` then reports the
  # pipeline as FAILED despite the match — so the guard never fired.
  case "$("$TTS" status 2>/dev/null)" in *disabled*) return 0 ;; esac
  # What actually reached the speakers, so "did the box say anything?"
  # has an answer that does not depend on someone being in the room.
  mkdir -p "${LOG%/*}"
  printf '%s  %s\n' "$(date +%H:%M:%S)" "$line" >> "$LOG"
  tail -n 200 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
  # `say`, not `test`: test cuts off whatever is playing, which meant a
  # box reply talked over a laptop session. `say` waits its turn.
  "$TTS" say "$line"
  # Serialize: claude-tts interrupts itself by design, so without waiting,
  # a burst of queued lines would talk over each other and only the last
  # would be heard. Playback is detached, so wait for it to APPEAR (it
  # registers within milliseconds; synthesis alone takes longer) before
  # waiting for it to finish.
  local w=0
  while [ "$w" -lt 10 ] && ! "$TTS" busy; do sleep 0.5; w=$((w+1)); done
  w=0
  # Generous on purpose: expiring here means the next line starts while
  # this one is still talking, and claude-tts then hushes it. 240 (two
  # minutes) was short enough that long box replies cut each other off.
  while [ "$w" -lt 1200 ] && "$TTS" busy; do sleep 0.5; w=$((w+1)); done
}

case "${1:-follow}" in
  once)
    ssh -o ConnectTimeout=10 "$host" "cat $QUEUE 2>/dev/null; : > $QUEUE" | while IFS= read -r l; do speak "$l"; done
    ;;
  follow)
    # Singleton via flock, not a pgrep for our own name: `pgrep -f` also
    # matches any shell whose command line merely mentions this script,
    # so process-name matching both misfires and (with pkill) has killed
    # the caller. One drainer per laptop; a second exits quietly.
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/devbox-speak.lock"
    flock -n 9 || exit 0
    echo "speaking $host replies (Ctrl-C to stop)"
    trap 'exit 0' INT TERM
    # Reconnect: this link roams and the box's address has changed
    # overnight before. ServerAliveInterval kills a hung session, and we
    # come back — but give up eventually rather than retry forever after
    # the box is destroyed.
    mkdir -p "${OFFSET%/*}"
    fails=0
    while [ "$fails" -lt 20 ]; do
      start="$(resume_offset)" || { fails=$((fails+1)); sleep 15; continue; }
      # -c +N resumes at the byte we stopped at, rather than -n0's "whatever
      # arrives from now on". -F so a rotated queue still works; the box
      # only ever appends.
      if ssh -o ConnectTimeout=10 -o ServerAliveInterval=30 -o BatchMode=yes "$host" \
           "touch $QUEUE; tail -c +$((start + 1)) -F $QUEUE 2>/dev/null" \
         | while IFS= read -r l; do
             speak "$l"
             # AFTER speaking, so a crash mid-line repeats it rather than
             # dropping it. wc -c not ${#l}: the box's text is UTF-8 and
             # ${#l} counts characters, which would drift the offset.
             start=$(( start + $(printf '%s\n' "$l" | LC_ALL=C wc -c) ))
             printf '%s' "$start" > "$OFFSET"
           done
      then fails=0            # clean end: box closed the stream
      else fails=$((fails+1))
      fi
      sleep 15
    done
    echo "giving up on $host after repeated connection failures"
    ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
