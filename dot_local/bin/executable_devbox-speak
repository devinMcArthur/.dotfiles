#!/usr/bin/env bash
# devbox-speak — hear the remote box's Claude replies on this laptop.
#
#   devbox-speak          # follow the box's queue and speak each line
#   devbox-speak once     # drain whatever is queued, then exit
#
# The box has no audio, so claude-tts there runs in queue mode: its hooks
# append the cleaned reply text to ~/.local/state/claude-tts/say-queue
# instead of synthesizing. This tails that file over ssh and speaks each
# line HERE, with the same Kokoro voice as local sessions.
#
# Direction matters: the laptop pulls. The box cannot reach back through
# NAT, and an ssh tunnel in that direction would break every time the
# address changes (it changed overnight during the trial).

set -uo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/devbox/host"
QUEUE=".local/state/claude-tts/say-queue"
host="$(tr -d '[:space:]' < "$CONF" 2>/dev/null)"
[ -n "$host" ] || { echo "no dev box set: devbox host user@address" >&2; exit 1; }

TTS="$HOME/.local/bin/claude-tts"

LOG="${XDG_STATE_HOME:-$HOME/.local/state}/claude-tts/spoken-remote.log"

speak() {
  local line="$1"
  [ -n "${line//[[:space:]]/}" ] || return 0
  # What actually reached the speakers, so "did the box say anything?"
  # has an answer that does not depend on someone being in the room.
  mkdir -p "${LOG%/*}"
  printf '%s  %s\n' "$(date +%H:%M:%S)" "$line" >> "$LOG"
  tail -n 200 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
  "$TTS" test "$line"
  # Serialize: claude-tts interrupts itself by design, so without waiting,
  # a burst of queued lines would talk over each other and only the last
  # would be heard. Playback is detached, so wait for it to APPEAR (it
  # registers within milliseconds; synthesis alone takes longer) before
  # waiting for it to finish.
  local w=0
  while [ "$w" -lt 10 ] && ! "$TTS" busy; do sleep 0.5; w=$((w+1)); done
  w=0
  while [ "$w" -lt 240 ] && "$TTS" busy; do sleep 0.5; w=$((w+1)); done
}

case "${1:-follow}" in
  once)
    ssh -o ConnectTimeout=10 "$host" "cat $QUEUE 2>/dev/null; : > $QUEUE" | while IFS= read -r l; do speak "$l"; done
    ;;
  follow)
    # Singleton via flock, not a pgrep for our own name: `pgrep -f` also
    # matches any shell whose command line merely mentions this script,
    # so process-name matching both misfires and (with pkill) has killed
    # the caller. One drainer per laptop; a second exits quietly.
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/devbox-speak.lock"
    flock -n 9 || exit 0
    echo "speaking $host replies (Ctrl-C to stop)"
    trap 'exit 0' INT TERM
    # Reconnect: this link roams and the box's address has changed
    # overnight before. ServerAliveInterval kills a hung session, and we
    # come back — but give up eventually rather than retry forever after
    # the box is destroyed.
    fails=0
    while [ "$fails" -lt 20 ]; do
      # -F so a rotated/truncated queue keeps working; the box appends only.
      if ssh -o ConnectTimeout=10 -o ServerAliveInterval=30 -o BatchMode=yes "$host" \
           "touch $QUEUE; tail -n0 -F $QUEUE 2>/dev/null" \
         | while IFS= read -r l; do speak "$l"; done
      then fails=0            # clean end: box closed the stream
      else fails=$((fails+1))
      fi
      sleep 15
    done
    echo "giving up on $host after repeated connection failures"
    ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
