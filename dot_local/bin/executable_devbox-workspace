#!/usr/bin/env bash
# devbox-workspace — one local herdr workspace whose tabs are agents
# running on the dev box.
#
#   devbox-workspace                  # open/refresh the "box" workspace
#   devbox-workspace add <name>       # add one more agent tab
#   devbox-workspace list             # what the box is holding
#   devbox-workspace kill <name>      # end an agent ON THE BOX
#
# herdr has no native remote workspace: `herdr --remote` replaces the
# whole local UI, and there is no way to give a new tab a command. So
# this composes what it does have — a local tab, an env var, and a shell
# that execs devbox-attach when it sees one.
#
# The agents themselves live in dtach sessions on the box (see
# devbox-attach), which is what makes the tabs disposable: closing one
# does not stop the agent, and a laptop reboot does not either.

set -uo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/devbox/host"
SESSDIR=".herdr-agents"
LABEL="box"
DEFAULT_AGENTS="main review"

host="$(tr -d '[:space:]' < "$CONF" 2>/dev/null)"
[ -n "$host" ] || { echo "no dev box set: devbox host user@address" >&2; exit 1; }
command -v herdr >/dev/null 2>&1 || { echo "herdr not installed" >&2; exit 1; }

# Existing dtach sessions on the box == the agents that already exist.
remote_sessions() {
  ssh -o ConnectTimeout=15 "$host" \
    "ls -1 \$HOME/$SESSDIR/*.dtach 2>/dev/null | xargs -r -n1 basename | sed 's/\.dtach$//'" 2>/dev/null
}

# herdr reports the workspace id under different keys depending on the
# command, so pull whichever one is present.
ws_id() { python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: sys.exit(1)
r = d.get("result", {})
for path in (("root_pane","workspace_id"), ("workspace","id"), ("id",)):
    cur = r
    for k in path:
        cur = cur.get(k) if isinstance(cur, dict) else None
    if isinstance(cur, str):
        print(cur); break
'; }

find_ws() {
  herdr workspace list 2>/dev/null | python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: sys.exit(0)
for w in d.get("result", {}).get("workspaces", []):
    if (w.get("label") or w.get("name")) == "'"$LABEL"'":
        print(w.get("workspace_id") or w.get("id", "")); break
'
}

add_tab() {   # ws name
  herdr tab create --workspace "$1" --label "$2" --env "HERDR_ATTACH=$2" --no-focus >/dev/null 2>&1 \
    && echo "    tab: $2"
}

case "${1:-open}" in
  list)
    s="$(remote_sessions)"
    if [ -n "$s" ]; then printf '  %s\n' $s; else echo "  no agents on $host yet"; fi
    ;;
  kill)
    n="${2:-}"; [ -n "$n" ] || { echo "usage: devbox-workspace kill <name>" >&2; exit 2; }
    # Killing the dtach master ends the agent; the socket goes with it.
    ssh -o ConnectTimeout=15 "$host" \
      "pkill -f '[d]tach -n \$HOME/$SESSDIR/$n.dtach' ; rm -f \$HOME/$SESSDIR/$n.dtach" \
      && echo "  killed agent '$n' on $host"
    ;;
  add)
    n="${2:-}"; [ -n "$n" ] || { echo "usage: devbox-workspace add <name>" >&2; exit 2; }
    ws="$(find_ws)"; [ -n "$ws" ] || { echo "no '$LABEL' workspace — run devbox-workspace first" >&2; exit 1; }
    add_tab "$ws" "$n"
    ;;
  open)
    ws="$(find_ws)"
    if [ -n "$ws" ]; then
      herdr workspace focus "$ws" >/dev/null 2>&1
      echo "  focused existing workspace $ws ($LABEL)"
      exit 0
    fi
    agents="$(remote_sessions)"
    [ -n "$agents" ] || agents="$DEFAULT_AGENTS"

    first=1 ws=""
    for n in $agents; do
      if [ "$first" = 1 ]; then
        ws="$(herdr workspace create --label "$LABEL" --env "HERDR_ATTACH=$n" --no-focus 2>/dev/null | ws_id)"
        [ -n "$ws" ] || { echo "could not create workspace" >&2; exit 1; }
        herdr tab rename "$ws:t1" "$n" >/dev/null 2>&1
        echo "  workspace $ws ($LABEL) on $host"
        echo "    tab: $n"
        first=0
      else
        add_tab "$ws" "$n"
      fi
    done
    herdr workspace focus "$ws" >/dev/null 2>&1
    ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
