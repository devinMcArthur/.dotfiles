#!/usr/bin/env bash
# devbox-health — one answer to "can I reach the box, and if not, what
# needs a human?"
#
#   devbox-health           # key:value lines, for the DMS pill
#   devbox-health notify    # same, and notify when the state CHANGES
#   devbox-health url       # print the pending auth URL, if any
#
# This exists because every remote-access failure so far has been silent
# and has looked identical from the outside — "I can't connect to my box":
#   - a stale firewall rule pinned to an IP the laptop no longer had
#   - 1Password not running, so ssh had no key and git push said only
#     "Permission denied (publickey)"
#   - Tailscale SSH's periodic re-auth, whose URL goes to ssh's stderr
#     where nothing surfaces it
# Each needed a different action, and none of them announced itself.
#
# Node key expiry is the one with a deadline: Tailscale expires node keys
# after 180 days by default, and when the box's key goes it drops off the
# tailnet entirely. That is a lockout scheduled months in advance, so it
# is counted down rather than discovered.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devbox-health"
PEER="${DEVBOX_PEER:-devbox}"
mkdir -p "$STATE_DIR"

now=$(date +%s)
tsd=$(systemctl is-active tailscaled 2>/dev/null || echo inactive)

peer=unknown; expiry=0; self_expiry=0
if [ "$tsd" = active ]; then
  eval "$(timeout 10 tailscale status --json 2>/dev/null | python3 -c '
import json, sys, datetime
def epoch(s):
    if not s: return 0
    try:
        return int(datetime.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp())
    except Exception:
        return 0
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
me = d.get("Self") or {}
print(f"self_expiry={epoch(me.get(chr(75)+chr(101)+chr(121)+chr(69)+chr(120)+chr(112)+chr(105)+chr(114)+chr(121)))}")
for p in (d.get("Peer") or {}).values():
    if (p.get("HostName") or "") == "'"$PEER"'":
        print("peer=" + ("online" if p.get("Online") else "offline"))
        print(f"expiry={epoch(p.get(chr(75)+chr(101)+chr(121)+chr(69)+chr(120)+chr(112)+chr(105)+chr(114)+chr(121)))}")
        break
else:
    print("peer=missing")
' 2>/dev/null)"
fi

# The ssh probe is what catches an auth wall: Tailscale SSH answers the
# connection and then asks for a browser, which no amount of ping would
# reveal.
ssh_state=unknown; authurl=""
if [ "$peer" = online ]; then
  out="$(timeout 12 ssh -o BatchMode=yes -o ConnectTimeout=6 "$PEER" true 2>&1)"
  rc=$?
  case "$out" in
    *login.tailscale.com*)
      ssh_state=auth
      authurl="$(printf '%s' "$out" | grep -oE 'https://login\.tailscale\.com/[A-Za-z0-9/._-]+' | head -1)"
      ;;
    *) [ "$rc" -eq 0 ] && ssh_state=ok || ssh_state=fail ;;
  esac
fi

# 1Password's agent: keys live there, so a locked vault looks exactly like
# a permissions problem to git and ssh.
op=locked
timeout 8 ssh-add -l >/dev/null 2>&1 && op=ok

days_left=0
[ "$expiry" -gt 0 ] 2>/dev/null && days_left=$(( (expiry - now) / 86400 ))

state=ok; detail="box reachable"
if [ "$tsd" != active ]; then
  state=error; detail="tailscaled is not running"
elif [ "$peer" = missing ]; then
  state=error; detail="$PEER is not on the tailnet"
elif [ "$peer" = offline ]; then
  state=error; detail="$PEER is offline"
elif [ "$ssh_state" = auth ]; then
  state=warn;  detail="Tailscale SSH needs re-authentication"
elif [ "$ssh_state" = fail ]; then
  state=error; detail="ssh to $PEER failed"
elif [ "$expiry" -gt 0 ] && [ "$days_left" -le 14 ]; then
  state=warn;  detail="node key expires in ${days_left}d"
elif [ "$op" = locked ]; then
  state=warn;  detail="1Password agent has no keys"
fi

printf 'NOW:%s\nTSD:%s\nPEER:%s\nSSH:%s\nOP:%s\nEXPIRY:%s\nDAYS:%s\nSELFEXPIRY:%s\nSTATE:%s\nDETAIL:%s\nAUTHURL:%s\n' \
  "$now" "$tsd" "$peer" "$ssh_state" "$op" "$expiry" "$days_left" "$self_expiry" "$state" "$detail" "$authurl"

printf '%s' "$authurl" > "$STATE_DIR/authurl"

if [ "${1:-}" = notify ]; then
  prev="$(cat "$STATE_DIR/state" 2>/dev/null || echo)"
  if [ "$state|$detail" != "$prev" ]; then
    printf '%s' "$state|$detail" > "$STATE_DIR/state"
    case "$state" in
      ok)    [ -n "$prev" ] && notify-send -a "Dev box" -t 4000 "Dev box reachable" "$detail" ;;
      warn)  notify-send -a "Dev box" -u normal   -t 8000 "Dev box needs you" "$detail" ;;
      error) notify-send -a "Dev box" -u critical -t 8000 "Dev box unreachable" "$detail" ;;
    esac
  fi
fi
