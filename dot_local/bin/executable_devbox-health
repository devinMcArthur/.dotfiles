#!/usr/bin/env bash
# devbox-health — one answer to "can I reach the box, and if not, what
# needs a human?"
#
#   devbox-health           # key:value lines, for the DMS pill
#   devbox-health notify    # same, and notify when the state CHANGES
#   devbox-health url       # print the pending auth URL, if any
#
# This exists because every remote-access failure so far has been silent
# and has looked identical from the outside — "I can't connect to my box":
#   - a stale firewall rule pinned to an IP the laptop no longer had
#   - 1Password not running, so ssh had no key and git push said only
#     "Permission denied (publickey)"
#   - Tailscale SSH's periodic re-auth, whose URL goes to ssh's stderr
#     where nothing surfaces it
# Each needed a different action, and none of them announced itself.
#
# Node key expiry is the one with a deadline: Tailscale expires node keys
# after 180 days by default, and when the box's key goes it drops off the
# tailnet entirely. That is a lockout scheduled months in advance, so it
# is counted down rather than discovered.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devbox-health"

# Find the agent ourselves. SSH_AUTH_SOCK is exported from .zshrc, an
# INTERACTIVE shell file, so anything started by Hyprland's exec-once —
# DMS, and therefore this script when the pill runs it — inherits nothing
# and ssh-add reports "Could not open a connection to your authentication
# agent". That read as a locked vault and the pill warned about a
# perfectly healthy 1Password. ssh itself was unaffected, because
# ~/.ssh/config names the socket with IdentityAgent, which is exactly why
# the two disagreed.
if [ -z "${SSH_AUTH_SOCK:-}" ] && [ -S "$HOME/.1password/agent.sock" ]; then
  export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
fi
PEER="${DEVBOX_PEER:-devbox}"
mkdir -p "$STATE_DIR"

now=$(date +%s)
tsd=$(systemctl is-active tailscaled 2>/dev/null || echo inactive)

peer=unknown; expiry=0; self_expiry=0
if [ "$tsd" = active ]; then
  eval "$(timeout 10 tailscale status --json 2>/dev/null | python3 -c '
import json, sys, datetime
def epoch(s):
    if not s: return 0
    try:
        return int(datetime.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp())
    except Exception:
        return 0
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
me = d.get("Self") or {}
print(f"self_expiry={epoch(me.get(chr(75)+chr(101)+chr(121)+chr(69)+chr(120)+chr(112)+chr(105)+chr(114)+chr(121)))}")
for p in (d.get("Peer") or {}).values():
    if (p.get("HostName") or "") == "'"$PEER"'":
        print("peer=" + ("online" if p.get("Online") else "offline"))
        print(f"expiry={epoch(p.get(chr(75)+chr(101)+chr(121)+chr(69)+chr(120)+chr(112)+chr(105)+chr(114)+chr(121)))}")
        break
else:
    print("peer=missing")
' 2>/dev/null)"
fi

# The ssh probe is what catches an auth wall: Tailscale SSH answers the
# connection and then asks for a browser, which no amount of ping would
# reveal.
ssh_state=unknown; authurl=""
if [ "$peer" = online ]; then
  out="$(timeout 12 ssh -o BatchMode=yes -o ConnectTimeout=6 "$PEER" true 2>&1)"
  rc=$?
  case "$out" in
    *login.tailscale.com*)
      ssh_state=auth
      authurl="$(printf '%s' "$out" | grep -oE 'https://login\.tailscale\.com/[A-Za-z0-9/._-]+' | head -1)"
      ;;
    *) [ "$rc" -eq 0 ] && ssh_state=ok || ssh_state=fail ;;
  esac
fi

# Round-trip time to the box. The one number that decides whether working
# on it feels local — which is the question that picked this box in the
# first place. Tailscale's own ping reports the path too (direct vs a DERP
# relay), and a relayed path is exactly when typing starts to drag.
rtt=""; path=""
if [ "$peer" = online ]; then
  ping_out="$(timeout 6 tailscale ping --c 1 --timeout 3s "$PEER" 2>/dev/null | head -1)"
  case "$ping_out" in
    *" in "*) rtt="$(printf '%s' "$ping_out" | grep -oE '[0-9]+(\.[0-9]+)?ms' | head -1)" ;;
  esac
  # "via DERP(xxx)" is a relayed path; anything else "via host:port" went
  # peer to peer. The word "direct" never appears in the output.
  case "$ping_out" in
    *"via DERP"*) path="relay" ;;
    *" via "*)    path="direct" ;;
  esac
fi

# 1Password's agent: keys live there, so a locked vault looks exactly like
# a permissions problem to git and ssh.
#
# A TIMEOUT is not the same as "no keys". The agent is answered by the
# desktop app, which is 5s warm but 10-60s cold, so a short deadline
# reports a perfectly healthy vault as locked — which it did, on the
# first real poll. A notifier that cries wolf teaches you to ignore it,
# so a slow answer is "unknown" and never raises the state.
op_out="$(timeout 25 ssh-add -l 2>&1)"
case "$?" in
  0)   op=ok ;;
  124) op=slow ;;                       # still thinking; judge nothing
  *)   case "$op_out" in
         *"no identities"*)  op=empty ;;
         *)                  op=locked ;;
       esac ;;
esac

days_left=0
[ "$expiry" -gt 0 ] 2>/dev/null && days_left=$(( (expiry - now) / 86400 ))

state=ok; detail="box reachable"
if [ "$tsd" != active ]; then
  state=error; detail="tailscaled is not running"
elif [ "$peer" = missing ]; then
  state=error; detail="$PEER is not on the tailnet"
elif [ "$peer" = offline ]; then
  state=error; detail="$PEER is offline"
elif [ "$ssh_state" = auth ]; then
  state=warn;  detail="Tailscale SSH needs re-authentication"
elif [ "$ssh_state" = fail ]; then
  state=error; detail="ssh to $PEER failed"
elif [ "$expiry" -gt 0 ] && [ "$days_left" -le 14 ]; then
  state=warn;  detail="node key expires in ${days_left}d"
elif [ "$op" = locked ] || [ "$op" = empty ]; then
  state=warn;  detail="1Password agent has no keys"
fi

printf 'NOW:%s\nTSD:%s\nPEER:%s\nSSH:%s\nOP:%s\nEXPIRY:%s\nDAYS:%s\nSELFEXPIRY:%s\nRTT:%s\nPATH:%s\nHOST:%s\nSTATE:%s\nDETAIL:%s\nAUTHURL:%s\n' \
  "$now" "$tsd" "$peer" "$ssh_state" "$op" "$expiry" "$days_left" "$self_expiry" \
  "$rtt" "$path" "$PEER" "$state" "$detail" "$authurl"

printf '%s' "$authurl" > "$STATE_DIR/authurl"

if [ "${1:-}" = notify ]; then
  prev="$(cat "$STATE_DIR/state" 2>/dev/null || echo)"
  if [ "$state|$detail" != "$prev" ]; then
    printf '%s' "$state|$detail" > "$STATE_DIR/state"
    case "$state" in
      ok)
        # Only announce coming back from something you were ASKED to fix.
        # Recovering from an outage needs no announcement, because the
        # outage itself is no longer announced (below).
        case "$prev" in
          warn*) notify-send -a "Dev box" -t 4000 "Dev box ready" "$detail" ;;
        esac
        # Coming back from unreachable is exactly when the box is holding
        # corpses: every dropped connection leaves an attach behind, and
        # Tailscale SSH never reaps them, so the pane you are trying to
        # rejoin refuses with "client is already connected". Clear them at
        # the moment the link returns, rather than on a timer that fires
        # long after you have tried and failed.
        case "$prev" in
          ok\|*) ;;
          *) ssh -o BatchMode=yes -o ConnectTimeout=10 "$PEER" \
               '$HOME/.local/bin/herdr-reap-stale' >/dev/null 2>&1 || true ;;
        esac
        ;;
      # warn means something wants a human: re-authenticate, a key about to
      # expire, a locked vault. Worth interrupting for.
      warn)  notify-send -a "Dev box" -u normal -t 8000 "Dev box needs you" "$detail" ;;
      # error is NOT announced. On a laptop that roams, the box being
      # briefly unreachable is ordinary and self-healing — the link drops
      # and comes back — and a critical popup for each one teaches you to
      # dismiss the app, which costs the notifications that do matter. The
      # pill still carries the state, and the reap on recovery still runs.
      error) : ;;
    esac
  fi
fi
