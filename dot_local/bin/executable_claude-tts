#!/usr/bin/env bash
# claude-tts — speak Claude Code's final message aloud (piper, local neural
# TTS — the output mirror of voxtype's local whisper input).
#
#   claude-tts             # hook mode: reads Claude Code Stop-hook JSON on
#                          # stdin (registered in ~/.claude/settings.json)
#   claude-tts progress    # PreToolUse hook: speak the interim text
#                          # written just before a tool call
#   claude-tts notify      # Notification hook: background work finished
#   claude-tts on|off      # enable / disable speech (default: on)
#   claude-tts toggle      # flip + notify (Super+Ctrl+V, bar pill syncs)
#   claude-tts stop        # shut up — kill the current playback
#   claude-tts status      # enabled? which voice?
#   claude-tts voice [nm]  # list voices (piper + kokoro) / switch
#   claude-tts setup-kokoro # bootstrap engine two (venv + models, ~340MB)
#   claude-tts test [txt]  # speak a test line
#
# Design: extraction runs inline (fast), playback is DETACHED (setsid -f)
# so the hook returns immediately — a long read never blocks the next
# prompt. Within one session the newest message wins, but speech never
# chops itself off: _wait/_queued wait out playback in flight first, and
# `say` exposes that same courtesy to other sources (see devbox-speak).
# Markdown is flattened for the ear: code fences become the words "Code
# block", links keep their text, headers/bullets/emphasis are stripped.

set -uo pipefail

VOICES="$HOME/.local/share/claude-tts"
KOKORO="$VOICES/kokoro"
STATE="$HOME/.local/state/claude-tts"
mkdir -p "$STATE"
OFF="$STATE/off"

# How long a waiter will hold off before speaking anyway, in half-seconds.
# This is a deadlock valve, NOT a pacing knob: falling through it does not
# queue politely, it calls hush and cuts off whatever is mid-sentence. At
# 120 (60s) that happened routinely — Kokoro reads ~150 words a minute and
# replies are frequently longer, so a long message got chopped by the next
# one. speaking() already prunes dead process groups, so the only thing
# left for this to guard is a genuinely hung player.
WAIT_MAX=1200   # 10 minutes

# Speech that has not started yet lives in detached waiters, not in a
# list — so "shut up and forget the rest" cannot be done by killing a
# queue. Each waiter records the generation it was spawned in and checks
# it again before speaking; `clear` bumps the generation and every
# pending waiter quietly gives up. No pattern-matching processes, which
# is the trap that keeps killing the wrong thing.
GEN="$STATE/gen"
PAUSED="$STATE/paused"
gen() { cat "$GEN" 2>/dev/null || echo 0; }
bump_gen() { mkdir -p "$STATE"; printf '%s' "$(( $(gen) + 1 ))" > "$GEN"; }
stale() { [ "$(gen)" != "$1" ]; }

# voxtype writes "idle" or "recording" here; voxtype-autostop polls the
# same file. Speaking while the mic is hot is doubly wrong: it talks over
# the user, and whisper transcribes our own voice back into their input.
VOXSTATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/voxtype/state"
dictating() { [ "$(cat "$VOXSTATE" 2>/dev/null)" = recording ]; }
# Active voice: name in $STATE/voice (set via `claude-tts voice <name>`).
# Two engines share the selector: piper voices are onnx basenames
# (en_US-ryan-high); Kokoro-82M voices carry a kokoro- prefix
# (kokoro-af_heart) and run via kokoro-say.py in the uv venv.
DEFAULT_VOICE="en_US-lessac-medium"
VOICE="$(cat "$STATE/voice" 2>/dev/null || echo "$DEFAULT_VOICE")"
# Curated Kokoro voices (voices-v1.0.bin holds 54; these are the strong
# English ones): af_heart af_bella af_nicole am_michael am_fenrir bf_emma
# bm_george — list via `claude-tts voice`.
KOKORO_VOICES="af_heart af_bella af_nicole am_michael am_fenrir bf_emma bm_george"

engine() { case "$VOICE" in kokoro-*) echo kokoro ;; *) echo piper ;; esac; }
kokoro_ok() {
  [ -x "$KOKORO/venv/bin/python" ] && [ -f "$KOKORO/kokoro-v1.0.onnx" ] \
    && [ -f "$KOKORO/voices-v1.0.bin" ]
}

MODEL="$VOICES/$VOICE.onnx"
if [ "$(engine)" = piper ] && [ ! -f "$MODEL" ]; then
  VOICE="$DEFAULT_VOICE"; MODEL="$VOICES/$DEFAULT_VOICE.onnx"
fi

# Is audio playing right now? (pw-cat -p is playback; voxtype-autostop's
# capture is pw-cat -r, so it can't be mistaken for speech.)
# Playback runs in its own process GROUP whose id is recorded below, so
# "is it speaking?" and "shut up" are exact — no pattern matching at all.
# Every pkill -f pattern this replaced ("claude-tts/en_US", "pw-cat -p
# --raw") also matched innocent processes that merely MENTIONED the
# string, e.g. a shell testing this script, and killed them (exit 144).
# One file per live playback, named for its process GROUP id. A single
# slot was not enough: hook speech and a manual test can overlap, and the
# newer launcher clobbered the older id, leaving that one unkillable.
speaking() {
  local f pg
  for f in "$STATE"/pgids/*; do
    [ -e "$f" ] || continue
    pg="${f##*/}"
    if kill -0 -"$pg" 2>/dev/null; then return 0; fi
    rm -f "$f"          # dead group: prune
  done
  return 1
}

# One line per hook invocation: which event fired and what it did.
# Bounded to the last 200 lines. This is how we tell whether
# MessageDisplay or PreToolUse is actually carrying the interim text.
hooklog() {   # event outcome id
  printf '%s %-14s %-8s %s\n' "$(date +%T)" "$1" "$2" "${3:0:8}" >> "$STATE/hook.log"
  tail -n 200 "$STATE/hook.log" > "$STATE/hook.log.tmp" 2>/dev/null \
    && mv -f "$STATE/hook.log.tmp" "$STATE/hook.log"
}

# Kill any in-flight speech. Bracket trick keeps pkill from matching this
# script's own cmdline (the voxtype/screensaver lesson). Both patterns key
# on the claude-tts model dir so no other piper/pw-cat use gets caught.
# Playback and synthesis run under their OWN argv[0] (exec -a below), so
# these are pkill -x on an exact process NAME. Every -f pattern here was a
# footgun: "claude-tts/en_US" and "pw-cat -p --raw" match any process whose
# command line merely MENTIONS them — including a shell testing this script,
# which is exactly how it kept killing test runs (exit 144).
# SIGSTOP the player rather than killing it: pw-cat stops consuming and
# the audio holds exactly where it is, so CONT resumes mid-word. Nothing
# to re-synthesize and no position to track.
pause_speech() {
  local f pg n=0
  for f in "$STATE"/pgids/*; do
    [ -e "$f" ] || continue
    pg="${f##*/}"
    kill -STOP -"$pg" 2>/dev/null && n=$((n+1))
  done
  [ "$n" -gt 0 ] && : > "$PAUSED"
  return 0
}

resume_speech() {
  local f pg
  for f in "$STATE"/pgids/*; do
    [ -e "$f" ] || continue
    pg="${f##*/}"
    kill -CONT -"$pg" 2>/dev/null
  done
  rm -f "$PAUSED"
  return 0
}

hush() {
  local f pg
  for f in "$STATE"/pgids/*; do
    [ -e "$f" ] || continue
    pg="${f##*/}"
    # CONT first: a SIGSTOPped group never processes the TERM.
    kill -CONT -"$pg" 2>/dev/null
    kill -TERM -"$pg" 2>/dev/null
    rm -f "$f"
  done
  return 0
}

# Speak $1 in a detached session (survives the hook process exiting).
# Binary is piper-tts (piper-tts-bin package); playback via pw-cat — this
# machine has no alsa-utils/aplay, PipeWire tools only. The playback rate
# comes from the voice's own config (a hardcoded rate chipmunks any voice
# whose native rate differs). sentence_silence eases the pacing.
# A headless box has no audio. Rather than losing spoken replies when
# working remotely, write the text to a queue the LAPTOP drains over ssh
# (see devbox-speak) — the machine with speakers does the speaking.
queue_mode() { [ -n "${CLAUDE_TTS_QUEUE:-}" ] || ! command -v pw-cat >/dev/null 2>&1; }

# A nudge you can see with the sound off. Detached, so a hook never waits
# on an animation, and a no-op wherever there is no keyboard backlight
# (the dev box, any desktop).
blink() {
  [ -x "$HOME/.local/bin/kbd-fx" ] || return 0
  setsid -f "$HOME/.local/bin/kbd-fx" pulse "${1:-2}" >/dev/null 2>&1 </dev/null || true
}

say_text() {
  # Mute is enforced HERE, the one point every path reaches. Guarding
  # only the hook entries left `say` and `test` deaf to it, so muting did
  # nothing to speech arriving from the box: toggle hushed the current
  # line and the drainer immediately started the next one.
  [ -e "$OFF" ] && return 0
  if queue_mode; then
    mkdir -p "$STATE"
    printf '%s\n' "$(printf '%s' "$1" | tr '\n' ' ')" >> "$STATE/say-queue"
    # The drainer tails from the end, so consumed lines are never removed.
    # Cap the file rather than let a long-lived box grow it forever.
    if [ "$(wc -l < "$STATE/say-queue")" -gt 500 ]; then
      tail -n 100 "$STATE/say-queue" > "$STATE/say-queue.tmp" \
        && mv "$STATE/say-queue.tmp" "$STATE/say-queue"
    fi
    return 0
  fi
  # Hold — do not drop — until the user stops dictating. This sits in
  # say_text rather than in the waiters because it must cover every path
  # into speech, including urgent announcements, which deliberately skip
  # the queue and would otherwise cut in mid-sentence while the mic is
  # live. The message is spoken once dictation ends.
  w=0
  while dictating && [ "$w" -lt "$WAIT_MAX" ]; do sleep 0.5; w=$((w+1)); done

  hush
  if [ "$(engine)" = kokoro ]; then
    kokoro_ok || return 0
    # seq rises with every playback. A pending resume compares against it
    # and gives up if anything else has spoken since — a stale remainder
    # is worse than no remainder.
    printf '%s' "$(( $(cat "$STATE/seq" 2>/dev/null || echo 0) + 1 ))" > "$STATE/seq"
    printf '%s' "$1" > "$STATE/current-text"
    printf '%s' "$1" > "$STATE/last-text"
    setsid -f env TTS_TEXT="$1" TTS_VOICE="${VOICE#kokoro-}" KOKORO="$KOKORO" \
      STATE="$STATE" KOKORO_PROGRESS="$STATE/progress" \
      KOKORO_FROM_UNIT="${TTS_FROM_UNIT:-0}" bash -c '
      mkdir -p "$STATE/pgids"; touch "$STATE/pgids/$$"   # setsid: we lead the group
      printf "%s" "$TTS_TEXT" > "$STATE/speaking"   # what the mic is about to hear
      printf 0 > "$STATE/progress"
      printf "%s" "$TTS_TEXT" \
        | "$KOKORO/venv/bin/python" "$KOKORO/kokoro-say.py" "$TTS_VOICE" 2>/dev/null \
        | pw-cat -p --raw --rate 24000 --channels 1 --format s16 - 2>/dev/null
      rm -f "$STATE/pgids/$$" "$STATE/speaking"
    ' >/dev/null 2>&1 </dev/null
    return 0
  fi
  [ -f "$MODEL" ] || return 0
  rate="$(jq -r '.audio.sample_rate // 22050' "$MODEL.json" 2>/dev/null || echo 22050)"
  setsid -f env TTS_TEXT="$1" TTS_MODEL="$MODEL" TTS_RATE="$rate" \
    STATE="$STATE" bash -c '
    mkdir -p "$STATE/pgids"; touch "$STATE/pgids/$$"
    printf "%s" "$TTS_TEXT" \
      | piper-tts -m "$TTS_MODEL" --output_raw --sentence_silence 0.35 2>/dev/null \
      | pw-cat -p --raw --rate "$TTS_RATE" --channels 1 --format s16 - 2>/dev/null
    rm -f "$STATE/pgids/$$" "$STATE/speaking"
  ' >/dev/null 2>&1 </dev/null
}

# Speak a short canned announcement (not transcript text): $1 event,
# $2 phrase, $3 urgent (1 = cut in, 0 = wait for silence first). The
# repeat guard is keyed on the phrase, so several agents finishing at
# once announce themselves once, not once each.
announce() {
  local ev="$1" say="$2" urgent="$3" h now prev_h prev_t
  [ -n "${say//[[:space:]]/}" ] || return 0
  h="$(printf '%s' "$say" | cksum | cut -d\  -f1)"
  now="$(date +%s)"; prev_h=""; prev_t=0
  [ -f "$STATE/last-notify" ] && read -r prev_h prev_t < "$STATE/last-notify"
  case "$prev_t" in (*[!0-9]*|"") prev_t=0 ;; esac
  if [ "$prev_h" = "$h" ] && [ "$(( now - prev_t ))" -lt 120 ]; then
    hooklog "$ev" dup "$h"; return 0
  fi
  printf '%s %s' "$h" "$now" > "$STATE/last-notify"
  if [ "$urgent" = 0 ]; then
    # setsid, not `( ) &`: a plain background subshell dies with the hook
    # process (measured — the announcement never reached hooklog), while
    # the marker had already been written, so the retry deduped and the
    # event was lost entirely.
    setsid -f "$0" _queued "$ev" "$say" >/dev/null 2>&1 </dev/null
    return 0
  fi
  hooklog "$ev" spoke "$h"
  say_text "$say"
}

# Markdown -> listenable text. Beyond structure-stripping, the goal is
# taming what espeak's phonemizer turns into frantic gibberish: raw URLs,
# deep filesystem paths, and symbol runs all "speed-read" horribly.
clean_md() {
  awk 'BEGIN{cb=0} /^```/{cb=!cb; if(cb) print "Code block."; next} !cb' \
  | sed -E \
      -e '/^[-| :=]+$/d' \
      -e 's/\[([^]]*)\]\([^)]*\)/\1/g' \
      -e 's/`([^`]+)`/\1/g' \
      -e 's/^#+ +//' \
      -e 's/(\*\*|__)//g' \
      -e 's/\*([^*]+)\*/\1/g' \
      -e 's@https?://[^[:space:])]+@ link @g' \
      -e 's@(~|/)[A-Za-z0-9._/-]*/([A-Za-z0-9._-]+)@ \2@g' \
      -e 's/^ *[-*•] +//' \
      -e 's/[-=]{3,}/ /g' \
      -e 's/[|]/ /g' \
      -e 's/✓/ check /g; s/[✗✘]/ fail /g; s/→/ to /g; s/·/, /g'
}

# Newest non-sidechain assistant entry: "uuid<TAB>timestamp<TAB>text".
# Only the tail is parsed — this session's transcript is 40MB and JSONL is
# one entry per line, so a tail can't split an entry. fromjson? tolerates
# partial lines; the format is version-prone, so fail silent, not loud.
last_entry_stdin() {
  jq -rRs '
    [ split("\n")[] | fromjson?
      | select(.type=="assistant") | select(.isSidechain != true)
      | { u: (.uuid // ""), ts: (.timestamp // ""),
          t: ((.message.content // []) | map(select(.type=="text") | .text) | join("\n")) }
      | select(.t | length > 0)
    ] | last // empty | "\(.u)\t\(.ts)\t\(.t)"' 2>/dev/null
}

# Same extraction, from a file. A remote transcript arrives on stdin
# instead, so the box needs no jq of its own.
last_entry() { tail -n 400 "$1" 2>/dev/null | last_entry_stdin; }

case "${1:-hook}" in
  hook|progress)
    mode="${1:-hook}"
    input="$(cat)"
    [ -e "$OFF" ] && exit 0
    # Loop guard: never speak from a re-entrant Stop hook.
    [ "$(jq -r '.stop_hook_active // false' <<<"$input")" = "true" ] && exit 0
    tp="$(jq -r '.transcript_path // empty' <<<"$input")"
    [ -n "$tp" ] && [ -f "$tp" ] || exit 0
    ev="$(jq -r '.hook_event_name // "?"' <<<"$input" 2>/dev/null)"
    # Do NOT read the transcript here: the entry for the message that just
    # ended has not been written yet (measured — a message carrying a tool
    # call lands only after PreToolUse fires, and Stop beat the final
    # message's line by ~1s). Reading now returns the PREVIOUS message,
    # which is exactly the "speaking one message behind" bug. Hand off to
    # a detached waiter and return instantly so nothing blocks.
    hooklog "$ev" queued ""
    setsid -f "$0" _wait "$ev" "$tp" >/dev/null 2>&1 </dev/null
    ;;
  _wait)
    # Detached: wait for an entry NEWER than the last one spoken, then
    # read it. Monotonic on timestamp, so speech can never go backwards
    # into an already-voiced message. Messages queue rather than chop each
    # other off; the lock keeps two waiters from talking over each other.
    ev="$2"; tp="$3"
    mygen="$(gen)"
    deadline=$(( $(date +%s) + 60 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
      entry="$(last_entry "$tp")"
      if [ -n "$entry" ]; then
        uuid="${entry%%$'\t'*}"; rest="${entry#*$'\t'}"
        ts="${rest%%$'\t'*}"; text="${rest#*$'\t'}"
        prev_uuid="$(cat "$STATE/last-uuid" 2>/dev/null)"
        prev_ts="$(cat "$STATE/last-ts" 2>/dev/null)"
        if [ "$uuid" != "$prev_uuid" ] && { [ -z "$prev_ts" ] || [[ "$ts" > "$prev_ts" ]]; }; then
          (
            flock 9
            # Cleared while we waited: this message is no longer wanted.
            stale "$mygen" && exit 0
            # Re-check under the lock: another waiter may have claimed it.
            if [ "$uuid" != "$(cat "$STATE/last-uuid" 2>/dev/null)" ]; then
              printf '%s' "$uuid" > "$STATE/last-uuid"
              printf '%s' "$ts" > "$STATE/last-ts"
              spoken="$(printf '%s' "$text" | clean_md)"
              if [ -n "${spoken//[[:space:]]/}" ]; then
                w=0
                while speaking && [ "$w" -lt "$WAIT_MAX" ]; do sleep 0.5; w=$((w+1)); done
                hooklog "$ev" spoke "$uuid"
                say_text "$spoken"
              fi
            fi
          ) 9>"$STATE/claim.lock"
          exit 0
        fi
      fi
      sleep 0.3
    done
    hooklog "$ev" timeout ""
    ;;
  _queued)
    # Detached tail of announce(): wait out any speech, then say it.
    ev="$2"; say="$3"
    mygen="$(gen)"
    w=0; while speaking && [ "$w" -lt "$WAIT_MAX" ]; do sleep 0.5; w=$((w+1)); done
    stale "$mygen" && exit 0
    hooklog "$ev" spoke "queued"
    say_text "$say"
    ;;
  notify)
    # Notification hook. The "you are needed" announcements (permission
    # prompts, idle, agent-needs-input) are deliberately silent: they
    # talked over the answer being read, and the screen already shows
    # them. What survives is work COMPLETING while you look elsewhere.
    input="$(cat)"
    ev="$(jq -r '.hook_event_name // "Notification"' <<<"$input" 2>/dev/null)"
    kind="$(jq -r '.matcher // .notification_type // .type // empty' <<<"$input" 2>/dev/null)"
    # The mute check moved INSIDE, per action: a keyboard blink is not
    # speech, and a signal you can see matters MORE when the sound is off.
    case "$kind" in
      agent_completed)
        blink 2
        [ -e "$OFF" ] || announce "$ev" "A background session finished." 0
        ;;
      quota_auto_resume_fired)
        [ -e "$OFF" ] || announce "$ev" "Usage limit reset. Continuing." 0
        ;;
      *) : ;;   # silent
    esac
    ;;
  on)     rm -f "$OFF"; echo "claude-tts: enabled" ;;
  off)    touch "$OFF"; bump_gen; hush; echo "claude-tts: disabled" ;;
  toggle)
    if [ -e "$OFF" ]; then
      rm -f "$OFF"
      notify-send -a "Claude Voice" -t 2500 "Claude speaks" \
        "replies will be read aloud" 2>/dev/null || true
    else
      touch "$OFF"; hush
      notify-send -a "Claude Voice" -t 2500 "Claude muted" \
        "toggle back: Super+Ctrl+V or the bar pill" 2>/dev/null || true
    fi
    ;;
  stop)   hush ;;
  clear)
    # Silence now AND forget what was lined up. hush alone only ends the
    # sentence in the air; the waiters behind it would each take their
    # turn, which is what made muting feel like it did nothing.
    bump_gen
    hush
    rm -f "$STATE/resume-at" "$STATE/resume-text" "$PAUSED"
    echo "claude-tts: cleared"
    ;;
  pause)
    # Toggle. A pause that needs a different key to undo is a pause you
    # will forget you pressed.
    if [ -e "$PAUSED" ]; then resume_speech; echo "claude-tts: resumed"
    else pause_speech; [ -e "$PAUSED" ] && echo "claude-tts: paused" || echo "claude-tts: nothing playing"; fi
    ;;
  skip)
    # End this message, keep the rest: the generation is untouched, so
    # whatever was waiting still gets its turn.
    resume_speech
    hush
    echo "claude-tts: skipped"
    ;;
  replay)
    # Say the last thing again, whatever it was.
    [ -s "$STATE/last-text" ] || { echo "nothing spoken yet" >&2; exit 1; }
    hush
    say_text "$(cat "$STATE/last-text")"
    ;;
  read-last)
    # Read the final assistant message of the session you are sitting in.
    #
    # Three cases, because a herdr pane can be one of three things: a local
    # agent (the session id is right there), a herdr-mirror pane showing an
    # agent on the box (the id lives on the FAR side, and the pane's own
    # process is the only thing that knows which remote pane it mirrors),
    # or something that is not an agent at all.
    cur="$(herdr pane current 2>/dev/null)"
    pane="$(printf '%s' "$cur" | jq -r '.result.pane.pane_id // empty' 2>/dev/null)"
    sid="$(printf '%s' "$cur" | jq -r '.result.pane.agent_session.value // empty' 2>/dev/null)"
    [ -n "$pane" ] || { echo "no focused pane — is this a herdr pane?" >&2; exit 1; }

    text=""
    if [ -n "$sid" ]; then
      tp="$(ls -1 "$HOME"/.claude/projects/*/"$sid".jsonl 2>/dev/null | head -1)"
      [ -n "$tp" ] || { echo "no transcript for session $sid" >&2; exit 1; }
      text="$(last_entry "$tp")"
    else
      # No local session: follow the mirror. `pane process-info` reports
      # the pane's argv, and a mirror pane is literally
      # `herdr-mirror pane <host> <remote-pane>` — the mapping is not
      # recorded anywhere else.
      read -r mhost mpane <<<"$(herdr pane process-info --pane "$pane" 2>/dev/null | jq -r '
        .result.process_info.foreground_processes[]?.argv
        | select(. != null)
        | select(any(.[]; test("herdr-mirror$")))
        | select(length > 3 and .[1] == "pane")
        | "\(.[2]) \(.[3])"' 2>/dev/null | head -1)"
      if [ -z "$mhost" ]; then
        echo "no agent in this pane" >&2; exit 1
      fi
      rsid="$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$mhost" \
              "\$HOME/.local/bin/herdr agent list" 2>/dev/null \
              | jq -r --arg p "$mpane" '.result.agents[]
                  | select(.pane_id == $p) | .agent_session.value // empty' 2>/dev/null | head -1)"
      if [ -z "$rsid" ]; then
        # herdr only learns a session id at SessionStart, so a conversation
        # older than the integration on that host is invisible to it.
        echo "$mhost pane $mpane has no session id yet — herdr learns it at SessionStart," >&2
        echo "so a conversation started before the integration was installed is invisible." >&2
        echo "It registers itself the next time that session starts or resumes." >&2
        exit 1
      fi
      text="$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$mhost" \
        "sh -c 'tail -n 400 \$HOME/.claude/projects/*/$rsid.jsonl 2>/dev/null'" 2>/dev/null \
        | last_entry_stdin)"
    fi

    [ -n "$text" ] || { echo "no assistant message to read" >&2; exit 1; }
    body="$(printf '%s' "${text#*$'\t'}" | cut -f2-)"
    spoken="$(printf '%s' "$body" | clean_md)"
    [ -n "${spoken//[[:space:]]/}" ] || { echo "nothing readable" >&2; exit 1; }
    hush
    say_text "$spoken"
    ;;
  status)
    [ -e "$OFF" ] && echo "speech: disabled" || echo "speech: enabled"
    if [ "$(engine)" = kokoro ]; then
      kokoro_ok && echo "voice:  $VOICE (kokoro)" \
        || echo "voice:  $VOICE — kokoro engine incomplete (claude-tts setup-kokoro)"
    else
      [ -f "$MODEL" ] && echo "voice:  $VOICE (piper)" \
        || echo "voice:  MISSING ($MODEL)"
    fi
    ;;
  voice)
    if [ -n "${2:-}" ]; then
      ok=0
      case "$2" in
        kokoro-*)
          kokoro_ok || { echo "kokoro engine not installed" >&2; exit 1; }
          for k in $KOKORO_VOICES; do [ "kokoro-$k" = "$2" ] && ok=1; done
          ;;
        *) [ -f "$VOICES/$2.onnx" ] && ok=1 ;;
      esac
      if [ "$ok" = 1 ]; then
        echo "$2" > "$STATE/voice"
        echo "voice: $2"
      else
        echo "no such voice: $2 (available below)" >&2
        "$0" voice >&2
        exit 1
      fi
    else
      for f in "$VOICES"/*.onnx; do
        n="$(basename "$f" .onnx)"
        [ "$n" = "$VOICE" ] && echo "* $n  (piper)" || echo "  $n  (piper)"
      done
      if kokoro_ok; then
        for k in $KOKORO_VOICES; do
          [ "kokoro-$k" = "$VOICE" ] && echo "* kokoro-$k" || echo "  kokoro-$k"
        done
      fi
    fi
    ;;
  snapshot)
    # Record where playback had got to, so it can be picked up later.
    # Called by `dictate` BEFORE it hushes — once the process group is
    # gone the progress file stops advancing, so ordering matters.
    speaking || exit 0
    [ "$(engine)" = kokoro ] || exit 0     # piper has no unit positions
    printf '%s %s' "$(cat "$STATE/progress" 2>/dev/null || echo 0)" \
                   "$(cat "$STATE/seq" 2>/dev/null || echo 0)" > "$STATE/resume-at"
    cp -f "$STATE/current-text" "$STATE/resume-text" 2>/dev/null || true
    ;;
  _resume)
    # Detached: wait out the dictation, then finish what was interrupted.
    [ -f "$STATE/resume-at" ] && [ -f "$STATE/resume-text" ] || exit 0
    read -r unit seq < "$STATE/resume-at"
    # The key may have been pressed before voxtype flips to "recording",
    # so wait briefly for it to start rather than racing it to idle.
    w=0; while [ "$w" -lt 20 ] && ! dictating; do sleep 0.25; w=$((w+1)); done
    w=0; while dictating && [ "$w" -lt "$WAIT_MAX" ]; do sleep 0.5; w=$((w+1)); done
    # Something newer spoke while the mic was open — let it stand.
    [ "$(cat "$STATE/seq" 2>/dev/null || echo 0)" = "$seq" ] || exit 0
    text="$(cat "$STATE/resume-text")"
    rm -f "$STATE/resume-at" "$STATE/resume-text"
    [ -n "${text//[[:space:]]/}" ] || exit 0
    hooklog resume spoke "unit $unit"
    TTS_FROM_UNIT="$unit" say_text "$text"
    ;;
  busy)
    # Exit 0 while audio is playing. devbox-speak serializes queued remote
    # replies on this — the pgid protocol stays in one place.
    speaking
    ;;
  say)
    # Speak text WITHOUT cutting off whatever is already talking: the
    # polite entry point, and the one anything outside this machine's own
    # session stream must use. Local hooks already queue this way via
    # _wait/_queued; devbox-speak feeds the box's replies through here so
    # a remote session cannot chop off a local one mid-sentence.
    shift || true
    exec "$0" _queued remote "$*"
    ;;
  test)
    shift || true
    say_text "${*:-Claude text to speech is working.}"
    ;;
  setup-kokoro)
    # Engine two bootstrap (fresh machine): uv venv + kokoro-onnx + the
    # model/voices files (~340MB, not in the repo — public git, big blobs).
    command -v uv >/dev/null 2>&1 || { echo "uv required (chezmoi apply installs it)" >&2; exit 1; }
    mkdir -p "$KOKORO"
    if [ ! -x "$KOKORO/venv/bin/python" ]; then
      uv venv "$KOKORO/venv" --quiet
      uv pip install --python "$KOKORO/venv/bin/python" --quiet kokoro-onnx
    fi
    base="https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0"
    for f in kokoro-v1.0.onnx voices-v1.0.bin; do
      [ -f "$KOKORO/$f" ] || curl -sL -o "$KOKORO/$f" "$base/$f"
    done
    kokoro_ok && echo "kokoro engine ready (claude-tts voice kokoro-af_heart)" \
      || { echo "setup incomplete" >&2; exit 1; }
    ;;
  *)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
