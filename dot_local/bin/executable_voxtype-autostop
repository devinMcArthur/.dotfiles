#!/usr/bin/env python3
"""voxtype-autostop — end a dictation when you say "submit".

voxtype records until something calls `voxtype record stop`, and
smart_auto_submit only presses Enter after that stop — so without this,
"submit" still needed a second Super+X. This watcher supplies the stop.

  voxtype-autostop            # daemon (systemd user unit voxtype-autostop)
  voxtype-autostop on|off     # enable/disable without restarting
  voxtype-autostop status     # enabled? windows? word?
  voxtype-autostop secs <n>   # walk-away silence limit (default 20)
  voxtype-autostop word <w>   # trigger word (default "submit")
  voxtype-autostop log        # what it decided, recording by recording

How: polls voxtype's state file and, while state is "recording", reads a
parallel PipeWire capture of the mic into a rolling buffer. When you go
quiet, it transcribes JUST the tail of that buffer with whisper tiny.en
and stops the recording only if you actually ended on the trigger word.
Thinking pauses are therefore free: a pause that isn't followed by the
word costs one cheap check and nothing else (the buffer can't change while
you're silent, so it never re-checks until you speak again). A long
silence still stops eventually, for walking away mid-recording.

Frames are high-passed before measuring RMS: this laptop's fan sits at a
loud but low-frequency noise floor that would swamp a plain energy
threshold, while speech survives the filter. The floor is tracked
adaptively (falls fast, rises slowly) but ONLY while you are not speaking —
adapting it during speech walks it up into the voice and ends the dictation
mid-sentence. See the note in watch_recording.

Every decision is logged (journalctl --user -u voxtype-autostop, or
`voxtype-autostop log`): what the tail check heard, why a recording
stopped, and the noise level when it did.
"""

import os
import re
import subprocess
import sys
import threading
import time
import traceback
import wave

import numpy as np

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
STATE_FILE = os.path.join(RUNTIME, "voxtype", "state")
# voxtype reads per-recording overrides from its runtime dir when it delivers
# the text, then deletes them. "true" here = press Enter for this one.
AUTO_SUBMIT_OVERRIDE = os.path.join(RUNTIME, "voxtype", "auto_submit_override")
# Tells voxtype-postprocess which near-miss word to strip from the end of
# this recording's text (voxtype itself only strips an exact "submit").
STRIP_FLAG = os.path.join(RUNTIME, "voxtype-autostop", "strip-trigger")
STATE_DIR = os.path.expanduser("~/.local/state/voxtype-autostop")
OFF_FLAG = os.path.join(STATE_DIR, "off")
SECS_FILE = os.path.join(STATE_DIR, "silence-secs")
WORD_FILE = os.path.join(STATE_DIR, "word")
TMP_WAV = os.path.join(RUNTIME, "voxtype-autostop-tail.wav")
# NAME, not path: voxtype rejects an absolute path with "unknown model"
# and falls back to the configured base.en.
MODEL_NAME = "tiny.en"
MODEL = os.path.expanduser("~/.local/share/voxtype/models/ggml-tiny.en.bin")

RATE = 16000
FRAME = 1600                  # 100ms
FRAME_BYTES = FRAME * 2       # s16 mono
ARM_MS = 400                  # speech needed before any stop is allowed
CHECK_MS = 1000               # pause (see SPEECH_RUN) before we listen for the word
TAIL_SEC = 4                  # how much audio the word-check transcribes
MIN_THRESHOLD = 400.0         # absolute floor for the high-passed RMS
THRESHOLD_MULT = 2.5          # speech = this much above the tracked floor
DEFAULT_SECS = 20.0           # walk-away stop
DEFAULT_WORD = "submit"
# Only SUSTAINED sound ends a pause: SPEECH_RUN speech-loud frames in a row
# (300ms). Until 2026-10-22 any single loud frame did, so a keyboard click,
# a cough or office chatter kept a pause from ever starting — no word
# check, no walk-away — and the recording ran until stopped by hand
# (measured: 17 of 49 frames of a "quiet" office crossed the threshold).
# A "mostly quiet window" (8 of 10 frames) was tried first and still
# failed a click-every-0.4s test: one unlucky burst discarded a correctly
# heard "submit", and the re-check on a click-filled buffer made whisper
# hallucinate for 9s. Clicks are 1-2 frames; words run longer.
SPEECH_RUN = 3
# What "submit" sounds like to whisper. "cement" is not a guess: base.en
# transcribed a spoken "submit" as "cement" twice in a row on 2026-10-22,
# and tiny.en hears what base hears. Only ever matched as the LAST word or
# two of a recording, so a sentence that merely contains one is safe.
SUBMIT_ALIASES = {"submit", "cement", "summit"}
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def log(msg: str) -> None:
    print(msg, flush=True)


def _read(path, default):
    try:
        v = open(path).read().strip()
        return v or default
    except OSError:
        return default


def silence_secs() -> float:
    try:
        return max(3.0, float(_read(SECS_FILE, DEFAULT_SECS)))
    except ValueError:
        return DEFAULT_SECS


def trigger_word() -> str:
    return _read(WORD_FILE, DEFAULT_WORD).lower()


def trigger_words() -> set:
    word = trigger_word()
    return SUBMIT_ALIASES if word == "submit" else {word}


def state() -> str:
    try:
        return open(STATE_FILE).read().strip()
    except OSError:
        return "unknown"


def stop_recording(submit_word=None) -> None:
    """Stop voxtype. With submit_word, also make it press Enter, and have
    voxtype-postprocess strip that word if it is not literally "submit"."""
    if submit_word:
        try:
            with open(AUTO_SUBMIT_OVERRIDE, "w") as f:
                f.write("true")
            os.makedirs(os.path.dirname(STRIP_FLAG), exist_ok=True)
            with open(STRIP_FLAG, "w") as f:
                f.write(submit_word)
        except OSError as e:
            log(f"could not write submit override: {e}")
    subprocess.run(["voxtype", "record", "stop"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def tail_heard(frames):
    """Transcribe the tail of the buffer; return the last line heard."""
    if not os.path.exists(MODEL):
        return None
    pcm = b"".join(frames)
    try:
        with wave.open(TMP_WAV, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(RATE)
            w.writeframes(pcm)
        out = subprocess.run(
            ["voxtype", "--quiet", "--model", MODEL_NAME, "transcribe", TMP_WAV],
            capture_output=True, text=True, timeout=15,
        ).stdout
    except (OSError, subprocess.SubprocessError) as e:
        log(f"tail check failed: {e}")
        return None
    lines = [ANSI.sub("", ln).strip() for ln in out.splitlines()]
    lines = [ln for ln in lines if ln and not ln.startswith(("Loading", "Audio format",
                                                            "Processing", "whisper_",
                                                            "ggml_", "main:"))]
    return lines[-1] if lines else ""


def ending_trigger(heard, words):
    """The trigger word the transcript ends on, or None."""
    if not heard:
        return None
    # Last couple of words only: "submit" mid-sentence must not end the
    # recording; the slack covers a trailing hallucinated word.
    tail = re.findall(r"[a-z']+", heard.lower())[-2:]
    for w in reversed(tail):
        if w in words:
            return w
    return None


def tail_says_word(frames, word) -> bool:
    """Kept for probing by hand: True if the tail ends on `word`."""
    words = SUBMIT_ALIASES if word == "submit" else {word}
    return ending_trigger(tail_heard(frames), words) is not None


def watch_recording(started: float) -> None:
    """One recording: stop it on the trigger word, or on a long silence."""
    cap = subprocess.Popen(
        ["pw-cat", "-r", "--raw", "--rate", str(RATE),
         "--channels", "1", "--format", "s16", "-"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    words = trigger_words()
    hard_limit = silence_secs() * 1000
    tail_frames = TAIL_SEC * 10
    buf: list = []
    run = 0                      # consecutive speech-loud frames
    floor = None
    speech_ms = silent_ms = 0
    armed = False
    checked = False              # one word-check per pause
    pending = {"hit": None}
    gen = 0                      # bumps when a pause ends; stales old checks

    def check(frames, my_gen):
        t = time.time()
        heard = tail_heard(frames)
        hit = ending_trigger(heard, words)
        log(f"  check +{t - started:5.1f}s ({time.time() - t:.1f}s): "
            f"heard {heard!r} -> {'STOP on ' + repr(hit) if hit else 'no trigger'}")
        if hit and my_gen == gen:
            pending["hit"] = hit
        elif hit:
            log("  (ignored: you spoke again before the check finished)")

    try:
        while state() == "recording":
            if pending["hit"]:
                log(f"  stop: trigger {pending['hit']!r} at +{time.time() - started:.1f}s")
                stop_recording(submit_word=pending["hit"])
                return
            raw = cap.stdout.read(FRAME_BYTES)
            if not raw or len(raw) < FRAME_BYTES:
                raise RuntimeError("mic capture ended (pw-cat exited)")
            buf.append(raw)
            del buf[:-tail_frames]

            samples = np.frombuffer(raw, dtype=np.int16).astype(np.float32)
            hp = np.diff(samples)
            rms = float(np.sqrt(np.mean(hp * hp))) if hp.size else 0.0

            if floor is None:
                floor = rms

            # Classify FIRST, against the floor as it stands, then adapt the
            # floor only on frames that were not speech.
            #
            # Updating it on every frame — which is what this did until
            # 2026-10-02 — let sustained speech drag the floor up into the
            # speech itself. Speech needs rms > floor*2.5, so once the floor
            # passed ~40% of speaking level the voice stopped counting as
            # speech, silent_ms began accumulating WHILE STILL TALKING, and
            # the walk-away timer expired. At 0.5% per 100ms frame the floor
            # covers that distance in ~9s; plus the 20s limit, dictation died
            # after ~30s of continuous speech.
            #
            # Freezing the floor during speech is self-correcting: a floor
            # set too low classifies more frames as speech and so stops
            # rising, which is the direction that keeps the mic open.
            is_speech = rms > max(floor * THRESHOLD_MULT, MIN_THRESHOLD)
            if not is_speech:
                if rms < floor:
                    floor = 0.7 * floor + 0.3 * rms      # drop fast
                else:
                    floor = 0.995 * floor + 0.005 * rms  # rise slowly
            run = run + 1 if is_speech else 0

            if is_speech:
                speech_ms += 100
                if speech_ms >= ARM_MS:
                    armed = True

            if run >= SPEECH_RUN:
                if silent_ms:
                    gen += 1         # the pause ended: you spoke again
                silent_ms = 0
                checked = False
            elif armed:
                silent_ms += 100
                if silent_ms >= hard_limit:
                    log(f"  stop: {silent_ms / 1000:.0f}s quiet (walk-away) at "
                        f"+{time.time() - started:.1f}s, floor {floor:.0f}")
                    stop_recording()
                    return
                if not checked and silent_ms >= CHECK_MS:
                    # One check per pause: nothing new enters the buffer
                    # but blips, so re-running it would find the same
                    # answer. Threaded so the capture keeps draining.
                    checked = True
                    threading.Thread(target=check, args=(list(buf), gen),
                                     daemon=True).start()
    finally:
        cap.terminate()
        try:
            cap.wait(timeout=2)
        except subprocess.TimeoutExpired:
            cap.kill()


def daemon() -> int:
    os.makedirs(STATE_DIR, exist_ok=True)
    log(f"voxtype-autostop up: words {sorted(trigger_words())}, "
        f"walk-away {silence_secs():.0f}s")
    while True:
        if state() == "recording" and not os.path.exists(OFF_FLAG):
            started = time.time()
            log("recording started")
            # A leftover flag from a recording that never delivered must not
            # strip the end of this one.
            try:
                os.remove(STRIP_FLAG)
            except OSError:
                pass
            # On an error, log it and watch the REST of this recording.
            # This used to give up silently until the recording ended, which
            # left a dictation with no autostop at all — it ran until
            # stopped by hand.
            while state() == "recording" and not os.path.exists(OFF_FLAG):
                try:
                    watch_recording(started)
                    break
                except Exception:
                    log("  watcher error, retrying:\n" + traceback.format_exc().rstrip())
                    time.sleep(0.5)
            while state() == "recording":
                time.sleep(0.15)
            log(f"recording ended after {time.time() - started:.1f}s (now {state()})")
        else:
            time.sleep(0.15)


def main() -> int:
    os.makedirs(STATE_DIR, exist_ok=True)
    cmd = sys.argv[1] if len(sys.argv) > 1 else "daemon"
    if cmd == "daemon":
        return daemon()
    if cmd == "on":
        if os.path.exists(OFF_FLAG):
            os.remove(OFF_FLAG)
        print("voxtype-autostop: enabled")
    elif cmd == "off":
        open(OFF_FLAG, "w").close()
        print("voxtype-autostop: disabled (Super+X stops dictation as before)")
    elif cmd == "secs":
        open(SECS_FILE, "w").write(sys.argv[2])
        print("walk-away silence limit: %.0fs" % silence_secs())
    elif cmd == "word":
        open(WORD_FILE, "w").write(sys.argv[2])
        print("trigger word: %s" % trigger_word())
    elif cmd == "log":
        os.execvp("journalctl", ["journalctl", "--user", "-u", "voxtype-autostop",
                                 "-n", "60", "--no-pager", "-o", "cat"])
    elif cmd == "status":
        print("auto-stop: %s" % ("disabled" if os.path.exists(OFF_FLAG) else "enabled"))
        print("trigger:   say %s (checked %.1fs into a pause)"
              % (" / ".join(sorted(trigger_words())), CHECK_MS / 1000))
        print("walk-away: %.0fs of silence" % silence_secs())
        print("model:     %s" % ("tiny.en" if os.path.exists(MODEL) else "MISSING — word check disabled"))
        print("voxtype:   %s" % state())
    else:
        print(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
