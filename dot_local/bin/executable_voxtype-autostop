#!/usr/bin/env python3
"""voxtype-autostop — end a dictation when you say "submit".

voxtype records until something calls `voxtype record stop`, and
smart_auto_submit only presses Enter after that stop — so without this,
"submit" still needed a second Super+X. This watcher supplies the stop.

  voxtype-autostop            # daemon (hyprland exec-once)
  voxtype-autostop on|off     # enable/disable without restarting
  voxtype-autostop status     # enabled? windows? word?
  voxtype-autostop secs <n>   # walk-away silence limit (default 20)
  voxtype-autostop word <w>   # trigger word (default "submit")

How: polls voxtype's state file and, while state is "recording", reads a
parallel PipeWire capture of the mic into a rolling buffer. When you go
quiet for ~1s, it transcribes JUST the tail of that buffer with whisper
tiny.en and stops the recording only if you actually ended on the
trigger word. Thinking pauses are therefore free: a pause that isn't
followed by the word costs one cheap check and nothing else (the buffer
can't change while you're silent, so it never re-checks until you speak
again). A long silence still stops eventually, for walking away
mid-recording.

Frames are high-passed before measuring RMS: this laptop's fan sits at a
loud but low-frequency noise floor that would swamp a plain energy
threshold, while speech survives the filter. The floor is tracked
adaptively (falls fast, rises slowly).
"""

import os
import re
import subprocess
import sys
import threading
import time
import wave

import numpy as np

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
STATE_FILE = os.path.join(RUNTIME, "voxtype", "state")
STATE_DIR = os.path.expanduser("~/.local/state/voxtype-autostop")
OFF_FLAG = os.path.join(STATE_DIR, "off")
SECS_FILE = os.path.join(STATE_DIR, "silence-secs")
WORD_FILE = os.path.join(STATE_DIR, "word")
TMP_WAV = os.path.join(RUNTIME, "voxtype-autostop-tail.wav")
MODEL = os.path.expanduser("~/.local/share/voxtype/models/ggml-tiny.en.bin")

RATE = 16000
FRAME = 1600                  # 100ms
FRAME_BYTES = FRAME * 2       # s16 mono
ARM_MS = 400                  # speech needed before any stop is allowed
CHECK_MS = 1000               # silence before we listen for the word
TAIL_SEC = 4                  # how much audio the word-check transcribes
MIN_THRESHOLD = 400.0         # absolute floor for the high-passed RMS
THRESHOLD_MULT = 2.5          # speech = this much above the tracked floor
DEFAULT_SECS = 20.0           # walk-away stop
DEFAULT_WORD = "submit"
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def _read(path, default):
    try:
        v = open(path).read().strip()
        return v or default
    except OSError:
        return default


def silence_secs() -> float:
    try:
        return max(3.0, float(_read(SECS_FILE, DEFAULT_SECS)))
    except ValueError:
        return DEFAULT_SECS


def trigger_word() -> str:
    return _read(WORD_FILE, DEFAULT_WORD).lower()


def state() -> str:
    try:
        return open(STATE_FILE).read().strip()
    except OSError:
        return "unknown"


def stop_recording() -> None:
    subprocess.run(["voxtype", "record", "stop"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def tail_says_word(frames, word) -> bool:
    """Transcribe the tail of the buffer; True if it ends on the word."""
    if not os.path.exists(MODEL):
        return False
    pcm = b"".join(frames)
    try:
        with wave.open(TMP_WAV, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(RATE)
            w.writeframes(pcm)
        out = subprocess.run(
            ["voxtype", "--quiet", "--model", MODEL, "transcribe", TMP_WAV],
            capture_output=True, text=True, timeout=15,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    lines = [ANSI.sub("", ln).strip() for ln in out.splitlines()]
    lines = [ln for ln in lines if ln and not ln.startswith(("Loading", "Audio format",
                                                            "Processing", "whisper_",
                                                            "ggml_", "main:"))]
    if not lines:
        return False
    # Last few words only: "submit" mid-sentence must not end the recording.
    words = re.findall(r"[a-z']+", lines[-1].lower())
    return bool(words) and word in words[-2:]


def watch_recording() -> None:
    """One recording: stop it on the trigger word, or on a long silence."""
    cap = subprocess.Popen(
        ["pw-cat", "-r", "--raw", "--rate", str(RATE),
         "--channels", "1", "--format", "s16", "-"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    word = trigger_word()
    hard_limit = silence_secs() * 1000
    tail_frames = TAIL_SEC * 10
    buf: list = []
    floor = None
    speech_ms = silent_ms = 0
    armed = False
    checked = False              # one word-check per silence stretch
    pending = {"gen": -1, "hit": False}
    gen = 0                      # bumps on new speech; stales old checks

    def check(frames, my_gen):
        hit = tail_says_word(frames, word)
        if hit and my_gen == pending["gen"]:
            pending["hit"] = True

    try:
        while state() == "recording":
            if pending["hit"]:
                stop_recording()
                return
            raw = cap.stdout.read(FRAME_BYTES)
            if not raw or len(raw) < FRAME_BYTES:
                return
            buf.append(raw)
            del buf[:-tail_frames]

            samples = np.frombuffer(raw, dtype=np.int16).astype(np.float32)
            hp = np.diff(samples)
            rms = float(np.sqrt(np.mean(hp * hp))) if hp.size else 0.0

            if floor is None:
                floor = rms
            elif rms < floor:
                floor = 0.7 * floor + 0.3 * rms      # drop fast
            else:
                floor = 0.995 * floor + 0.005 * rms  # rise slowly

            if rms > max(floor * THRESHOLD_MULT, MIN_THRESHOLD):
                speech_ms += 100
                silent_ms = 0
                checked = False
                gen += 1
                if speech_ms >= ARM_MS:
                    armed = True
            elif armed:
                silent_ms += 100
                if silent_ms >= hard_limit:
                    stop_recording()
                    return
                if not checked and silent_ms >= CHECK_MS:
                    # One check per pause: nothing new enters the buffer
                    # while silent, so re-running it would find the same
                    # answer. Threaded so the capture keeps draining.
                    checked = True
                    pending["gen"] = gen
                    threading.Thread(target=check, args=(list(buf), gen),
                                     daemon=True).start()
    finally:
        cap.terminate()
        try:
            cap.wait(timeout=2)
        except subprocess.TimeoutExpired:
            cap.kill()


def daemon() -> int:
    os.makedirs(STATE_DIR, exist_ok=True)
    while True:
        if state() == "recording" and not os.path.exists(OFF_FLAG):
            try:
                watch_recording()
            except Exception:
                time.sleep(1)   # mic busy / pw-cat missing: never die
            while state() == "recording":
                time.sleep(0.15)
        else:
            time.sleep(0.15)


def main() -> int:
    os.makedirs(STATE_DIR, exist_ok=True)
    cmd = sys.argv[1] if len(sys.argv) > 1 else "daemon"
    if cmd == "daemon":
        return daemon()
    if cmd == "on":
        if os.path.exists(OFF_FLAG):
            os.remove(OFF_FLAG)
        print("voxtype-autostop: enabled")
    elif cmd == "off":
        open(OFF_FLAG, "w").close()
        print("voxtype-autostop: disabled (Super+X stops dictation as before)")
    elif cmd == "secs":
        open(SECS_FILE, "w").write(sys.argv[2])
        print("walk-away silence limit: %.0fs" % silence_secs())
    elif cmd == "word":
        open(WORD_FILE, "w").write(sys.argv[2])
        print("trigger word: %s" % trigger_word())
    elif cmd == "status":
        print("auto-stop: %s" % ("disabled" if os.path.exists(OFF_FLAG) else "enabled"))
        print("trigger:   say \"%s\" (checked %.1fs after you go quiet)"
              % (trigger_word(), CHECK_MS / 1000))
        print("walk-away: %.0fs of silence" % silence_secs())
        print("model:     %s" % ("tiny.en" if os.path.exists(MODEL) else "MISSING — word check disabled"))
        print("voxtype:   %s" % state())
    else:
        print(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
