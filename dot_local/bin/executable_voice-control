#!/usr/bin/env python3
"""voice-control — say "turing, workspace three" and it happens.

Tier 1: a fixed command grammar. No LLM, so nothing can hallucinate an
action — an utterance either matches the table below or is ignored.

  voice-control              # daemon (hyprland exec-once)
  voice-control on|off       # enable/disable without restarting
  voice-control status       # armed? asleep? wake word?
  voice-control test "..."   # run the matcher on text, no mic needed
  voice-control ask "..."    # full path incl. the LLM, no mic needed
  voice-control prompt       # type an instruction (Super+semicolon)
  voice-control run "..."    # execute typed text directly
  voice-control llm on|off   # enable/disable the LLM fallback
  voice-control list         # every phrase it knows

How: always-on parallel PipeWire capture (same trick voxtype-autostop
uses — several readers of one mic is fine). Frames are high-passed
before RMS, because this laptop's fan sits at a loud but low-frequency
floor that swamps a plain energy threshold. Speech opens an utterance
buffer (with pre-roll, so the first syllable survives), silence closes
it, and only then does whisper tiny.en run — so the CPU cost is per
utterance spoken near the machine, not continuous.

Every action is an argv list executed WITHOUT a shell. Adding a command
means adding a row to COMMANDS, never a string interpolated into sh.

Say "turing sleep" to stop acting on commands, "turing wake up" to
resume. `voice-control off` stops the listening itself.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import wave

import numpy as np

HOME = os.path.expanduser("~")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
STATE_DIR = os.path.join(HOME, ".local/state/voice-control")
OFF_FLAG = os.path.join(STATE_DIR, "off")
DEBUG_FLAG = os.path.join(STATE_DIR, "debug")
SLEEP_FLAG = os.path.join(STATE_DIR, "asleep")
LOG = os.path.join(STATE_DIR, "log")
TMP_WAV = os.path.join(RUNTIME, "voice-control-utterance.wav")
# voxtype resolves model NAMES from its models dir. An absolute path is
# rejected ("unknown model: <path>", visible to the user) and silently
# falls back to the configured base.en — which is what shipped, running
# the slower model AND warning on every utterance.
# base.en, not tiny.en: commands must be recognized correctly or nothing
# happens, and tiny rendered "Volume up." as "Bell you mop" over the
# speaker-to-mic path. base costs ~2s per utterance instead of ~1.15s,
# which is invisible next to the pause the VAD already waits out. (The
# dictation auto-stop keeps tiny — it only has to spot one known word.)
MODEL_NAME = "base.en"
MODEL_FILE = os.path.join(HOME, ".local/share/voxtype/models/ggml-base.en.bin")

RATE = 16000
FRAME = 1600                 # 100ms
FRAME_BYTES = FRAME * 2
PREROLL = 5                  # frames kept before speech starts (0.5s)
END_SILENCE_MS = 900         # silence that closes an utterance
WAKE_LATCH_S = 8             # after a bare wake word, listen for a command
MAX_UTTERANCE_S = 8
MIN_SPEECH_MS = 200          # ignore coughs/clicks (a lone "Turing" is short)
MIN_THRESHOLD = 400.0
THRESHOLD_MULT = 2.5

# Whisper mishears the wake word constantly — tiny.en rendered a clean
# TTS "Turing" as "Choring" — so matching is fuzzy rather than a fixed
# variant list. A near miss still has to be followed by a real command,
# so a loose gate cannot by itself cause an action.
WAKE_WORDS = ("turing", "computer")
WAKE_RATIO = 0.6        # wake word followed by a command: this acts, so
WAKE_RATIO_BARE = 0.45  # be stricter than a lone wake word, which only arms


def is_wake(word, bare=False):
    """Fuzzy because whisper mangles it — a lone "Turing." came back as
    "Dureg." Arming on a near miss costs nothing (the next utterance still
    has to be a real command), so the bare case is judged leniently."""
    import difflib
    ratio = WAKE_RATIO_BARE if bare else WAKE_RATIO
    return any(difflib.SequenceMatcher(None, word, w).ratio() >= ratio
               or word.startswith(w[:4]) for w in WAKE_WORDS)

NUMBERS = {"one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6,
           "seven": 7, "eight": 8, "nine": 9, "ten": 10, "to": 2, "too": 2,
           "for": 4, "won": 1}


def num(word):
    if word.isdigit():
        return int(word)
    return NUMBERS.get(word)


def hypr(*args):
    return ["hyprctl", "dispatch", *args]


def dms(*args):
    return ["dms", "ipc", "call", *args]


# (regex, argv-or-callable, spoken-back label). First match wins.
COMMANDS = [
    (r"^(?:go to )?workspace (\w+)$",
     lambda m: hypr("workspace", str(num(m.group(1)))) if num(m.group(1)) else None,
     "workspace"),
    (r"^next workspace$", hypr("workspace", "e+1"), "next workspace"),
    (r"^(?:previous|last) workspace$", hypr("workspace", "e-1"), "previous workspace"),
    (r"^next window$", hypr("cyclenext"), "next window"),
    (r"^(?:previous|last) window$", hypr("cyclenext", "prev"), "previous window"),
    (r"^(?:close|kill)(?: window| this)?$", hypr("killactive"), "close window"),
    (r"^(?:full ?screen|maximi[sz]e)$", hypr("fullscreen", "1"), "fullscreen"),
    (r"^float(?:ing)?$", hypr("togglefloating"), "floating"),
    (r"^(?:move|send) (?:window )?(?:to )?workspace (\w+)$",
     lambda m: hypr("movetoworkspace", str(num(m.group(1)))) if num(m.group(1)) else None,
     "move to workspace"),
    (r"^(?:open |launch )?(?:the )?browser$", ["firefox"], "browser"),
    (r"^(?:open |launch )?(?:a )?terminal$", ["ghostty"], "terminal"),
    (r"^(?:open |launch )?(?:the )?(?:files|file manager)$", ["thunar"], "files"),
    (r"^(?:open )?launcher$", dms("launcher", "toggle"), "launcher"),
    (r"^(?:open )?clipboard$", dms("clipboard", "toggle"), "clipboard"),
    (r"^(?:open )?control cent(?:er|re)$", dms("control-center", "toggle"), "control center"),
    (r"^(?:show )?notifications?$", dms("notifications", "toggle"), "notifications"),
    (r"^lock(?: (?:the )?screen)?$", [os.path.join(HOME, ".local/bin/hypr-lock")], "locking"),
    (r"^(?:random|change|new) theme$", [os.path.join(HOME, ".local/bin/theme"), "random"], "theme"),
    (r"^(?:take a )?screenshot$", [os.path.join(HOME, ".local/bin/hypr-screenshot")], "screenshot"),
    (r"^volume up$", dms("audio", "increment"), "volume up"),
    (r"^volume down$", dms("audio", "decrement"), "volume down"),
    (r"^(?:mute|unmute)(?: volume)?$", dms("audio", "mute"), "mute"),
    (r"^brightness up$", dms("brightness", "increment"), "brightness up"),
    (r"^brightness down$", dms("brightness", "decrement"), "brightness down"),
    (r"^(?:play|pause|play pause)(?: music)?$", dms("mpris", "playPause"), "play pause"),
    (r"^next (?:track|song)$", dms("mpris", "next"), "next track"),
    (r"^night mode$", dms("night", "toggle"), "night mode"),
    (r"^(?:tmux )?session (.+)$",
     lambda m: ["tmux", "switch-client", "-t", m.group(1).replace(" ", "-")],
     "session"),
]


def command_env():
    """Environment a desktop command needs.

    The daemon can be started from a shell that has no Wayland/Hyprland
    variables (systemd, a detached test shell, a stale session), and then
    every `hyprctl dispatch` dies with "HYPRLAND_INSTANCE_SIGNATURE not
    set!" — silently, if its output is discarded. Resolve the live
    instance from the runtime dir instead of trusting the inherited env.
    """
    env = dict(os.environ)
    hypr_dir = os.path.join(RUNTIME, "hypr")
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if not sig or not os.path.isdir(os.path.join(hypr_dir, sig)):
        try:
            sigs = [d for d in os.listdir(hypr_dir)
                    if os.path.isdir(os.path.join(hypr_dir, d))]
            sigs.sort(key=lambda d: os.path.getmtime(os.path.join(hypr_dir, d)),
                      reverse=True)
            if sigs:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = sigs[0]
        except OSError:
            pass
    if not env.get("WAYLAND_DISPLAY"):
        for name in sorted(os.listdir(RUNTIME)):
            if name.startswith("wayland-") and not name.endswith(".lock"):
                env["WAYLAND_DISPLAY"] = name
                break
    return env


# ---------------------------------------------------------------- Tier 2
# Anything the grammar above does not match goes to a local LLM, which
# proposes ONE typed action from the catalog below. The model never emits
# a shell command: it fills in a small JSON object, and every field is
# checked against an allowlist here before anything runs. Worst case for a
# hallucination is a rejected plan, not an arbitrary command.
LLM_FLAG = os.path.join(STATE_DIR, "llm-off")
OLLAMA = "http://localhost:11434/api/chat"
LLM_MODEL = "qwen2.5:3b"

HYPR_DISPATCH = {"workspace", "movetoworkspace", "movetoworkspacesilent",
                 "cyclenext", "killactive", "fullscreen", "togglefloating",
                 "movewindow", "focusmonitor", "movecurrentworkspacetomonitor",
                 "togglesplit", "pin", "centerwindow", "swapwindow", "focuswindow"}
DMS_TARGETS = {"audio", "bar", "brightness", "clipboard", "control-center", "dash",
               "launcher", "lock", "mpris", "night", "notifications", "notepad",
               "outputs", "inhibit", "keybinds", "hypr", "color-picker", "dock"}
APPS = {"firefox", "ghostty", "thunar", "obsidian", "discord", "slack",
        "spotify", "okular", "xournalpp", "pdfarranger", "btop"}
SCRIPT_ARGS = {                     # script -> allowed first argument
    "theme": {"random", "list", "menu", "current", "set"},
    "laptop-backup": {"status", "list", "run"},
    "net-speedtest": set(),
    "hypr-screenshot": set(),
    "hypr-ocr": set(),
    "hypr-notes": set(),
    "hypr-cheatsheet": set(),
}
# A script invoked bare can do more than asked — `laptop-backup` with no
# argument RUNS a backup, and the model dropped the "status" it meant.
# Anything whose bare form is consequential gets an explicit safe default.
SCRIPT_DEFAULTS = {"laptop-backup": ["status"], "theme": ["random"]}
GH_SECTIONS = {"actions": "/actions", "pulls": "/pulls", "issues": "/issues",
               "releases": "/releases", "code": "", "home": "", "wiki": "/wiki",
               "commits": "/commits", "settings": "/settings"}
_ctx_cache = {"at": 0.0, "data": None}


def context():
    """What the model is allowed to talk about: this machine's real repos,
    sessions and monitors. Refreshed lazily — a new repo or tmux session
    becomes speakable without touching any code."""
    if _ctx_cache["data"] and time.monotonic() - _ctx_cache["at"] < 120:
        return _ctx_cache["data"]
    repos = {}
    for parent in (os.path.join(HOME, "work"), os.path.join(HOME, "personal")):
        try:
            entries = sorted(os.listdir(parent))
        except OSError:
            continue
        for name in entries:
            d = os.path.join(parent, name)
            if not os.path.isdir(os.path.join(d, ".git")):
                continue
            try:
                url = subprocess.run(["git", "-C", d, "remote", "get-url", "origin"],
                                     capture_output=True, text=True, timeout=5).stdout.strip()
            except (OSError, subprocess.SubprocessError):
                continue
            m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", url)
            if m:
                repos[name.lower().replace("-", " ").replace("_", " ")] = m.group(1)
    try:
        sessions = subprocess.run(["tmux", "list-sessions", "-F", "#S"],
                                  capture_output=True, text=True, timeout=5).stdout.split()
    except (OSError, subprocess.SubprocessError):
        sessions = []
    try:
        mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], env=command_env(),
                                         capture_output=True, text=True, timeout=5).stdout)
        monitors = [m["name"] for m in mons]
    except Exception:
        monitors = []
    data = {"repos": repos, "sessions": sessions, "monitors": monitors}
    _ctx_cache.update(at=time.monotonic(), data=data)
    return data


def llm_plan(phrase):
    """Ask the local model for one typed action. Returns a dict or None."""
    ctx = context()
    system = (
        "You turn a spoken desktop command into ONE action on an Arch Linux "
        "laptop running Hyprland. Reply with JSON only.\n"
        "action=url: open a web page (field: url, https only). Use this for "
        "any website named by the user, e.g. reddit -> https://reddit.com\n"
        "action=gh: open a GitHub repo page (fields: repo, section one of "
        + ", ".join(sorted(GH_SECTIONS)) + ")\n"
        "action=app: launch a program (field: app, one of "
        + ", ".join(sorted(APPS)) + ")\n"
        "action=hypr: window/workspace control (fields: dispatcher one of "
        + ", ".join(sorted(HYPR_DISPATCH)) + "; arg)\n"
        "night mode means screen warmth / blue-light filter (target=night, "
        "function=toggle); brightness means backlight level.\n"
        "action=dms: desktop shell (fields: target one of "
        + ", ".join(sorted(DMS_TARGETS)) + "; function e.g. toggle, increment; arg optional)\n"
        "action=tmux: switch terminal session (field: session)\n"
        "action=script: run a helper (fields: name one of "
        + ", ".join(sorted(SCRIPT_ARGS)) + "; args)\n"
        "action=none: the request does not fit any action.\n"
        "Always add a short 'say' field describing what you did, under 8 words.\n"
        "Examples: 'open reddit' -> {\"action\":\"url\",\"url\":"
        "\"https://reddit.com\",\"say\":\"Opening Reddit\"}; "
        "'open the actions for bow mark' -> {\"action\":\"gh\",\"repo\":"
        "\"devinMcArthur/bow-mark\",\"section\":\"actions\",\"say\":"
        "\"Opening bow-mark actions\"}.\n"
        "Use the exact owner/repo from this list, never invent one: "
        + json.dumps(ctx["repos"]) + "\n"
        "Open tmux sessions: " + json.dumps(ctx["sessions"]) + "\n"
        "Monitors: " + json.dumps(ctx["monitors"])
    )
    body = {
        "model": LLM_MODEL,
        "stream": False,
        # Stay resident: a cold load costs ~24s, a warm call ~2-3s. Frees
        # itself after an idle hour; `ollama stop qwen2.5:3b` frees it now.
        "keep_alive": "1h",
        "options": {"temperature": 0},
        "format": {
            "type": "object",
            "properties": {
                "action": {"type": "string",
                           "enum": ["url", "gh", "app", "hypr", "dms", "tmux",
                                    "script", "none"]},
                "url": {"type": "string"}, "repo": {"type": "string"},
                "section": {"type": "string"}, "app": {"type": "string"},
                "dispatcher": {"type": "string"}, "arg": {"type": "string"},
                "target": {"type": "string"}, "function": {"type": "string"},
                "session": {"type": "string"}, "name": {"type": "string"},
                "args": {"type": "array", "items": {"type": "string"}},
                "say": {"type": "string"},
            },
            "required": ["action", "say"],
        },
        "messages": [{"role": "system", "content": system},
                     {"role": "user", "content": phrase}],
    }
    try:
        req = urllib.request.Request(
            OLLAMA, data=json.dumps(body).encode(),
            headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=25) as r:
            reply = json.loads(r.read().decode())
        return json.loads(reply["message"]["content"])
    except (urllib.error.URLError, OSError, ValueError, KeyError) as e:
        log("llm error: %s" % e)
        return None


def plan_to_argv(plan):
    """Validate a model plan into an argv list, or None if it fails checks."""
    if not isinstance(plan, dict):
        return None
    act = plan.get("action")
    ctx = context()
    if act == "url":
        url = str(plan.get("url", ""))
        if re.match(r"^https://[A-Za-z0-9._~:/?#\[\]@!$&'()*+,;=%%-]+$", url):
            return ["xdg-open", url]
        return None
    if act == "gh":
        repo = str(plan.get("repo", "")).strip()
        known = set(ctx["repos"].values())
        repo = ctx["repos"].get(repo.lower(), repo)
        if repo not in known:
            # The model invents owners ("bm-native/bm_native"); recover by
            # matching on the repository name alone, which it gets right.
            import difflib
            want = repo.split("/")[-1].lower().replace("-", "").replace("_", "")
            best, score = None, 0.0
            for full in known:
                name = full.split("/")[-1].lower().replace("-", "").replace("_", "")
                r = difflib.SequenceMatcher(None, want, name).ratio()
                if r > score:
                    best, score = full, r
            if score < 0.8:
                return None
            repo = best
        section = GH_SECTIONS.get(str(plan.get("section", "home")).lower())
        if section is None:
            return None
        return ["xdg-open", "https://github.com/%s%s" % (repo, section)]
    if act == "app":
        app = str(plan.get("app", "")).strip()
        if app in APPS and shutil.which(app):
            return [app]
        return None
    if act == "hypr":
        disp = str(plan.get("dispatcher", "")).strip()
        arg = str(plan.get("arg", "")).strip()
        if disp not in HYPR_DISPATCH and re.search(r"[,:]", disp):
            # Small models cram the argument into the dispatcher field
            # ("movetoworkspace,arg:4"); take it apart rather than reject.
            parts = [x for x in re.split(r"[,:]", disp) if x.strip()]
            disp = parts[0].strip()
            if not arg and len(parts) > 1:
                arg = parts[-1].strip()
        if disp not in HYPR_DISPATCH:
            return None
        if arg and not re.match(r"^[A-Za-z0-9+,:._ -]{1,40}$", arg):
            return None
        return hypr(disp, arg) if arg else hypr(disp)
    if act == "dms":
        target = str(plan.get("target", "")).strip()
        func = str(plan.get("function", "")).strip() or "toggle"
        arg = str(plan.get("arg", "")).strip()
        if target not in DMS_TARGETS or not re.match(r"^[A-Za-z]{1,24}$", func):
            return None
        argv = dms(target, func)
        if arg and re.match(r"^[A-Za-z0-9._ -]{1,40}$", arg):
            argv.append(arg)
        return argv
    if act == "tmux":
        sess = str(plan.get("session", "")).strip()
        if sess in ctx["sessions"]:
            return ["tmux", "switch-client", "-t", sess]
        return None
    if act == "script":
        name = str(plan.get("name", "")).strip()
        if name not in SCRIPT_ARGS:
            return None
        path = os.path.join(HOME, ".local/bin", name)
        if not os.path.exists(path):
            return None
        args = [str(a) for a in (plan.get("args") or [])][:2]
        if not args:
            args = list(SCRIPT_DEFAULTS.get(name, []))
        allowed = SCRIPT_ARGS[name]
        if args and (not allowed or args[0] not in allowed):
            return None
        return [path] + args
    return None


def speak(text):
    """Short spoken confirmation, independent of claude-tts so it never
    interrupts (or is interrupted by) Claude reading a reply."""
    voice = os.path.join(HOME, ".local/share/claude-tts/en_US-ryan-high.onnx")
    if not text or not os.path.exists(voice):
        return
    try:
        subprocess.Popen(
            "printf %s " + subprocess.list2cmdline([text]) +
            " | piper-tts -m " + voice + " --output_raw 2>/dev/null"
            " | pw-cat -p --raw --rate 22050 --channels 1 --format s16 - 2>/dev/null",
            shell=True, start_new_session=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def log(msg):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(LOG, "a") as f:
        f.write("%s %s\n" % (time.strftime("%H:%M:%S"), msg))
    try:
        lines = open(LOG).readlines()[-200:]
        open(LOG, "w").writelines(lines)
    except OSError:
        pass


def beep(ok=True):
    """Short tone: rising = understood, low buzz = heard but unknown."""
    freq, dur = (880.0, 0.09) if ok else (220.0, 0.16)
    t = np.arange(int(RATE * dur)) / RATE
    pcm = (np.sin(2 * np.pi * freq * t) * 6000 * np.hanning(len(t))).astype(np.int16)
    try:
        p = subprocess.Popen(
            ["pw-cat", "-p", "--raw", "--rate", str(RATE), "--channels", "1",
             "--format", "s16", "-"],
            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        p.stdin.write(pcm.tobytes())
        p.stdin.close()
    except OSError:
        pass


def muzzled():
    """True when the mic must be ignored outright: voxtype is dictating,
    and those words are meant for the cursor, not for us.

    Claude speaking is NOT muzzled any more. Deafness during a reply made
    voice commands unusable for the 30-60s it takes to read a long one —
    exactly when you most want to interrupt. Its speech is filtered by
    CONTENT instead, see is_own_echo().
    """
    try:
        st = open(os.path.join(RUNTIME, "voxtype", "state")).read().strip()
        return st in ("recording", "transcribing")
    except OSError:
        return False


def is_own_echo(text):
    """Did the mic just hear Claude reading its own reply?

    claude-tts publishes the text it is speaking, so the check is on
    content rather than on timing: the machine's own name appears in
    replies constantly, and a wake word is a wake word whoever says it.
    """
    try:
        spoken = open(os.path.join(HOME, ".local/state/claude-tts/speaking")).read()
    except OSError:
        return False
    if not spoken.strip():
        return False
    import difflib
    heard = re.sub(r"[^a-z0-9 ]+", " ", text.lower())
    heard = re.sub(r"\s+", " ", heard).strip()
    said = re.sub(r"[^a-z0-9 ]+", " ", spoken.lower())
    said = re.sub(r"\s+", " ", said).strip()
    if len(heard) < 4:
        return True             # a fragment heard mid-reply: not a command
    if heard in said:
        return True
    # Whisper garbles what it hears through the speakers, so exact
    # containment is not enough — compare against the closest window.
    best = 0.0
    words = said.split()
    span = max(4, len(heard.split()))
    for i in range(0, max(1, len(words) - span + 1)):
        window = " ".join(words[i:i + span])
        best = max(best, difflib.SequenceMatcher(None, heard, window).ratio())
    return best >= 0.6


def normalize(text):
    text = text.lower().strip()
    text = re.sub(r"[^a-z0-9 ]+", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def match(phrase):
    """Return (argv, label) for a command phrase, or (None, None)."""
    for pattern, action, label in COMMANDS:
        m = re.match(pattern, phrase)
        if not m:
            continue
        argv = action(m) if callable(action) else action
        if argv:
            return argv, label
    return None, None


def run_command(phrase, feedback="beep"):
    # Sleep/wake are handled here so they work while asleep.
    if re.match(r"^(?:go to )?sleep$|^stop listening$", phrase):
        open(SLEEP_FLAG, "w").close()
        log("asleep")
        tell(feedback, False, "Sleeping")
        return True
    if re.match(r"^wake up$|^start listening$|^wake$", phrase):
        if os.path.exists(SLEEP_FLAG):
            os.remove(SLEEP_FLAG)
        log("awake")
        tell(feedback, True, "Listening")
        return True
    if os.path.exists(SLEEP_FLAG):
        return False

    argv, label = match(phrase)
    spoken = ""
    # The model will map ANY utterance onto something in its catalog —
    # "run sudo rm -rf" came back as a screenshot. The catalog is
    # non-destructive by construction, so the blast radius is a surprising
    # action rather than a dangerous one, but destructive-sounding speech
    # should not reach it at all.
    if re.search(r"\b(sudo|rm|delete|erase|format|wipe|kill everything|"
                 r"shutdown|reboot|uninstall|drop database)\b", phrase):
        log("refused (destructive wording): %r" % phrase)
        tell(feedback, False, "Refused: %s" % phrase)
        return False
    if not argv and not os.path.exists(LLM_FLAG):
        plan = llm_plan(phrase)
        if plan:
            argv = plan_to_argv(plan)
            spoken = str(plan.get("say", ""))[:80]
            log("llm: %r -> %s%s" % (phrase, json.dumps(plan),
                                     "" if argv else "  [REJECTED]"))
    if not argv:
        log("unknown: %r" % phrase)
        tell(feedback, False, "No action for: %s" % phrase)
        return False
    log("run: %r -> %s" % (phrase, " ".join(argv)))
    # Commanding mid-reply is an interruption: stop the reading.
    subprocess.Popen([os.path.join(HOME, ".local/bin/claude-tts"), "stop"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    cls = focus_hint(argv)
    if cls:
        focus_window(cls)
    tell(feedback, True, spoken or " ".join(argv[:3]))
    if feedback == "beep" and spoken:
        speak(spoken)
    try:
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True,
                                start_new_session=True, env=command_env())
    except OSError as e:
        log("failed to start: %s" % e)
        tell(feedback, False, "Failed to start: %s" % argv[0])
        return False
    # Catch an immediate failure (bad env, missing binary) without waiting
    # on commands that are supposed to keep running, like a browser.
    try:
        out = proc.communicate(timeout=1.5)[0]
        if proc.returncode != 0:
            log("FAILED rc=%d: %s" % (proc.returncode, (out or "").strip()[:150]))
            tell(feedback, False, "Command failed: %s" % argv[0])
            return False
    except subprocess.TimeoutExpired:
        pass
    return True


# Acting on a window you cannot see is half an action: after a command
# that targets an app, focus its window — Hyprland's focuswindow follows
# the window to its workspace, so this switches workspace when needed.
WINDOW_CLASS = {
    "firefox": "firefox", "ghostty": "com.mitchellh.ghostty",
    "thunar": "thunar", "obsidian": "obsidian", "discord": "discord",
    "slack": "Slack", "spotify": "Spotify", "okular": "okular",
    "xournalpp": "xournalpp", "pdfarranger": "pdfarranger",
}


def focus_hint(argv):
    """Which window class, if any, this command's result lives in."""
    prog = os.path.basename(argv[0])
    if prog == "xdg-open" and len(argv) > 1 and argv[1].startswith("http"):
        return WINDOW_CLASS["firefox"]          # url/gh actions land in the browser
    if prog == "tmux":
        return WINDOW_CLASS["ghostty"]          # the session lives in a terminal
    return WINDOW_CLASS.get(prog)


def focus_window(cls):
    """Focus in a DETACHED process, twice: an app already running focuses
    at once, a freshly launched one needs its window to exist first.

    Not a thread — the typed path (`prompt`, `run`) exits as soon as the
    command is launched, and a daemon thread dies with the interpreter,
    so the focus silently never happened. It only appeared to work from
    a long-running daemon, or by luck when the parent lingered."""
    sel = "class:(?i)%s" % re.escape(cls)
    # The selector is passed as an ARGUMENT, never interpolated into the
    # script: list2cmdline quotes for Windows, so "(?i)" reached bash bare
    # and died with a syntax error — silently, output being discarded.
    subprocess.Popen(
        ["bash", "-c",
         'sleep 0.7; hyprctl dispatch focuswindow "$1";'
         ' sleep 1.8; hyprctl dispatch focuswindow "$1"',
         "focus", sel],
        env=command_env(), start_new_session=True,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def tell(channel, ok, message):
    """Confirm an outcome. Voice commands get a tone (you are not looking
    at the screen); typed commands get a notification (you are)."""
    if channel == "beep":
        beep(ok)
    elif channel == "notify":
        subprocess.Popen(
            ["notify-send", "-a", "Voice control", "-t", "3000",
             "-u", "normal" if ok else "critical",
             "Command" if ok else "No action", message],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def prompt():
    """Type an instruction instead of speaking it — same grammar, same
    model, same allowlist. wofi is already themed by `theme set`, so the
    box matches the desktop; yad is the fallback."""
    try:
        if shutil.which("wofi"):
            out = subprocess.run(
                ["wofi", "--dmenu", "--prompt", "command", "--lines", "1",
                 "--width", "520", "--height", "72", "--cache-file", "/dev/null"],
                input="", capture_output=True, text=True).stdout
        else:
            out = subprocess.run(["yad", "--entry", "--title", "Command",
                                  "--entry-label", "Do:"],
                                 capture_output=True, text=True).stdout
    except (OSError, subprocess.SubprocessError) as e:
        log("prompt failed: %s" % e)
        return 1
    phrase = normalize(out)
    if not phrase:
        return 0
    log("typed: %r" % phrase)
    run_command(phrase, feedback="notify")
    return 0


def transcribe(frames):
    if not os.path.exists(MODEL_FILE):
        return ""
    try:
        with wave.open(TMP_WAV, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(RATE)
            w.writeframes(b"".join(frames))
        out = subprocess.run(["voxtype", "--quiet", "--model", MODEL_NAME,
                              "transcribe", TMP_WAV],
                             capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    ansi = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
    lines = [ansi.sub("", l).strip() for l in out.splitlines()]
    lines = [l for l in lines
             if l and not l.startswith(("Loading", "Audio format", "Processing",
                                        "whisper_", "ggml_", "main:"))]
    return lines[-1] if lines else ""


_latch = [0.0]   # monotonic time until which a bare command is accepted


def handle_utterance(frames):
    debug = os.path.exists(DEBUG_FLAG)
    raw = transcribe(frames)
    if not raw:
        if debug:
            log("debug: utterance transcribed to nothing (%d frames)" % len(frames))
        return
    phrase = normalize(raw)
    words = phrase.split()
    if debug:
        log("debug: heard %r" % raw)
    if is_own_echo(phrase):
        if debug:
            log("debug: ignored (Claude's own speech)")
        return
    if not words:
        return
    # Wake word must open the utterance ("hey turing ..." allowed).
    if words[0] == "hey" and len(words) > 1:
        words = words[1:]
    if is_wake(words[0], bare=(len(words) == 1)):
        command = " ".join(words[1:]).strip()
        if not command:
            # Bare wake word: people pause after it ("Turing... volume up"),
            # and that pause closes the utterance. Stay armed briefly so the
            # next thing said counts as the command.
            _latch[0] = time.monotonic() + WAKE_LATCH_S
            log("armed (wake word alone) — say the command")
            beep(True)
            return
    elif time.monotonic() < _latch[0]:
        command = phrase            # armed by a bare wake word just now
        _latch[0] = 0.0
    else:
        if debug:
            log("debug: no wake word in %r (first word %r)" % (raw, words[0]))
        return
    log("heard: %r" % raw)
    run_command(command)


def daemon():
    os.makedirs(STATE_DIR, exist_ok=True)
    while True:
        if os.path.exists(OFF_FLAG):
            time.sleep(1)
            continue
        cap = subprocess.Popen(
            ["pw-cat", "-r", "--raw", "--rate", str(RATE), "--channels", "1",
             "--format", "s16", "-"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        floor = None
        pre, utter = [], []
        speech_ms = silent_ms = 0
        capturing = False
        try:
            while not os.path.exists(OFF_FLAG):
                raw = cap.stdout.read(FRAME_BYTES)
                if not raw or len(raw) < FRAME_BYTES:
                    break
                samples = np.frombuffer(raw, dtype=np.int16).astype(np.float32)
                hp = np.diff(samples)
                rms = float(np.sqrt(np.mean(hp * hp))) if hp.size else 0.0
                if floor is None:
                    floor = rms
                elif rms < floor:
                    floor = 0.7 * floor + 0.3 * rms
                else:
                    floor = 0.995 * floor + 0.005 * rms

                if muzzled():
                    capturing = False
                    pre, utter = [], []
                    continue
                loud = rms > max(floor * THRESHOLD_MULT, MIN_THRESHOLD)
                if not capturing:
                    pre.append(raw)
                    del pre[:-PREROLL]
                    if loud:
                        capturing = True
                        utter = list(pre) + [raw]
                        speech_ms, silent_ms = 100, 0
                else:
                    utter.append(raw)
                    if loud:
                        speech_ms += 100
                        silent_ms = 0
                    else:
                        silent_ms += 100
                    too_long = len(utter) * 100 >= MAX_UTTERANCE_S * 1000
                    if silent_ms >= END_SILENCE_MS or too_long:
                        # Discard rather than transcribe: cheaper, and it
                        # cannot act on our own voice or your dictation.
                        if speech_ms >= MIN_SPEECH_MS and not muzzled():
                            handle_utterance(utter)
                        elif os.path.exists(DEBUG_FLAG) and speech_ms:
                            log("debug: dropped %dms utterance (min %d, muzzled=%s)"
                                % (speech_ms, MIN_SPEECH_MS, muzzled()))
                        capturing = False
                        pre, utter = [], []
        except Exception as e:      # never die on a transient mic error
            log("error: %s" % e)
            time.sleep(1)
        finally:
            cap.terminate()
            try:
                cap.wait(timeout=2)
            except subprocess.TimeoutExpired:
                cap.kill()


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    cmd = sys.argv[1] if len(sys.argv) > 1 else "daemon"
    if cmd == "daemon":
        return daemon()
    if cmd == "on":
        for f in (OFF_FLAG, SLEEP_FLAG):
            if os.path.exists(f):
                os.remove(f)
        print("voice-control: listening")
    elif cmd == "off":
        open(OFF_FLAG, "w").close()
        print("voice-control: off")
    elif cmd == "status":
        print("listening: %s" % ("no (off)" if os.path.exists(OFF_FLAG) else "yes"))
        print("asleep:    %s" % ("yes" if os.path.exists(SLEEP_FLAG) else "no"))
        print("wake word: %s (fuzzy)" % " / ".join(WAKE_WORDS))
        print("model:     %s" % (MODEL_NAME if os.path.exists(MODEL_FILE) else "MISSING"))
    elif cmd == "prompt":
        return prompt()
    elif cmd == "run":
        return 0 if run_command(normalize(" ".join(sys.argv[2:])),
                                feedback="notify") else 1
    elif cmd == "ask":
        # Same path a spoken command takes, minus the microphone.
        phrase = normalize(" ".join(sys.argv[2:]))
        argv, _ = match(phrase)
        if argv:
            print("grammar: %s" % " ".join(argv))
            return 0
        plan = llm_plan(phrase)
        print("plan:    %s" % json.dumps(plan))
        argv = plan_to_argv(plan) if plan else None
        print("action:  %s" % (" ".join(argv) if argv else "(rejected)"))
    elif cmd == "llm":
        if len(sys.argv) > 2 and sys.argv[2] == "off":
            open(LLM_FLAG, "w").close()
            print("llm fallback off (grammar only)")
        else:
            if os.path.exists(LLM_FLAG):
                os.remove(LLM_FLAG)
            print("llm fallback on (%s)" % LLM_MODEL)
    elif cmd == "debug":
        on = len(sys.argv) < 3 or sys.argv[2] != "off"
        if on:
            open(DEBUG_FLAG, "w").close()
            print("debug logging ON — logs EVERY utterance heard near the mic")
        else:
            if os.path.exists(DEBUG_FLAG):
                os.remove(DEBUG_FLAG)
            print("debug logging off")
    elif cmd == "test":
        phrase = normalize(" ".join(sys.argv[2:]))
        argv, label = match(phrase)
        print("phrase: %r" % phrase)
        print("match:  %s" % (" ".join(argv) if argv else "(none)"))
    elif cmd == "list":
        for pattern, _, label in COMMANDS:
            print("  %-28s %s" % (label, pattern))
        print("  %-28s %s" % ("sleep / wake up", "stop or resume acting"))
    else:
        print(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
