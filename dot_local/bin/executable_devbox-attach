#!/usr/bin/env bash
# devbox-attach — make this pane a viewport onto an agent running on the
# dev box. Used by devbox-workspace; rarely run by hand.
#
#   devbox-attach <name> [cmd...]   # default cmd: claude in ~/work/bow-mark
#
# The agent lives in a dtach session on the box, so it survives this
# laptop: close the pane, lose Wi-Fi, reboot — the agent keeps working
# and the next attach picks it up mid-thought.
#
# Three transport choices, all load-bearing:
#
#   ssh, not mosh   mosh manages the window title itself, and herdr reads
#                   agent state out of the terminal title and screen. An
#                   OSC title set on the far side arrives intact over ssh
#                   and never arrives over mosh (measured). mosh's value
#                   was keeping the session alive; dtach does that now.
#
#   dtach, not tmux/herdr  dtach does no terminal emulation — bytes pass
#                   through untouched, so the local herdr still sees the
#                   agent and reports idle/working/blocked. Through
#                   `herdr agent attach` the pane renders but arrives
#                   with no title at all: agent_status stays "unknown"
#                   and the sidebar goes blind, which defeats the point.
#
#   -n then -a, not -A     `dtach -A` did not survive the client being
#                   hung up here — the socket was gone afterwards, taking
#                   the agent with it. Creating the session detached
#                   first and attaching separately does survive.

set -uo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/devbox/host"
SESSDIR=".herdr-agents"
REMOTE_CWD="/home/dev/work/bow-mark"
REMOTE_CLAUDE="/home/dev/.local/bin/claude"

name="${1:-}"; shift || true
host="$(tr -d '[:space:]' < "$CONF" 2>/dev/null)"
[ -n "$name" ] || { echo "usage: devbox-attach <name> [command...]" >&2; exit 2; }
[ -n "$host" ] || { echo "no dev box set: devbox host user@address" >&2; exit 1; }

cmd="${*:-$REMOTE_CLAUDE}"
# The box-side half does the real work (see herdr-agent-session).
REMOTE_RUNNER="/home/dev/.local/bin/herdr-agent-session"

# The box has no xterm-ghostty terminfo. herdr panes are xterm-256color
# already, but a pane opened straight from Ghostty would not be.
export TERM=xterm-256color

fails=0
while [ "$fails" -lt 5 ]; do
  ssh -tt -o ConnectTimeout=10 -o ServerAliveInterval=20 "$host" \
    "$REMOTE_RUNNER $name $cmd"
  rc=$?
  # 0 is a deliberate detach (ctrl-\ ) — the agent stays up; stop here.
  [ "$rc" -eq 0 ] && break
  fails=$((fails + 1))
  echo "connection lost (rc=$rc) — the agent is still running on the box."
  echo "reattaching in 3s (${fails}/5), Ctrl-C to stop"
  sleep 3
done

# Never leave a dead pane.
echo "detached from '$name' on $host — the agent keeps running there."
exec "$SHELL"
