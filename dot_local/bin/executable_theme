#!/usr/bin/env bash
# theme — Omarchy-style theme switcher over chezmoi template data.
#
#   theme list           # available themes (from <chezmoi>/themes/*.yaml)
#   theme current        # the active theme
#   theme set <name>     # switch: copy palette -> .chezmoidata/theme.yaml,
#                        # chezmoi apply, reload the running desktop
#   theme menu           # carousel picker (bound to Super+Ctrl+Shift+Space)
#   theme random         # random theme != current (unlock/boot hook)
#   theme random on|off  # enable/disable the unlock/boot surprises
#
# What reloads live: Hyprland borders/gaps, wallpaper, waybar, wofi (next
# open), swaync, tmux statusline (all sessions), starship (next prompt),
# fzf/zsh (new shells), Firefox chrome (Pywalfox). What needs a restart:
# ghostty windows (Ctrl+Shift+, reloads one in place), nvim, btop, lazygit.
# The login screen deliberately stays Catppuccin Mocha (boot theming needs
# sudo; a theme switch shouldn't).

set -euo pipefail

SRC="$HOME/.local/share/chezmoi"
ACTIVE="$SRC/.chezmoidata/theme.yaml"
# Switches land in a GITIGNORED override that chezmoi merges over the
# tracked default (zz- sorts last; last file wins per key) — so daily theme
# churn (especially `theme random` on every unlock) never dirties git.
# Fresh machines fall back to the committed theme.yaml until first switch.
OVERRIDE="$SRC/.chezmoidata/zz-theme-override.yaml"

active_file() { if [ -f "$OVERRIDE" ]; then echo "$OVERRIDE"; else echo "$ACTIVE"; fi; }
current() { sed -n 's/^  name: "\([^"]*\)".*$/\1/p' "$(active_file)" | head -1; }

case "${1:-}" in
  list)
    cur="$(current)"
    for f in "$SRC"/themes/*.yaml; do
      name="$(basename "$f" .yaml)"
      if [ "$name" = "$cur" ]; then echo "* $name"; else echo "  $name"; fi
    done
    ;;
  current)
    current
    ;;
  random)
    # Random theme (never the current one). Fired by hypr-lock after every
    # unlock and by an exec-once at session start. `theme random off`
    # disables the surprises; `theme random on` re-enables.
    offflag="$HOME/.local/state/theme-random.off"
    case "${2:-}" in
      on)  rm -f "$offflag"; echo "random-on-unlock: enabled"; exit 0 ;;
      off) mkdir -p "${offflag%/*}"; touch "$offflag"; echo "random-on-unlock: disabled"; exit 0 ;;
    esac
    if [ -e "$offflag" ]; then
      echo "random mode disabled (enable with: theme random on)"
      exit 0
    fi
    pick="$(for f in "$SRC"/themes/*.yaml; do basename "$f" .yaml; done \
      | grep -vx "$(current)" | shuf -n 1)"
    [ -n "$pick" ] || exit 0
    exec "$0" set "$pick"
    ;;
  menu)
    # Visual picker: chrome-less carousel (theme-carousel, GTK4 layer-shell
    # overlay — transparent, sliding transitions) over desktop-mockup cards
    # rendered by theme-cards. Falls back to a yad image list if the
    # carousel can't start (exit 3: missing typelib, no display).
    cache="$HOME/.cache/theme-previews"
    "$HOME/.local/bin/theme-cards" >/dev/null
    cur="$(current)"
    args=(--current "$cur")
    for f in "$SRC"/themes/*.yaml; do
      name="$(basename "$f" .yaml)"
      args+=("$name" "$cache/card-$name.png")
    done
    rc=0
    sel="$("$HOME/.local/bin/theme-carousel" "${args[@]}")" || rc=$?
    if [ "$rc" -eq 3 ]; then
      # Fallback: yad image list (small strip previews from theme-cards).
      yargs=()
      for f in "$SRC"/themes/*.yaml; do
        name="$(basename "$f" .yaml)"
        # Non-empty placeholder: yad shifts row cells when a value is "".
        mark=" "
        if [ "$name" = "$cur" ]; then mark="◀ current"; fi
        yargs+=("$cache/$name.png" "$name" "$mark")
      done
      GTK_THEME="$(ls /usr/share/themes 2>/dev/null | grep -im1 'catppuccin.*mocha' || echo Adwaita-dark)"
      export GTK_THEME
      sel="$(yad --list --name=theme.picker --title=Theme \
        --no-headers --no-buttons --borders=8 \
        --width=520 --height=780 \
        --column=:IMG --column=Theme --column=Note \
        --print-column=2 --separator='' \
        "${yargs[@]}")" || exit 0
    elif [ "$rc" -ne 0 ]; then
      exit 0   # cancelled
    fi
    [ -n "$sel" ] || exit 0
    exec "$0" set "$sel"
    ;;
  set)
    name="${2:?usage: theme set <name>  (see: theme list)}"
    f="$SRC/themes/$name.yaml"
    if [ ! -f "$f" ]; then
      echo "unknown theme: $name" >&2
      "$0" list >&2
      exit 1
    fi
    # One switch at a time. Boot, unlock and a manual pick can overlap, and
    # two interleaved switches leave the colours from one theme and the
    # wallpaper from the other: each writes the override, but whichever
    # reaches the wallpaper step last wins it independently of the colours.
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/theme.lock"
    flock -w 90 9 || { logger -t theme "lock timeout; skipping switch to $name"; exit 1; }
    cp "$f" "$OVERRIDE"
    echo "==> Applying $name..."
    # stdin from /dev/null, ALWAYS. This runs unattended — from Hyprland's
    # exec-once at boot and from the unlock hook — and there it inherits
    # /dev/tty1, the virtual console nobody is looking at. chezmoi will
    # happily prompt on it: `stdinIsATTY` in .chezmoi.toml.tmpl is true for
    # tty1, and any file edited outside chezmoi asks "changed since chezmoi
    # last wrote it?". Either blocks forever WHILE HOLDING the persistent
    # state lock, so every later switch dies with "timeout obtaining
    # persistent state lock" — and since the override is written above
    # before this line, `theme current` then reports a theme you are not
    # looking at. That is exactly how theming froze on 2026-08-28: a
    # boot-time `theme random` sat on tty1 for 13 minutes. With no tty,
    # prompts are skipped or fail loudly, and set -e makes it visible.
    #
    # A failure is logged, not fatal. Files are written before chezmoi runs
    # its after-scripts, so when a run_onchange script refuses headless sudo
    # (correctly: it needs `chezmoi apply` in a terminal) the theme files are
    # already in place. Aborting there skipped the reload and wallpaper
    # steps below and left exactly the colours/wallpaper mismatch this
    # script now works to prevent.
    #
    # --no-tty as well: /dev/null on stdin is NOT enough. chezmoi opens
    # /dev/tty itself for its "changed since chezmoi last wrote it?" prompt,
    # and from Hyprland that is still tty1. On 2026-11-04 an installer's
    # line appended to ~/.zshrc parked every switch there (the theme simply
    # never changed, nothing logged). And notify: a log line alone went
    # unseen while the colours stayed wrong.
    if ! chezmoi apply --no-tty < /dev/null; then
      logger -t theme "$name: chezmoi apply failed; theme files applied, continuing (run 'chezmoi apply' in a terminal)"
      notify-send -a Theme "Theme: chezmoi apply failed" \
        "Run 'chezmoi apply' in a terminal: a file was edited outside chezmoi, or a script needs sudo." 2>/dev/null || true
    fi

    echo "==> Reloading desktop..."
    hyprctl reload >/dev/null 2>&1 || true
    # Wallpaper: DMS owns it (hyprpaper retired — two background layers
    # raced, and DMS's default wallpaper surfaced whenever its layer was
    # recreated). The colours need no help — DMS watches dank-theme.json —
    # but the wallpaper is an IPC call, and until 2026-10-22 a failed call
    # was swallowed: the theme changed and the wallpaper silently didn't.
    # Two ways it failed:
    #   - DMS detection was `pgrep -f quickshell`. DMS 1.6 (2026-10-19) runs
    #     `qs -p /run/user/…/danklinux-shell/…`, which never matches, so
    #     every switch took the hyprpaper branch: no DMS call at all, and a
    #     hidden hyprpaper started behind DMS's layer.
    #   - At boot DMS may not answer yet, and it restores its own saved
    #     wallpaper while starting. A fixed `sleep 3` raced both.
    # So: ask DMS, read the answer back, and keep at it until it holds for
    # two consecutive checks (or 30s pass). Instant once DMS is up.
    wall="$HOME/Pictures/wallpapers/$(sed -n 's/^  wallpaper: "\([^"]*\)".*$/\1/p' "$(active_file)" | head -1)"
    if [ ! -f "$wall" ]; then
      logger -t theme "$name: wallpaper missing: $wall"
    elif command -v dms >/dev/null 2>&1; then
      killall -q hyprpaper 2>/dev/null || true
      held=0
      for _ in $(seq 60); do
        if [ "$(timeout 3 dms ipc call wallpaper get 2>/dev/null)" = "$wall" ]; then
          held=$((held + 1))
          [ "$held" -ge 2 ] && break
        else
          held=0
          timeout 3 dms ipc call wallpaper set "$wall" >/dev/null 2>&1 || true
        fi
        sleep 0.5
      done
      [ "$held" -ge 2 ] || logger -t theme "$name: DMS never took the wallpaper ($wall)"
    else
      killall -q hyprpaper 2>/dev/null || true
      hyprctl dispatch exec hyprpaper >/dev/null 2>&1 || true
    fi

    # The status LED on the side of the laptop takes the theme's accent —
    # the one part of this machine with real colour, since the keyboard is
    # a single white zone. Silent when the udev rule is not in place or the
    # hardware has none: a theme switch must not fail over a light.
    "$HOME/.local/bin/theme-led" >/dev/null 2>&1 || true
    # Bar + notifications — only when the waybar federation is actually
    # running (under DMS the shell re-themes itself reactively
    # off the re-rendered dank-theme.json; restarting waybar would start a
    # second bar).
    if pgrep -x waybar >/dev/null 2>&1; then
      killall -q waybar 2>/dev/null || true
      hyprctl dispatch exec waybar >/dev/null 2>&1 || true
    fi
    # Guard on the daemon actually running: with swaync retired (DMS),
    # swaync-client blocks FOREVER on the D-Bus name — which hung every
    # theme switch here and starved the tmux/ghostty reloads below.
    if pgrep -x swaync >/dev/null 2>&1; then
      timeout 5 swaync-client -rs >/dev/null 2>&1 || true
    fi
    # tmux statusline for every running session.
    tmux source-file ~/.tmux.conf 2>/dev/null || true
    # ghostty (>=1.2) reloads config on SIGUSR2 — the ONLY safe signal
    # (anything else crashes it). Re-themes every open terminal in place.
    pkill -USR2 -x ghostty 2>/dev/null || true
    # herdr (agent multiplexer). Its config is a chezmoi template like
    # dank-theme.json; reload-config makes the running server pick up the
    # server half. Guarded on the server actually running — the CLI would
    # otherwise try to start one.
    if pgrep -x herdr >/dev/null 2>&1 && command -v herdr >/dev/null 2>&1; then
      timeout 5 herdr server reload-config >/dev/null 2>&1 || true
    fi
    # The COLOURS are not the server's: since 0.9.0 each client draws its
    # own UI from its own config, and nothing but the in-app menu reloads a
    # client's config — so until 2026-11-04 herdr kept whatever theme it
    # was started with. Now herdr's theme is "terminal" (ghostty's palette)
    # and SIGWINCH makes a client (>=0.9.2) re-query that palette. A second
    # later, so ghostty has applied its SIGUSR2 reload first. Clients only:
    # the server is the herdr whose argv[1] is "server".
    (
      sleep 1
      for pid in $(pgrep -x herdr); do
        [ "$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | sed -n 2p)" = server ] && continue
        kill -WINCH "$pid" 2>/dev/null || true
      done
    ) >/dev/null 2>&1 &
    # Firefox chrome (tabs/toolbar/URL bar): the Pywalfox extension
    # refetches ~/.cache/wal/colors.json (just re-rendered by chezmoi from
    # the theme tokens). The daemon only exists while Firefox runs — a
    # dead-socket connect fails fast, but timeout-guard anyway (swaync
    # lesson above: never let a reload step block the rest).
    if command -v pywalfox >/dev/null 2>&1; then
      timeout 5 pywalfox update >/dev/null 2>&1 || true
    fi

    echo "==> Theme: $name"
    echo "    Live now: borders, wallpaper, bar, notifications, tmux, next prompt."
    echo "    Per-window: Ctrl+Shift+, reloads a ghostty; nvim/btop/lazygit on relaunch."
    ;;
  *)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
