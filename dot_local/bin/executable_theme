#!/usr/bin/env bash
# theme — Omarchy-style theme switcher over chezmoi template data.
#
#   theme list           # available themes (from <chezmoi>/themes/*.yaml)
#   theme current        # the active theme
#   theme set <name>     # switch: copy palette -> .chezmoidata/theme.yaml,
#                        # chezmoi apply, reload the running desktop
#   theme menu           # wofi picker (bound to Super+Ctrl+Shift+Space)
#
# What reloads live: Hyprland borders/gaps, wallpaper, waybar, wofi (next
# open), swaync, tmux statusline (all sessions), starship (next prompt),
# fzf/zsh (new shells). What needs a restart: ghostty windows (Ctrl+Shift+,
# reloads one in place), nvim, btop, lazygit. The login screen deliberately
# stays Catppuccin Mocha (boot theming needs sudo; a theme switch shouldn't).

set -euo pipefail

SRC="$HOME/.local/share/chezmoi"
ACTIVE="$SRC/.chezmoidata/theme.yaml"

current() { sed -n 's/^  name: "\(.*\)"/\1/p' "$ACTIVE" | head -1; }

case "${1:-}" in
  list)
    cur="$(current)"
    for f in "$SRC"/themes/*.yaml; do
      name="$(basename "$f" .yaml)"
      if [ "$name" = "$cur" ]; then echo "* $name"; else echo "  $name"; fi
    done
    ;;
  current)
    current
    ;;
  menu)
    # Visual picker: yad image-list with a preview card per theme
    # (wallpaper crop + palette strip, PIL-generated, mtime-cached).
    # wofi's img: dmenu thumbnails don't render — see cliphist-menu — and
    # yad is already a dependency (calendar flyout).
    cache="$HOME/.cache/theme-previews"
    mkdir -p "$cache"
    python3 - "$SRC/themes" "$cache" "$HOME/Pictures/wallpapers" <<'PY'
import os, re, sys
from PIL import Image, ImageDraw

themes_dir, cache, walls = sys.argv[1:4]
W, H, S = 300, 130, 34   # card width, wallpaper height, swatch strip height
SWATCHES = ["base", "surface0", "red", "peach", "yellow", "green", "blue", "mauve"]

for f in sorted(os.listdir(themes_dir)):
    if not f.endswith(".yaml"):
        continue
    name = f[:-5]
    ypath = os.path.join(themes_dir, f)
    out = os.path.join(cache, name + ".png")
    if os.path.exists(out) and os.path.getmtime(out) >= os.path.getmtime(ypath):
        continue
    txt = open(ypath).read()
    colors = dict(re.findall(r'^\s+(\w+): "([0-9a-fA-F]{6})"', txt, re.M))
    wall = re.search(r'wallpaper: "(.+?)"', txt).group(1)

    img = Image.open(os.path.join(walls, wall)).convert("RGB")
    scale = max(W / img.width, H / img.height)
    img = img.resize((round(img.width * scale), round(img.height * scale)))
    left, top = (img.width - W) // 2, (img.height - H) // 2
    img = img.crop((left, top, left + W, top + H))

    card = Image.new("RGB", (W, H + S), "#" + colors.get("base", "000000"))
    card.paste(img, (0, 0))
    draw = ImageDraw.Draw(card)
    w = W / len(SWATCHES)
    for i, key in enumerate(SWATCHES):
        draw.rectangle([i * w, H, (i + 1) * w, H + S], fill="#" + colors.get(key, "888888"))
    card.save(out)
PY
    cur="$(current)"
    args=()
    for f in "$SRC"/themes/*.yaml; do
      name="$(basename "$f" .yaml)"
      # Non-empty placeholder: yad shifts row cells when a value is "".
      mark=" "
      if [ "$name" = "$cur" ]; then mark="◀ current"; fi
      args+=("$cache/$name.png" "$name" "$mark")
    done
    # Double-click (or Enter) picks; Esc cancels. --name sets the Wayland
    # app-id so the hyprland float rule matches (yad ignores --class).
    # GTK theme matched to the desktop, same as the calendar flyout.
    GTK_THEME="$(ls /usr/share/themes 2>/dev/null | grep -im1 'catppuccin.*mocha' || echo Adwaita-dark)"
    export GTK_THEME
    sel="$(yad --list --name=theme.picker --title=Theme \
      --no-headers --no-buttons --borders=8 \
      --width=520 --height=780 \
      --column=:IMG --column=Theme --column=Note \
      --print-column=2 --separator='' \
      "${args[@]}")" || exit 0
    [ -n "$sel" ] || exit 0
    exec "$0" set "$sel"
    ;;
  set)
    name="${2:?usage: theme set <name>  (see: theme list)}"
    f="$SRC/themes/$name.yaml"
    if [ ! -f "$f" ]; then
      echo "unknown theme: $name" >&2
      "$0" list >&2
      exit 1
    fi
    cp "$f" "$ACTIVE"
    echo "==> Applying $name..."
    chezmoi apply

    echo "==> Reloading desktop..."
    hyprctl reload >/dev/null 2>&1 || true
    # Wallpaper: hyprpaper reads its config at startup only.
    killall -q hyprpaper 2>/dev/null || true
    hyprctl dispatch exec hyprpaper >/dev/null 2>&1 || true
    # Bar + notifications.
    killall -q waybar 2>/dev/null || true
    hyprctl dispatch exec waybar >/dev/null 2>&1 || true
    swaync-client -rs >/dev/null 2>&1 || true
    # tmux statusline for every running session.
    tmux source-file ~/.tmux.conf 2>/dev/null || true
    # ghostty (>=1.2) reloads config on SIGUSR2 — the ONLY safe signal
    # (anything else crashes it). Re-themes every open terminal in place.
    pkill -USR2 -x ghostty 2>/dev/null || true

    echo "==> Theme: $name"
    echo "    Live now: borders, wallpaper, bar, notifications, tmux, next prompt."
    echo "    Per-window: Ctrl+Shift+, reloads a ghostty; nvim/btop/lazygit on relaunch."
    # From the menu bind there's no terminal to read — notify instead.
    if [ ! -t 1 ]; then
      notify-send -a "Theme" -t 3000 "Theme: $name" \
        "ghostty windows: Ctrl+Shift+, · nvim/btop: relaunch"
    fi
    ;;
  *)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
