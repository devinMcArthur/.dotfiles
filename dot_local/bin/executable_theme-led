#!/usr/bin/env bash
# theme-led — put the active theme's accent on the laptop's status LED.
#
#   theme-led            # apply the current theme's accent
#   theme-led off        # give the LED back to the EC (charge status)
#   theme-led <#rrggbb>  # a specific colour
#
# The Framework 13's side LED is the one part of this machine with real
# colour — the keyboard is a single white zone. It normally shows charge
# state under the EC's own `chromeos-auto` trigger, so borrowing it means
# setting the trigger to `none` first; `off` hands it straight back.
#
# Needs the udev rule from run_onchange_after_led-access.sh.

set -uo pipefail

LED=/sys/class/leds/chromeos:multicolor:charging
SRC="$HOME/.local/share/chezmoi"
LEVEL="${THEME_LED_LEVEL:-35}"    # a hint, not a beacon

[ -e "$LED/multi_intensity" ] || { echo "no status LED on this machine" >&2; exit 1; }
[ -w "$LED/multi_intensity" ] || { echo "LED not writable — run 'chezmoi apply' in a terminal" >&2; exit 1; }

active_file() {
  if [ -f "$SRC/.chezmoidata/zz-theme-override.yaml" ]; then
    echo "$SRC/.chezmoidata/zz-theme-override.yaml"
  else
    echo "$SRC/.chezmoidata/theme.yaml"
  fi
}

case "${1:-apply}" in
  off)
    printf 'chromeos-auto' > "$LED/trigger" 2>/dev/null || true
    echo "status LED: back to charge state"
    exit 0
    ;;
  apply) hex="$(sed -n 's/^    accent: *"\{0,1\}#\{0,1\}\([0-9a-fA-F]\{6\}\).*$/\1/p' "$(active_file)" | head -1)" ;;
  *)     hex="${1#\#}" ;;
esac

case "$hex" in
  [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
  *) echo "no usable accent colour (got '${hex:-}')" >&2; exit 1 ;;
esac

# ONE channel only. The LED is a six-colour picker, not an RGB mixer:
# with several channels lit it collapses to blue regardless of the
# weights (observed — an amber accent of "100 61 5" came out blue). A
# channel sweep confirmed all six work individually, so the job is to
# choose the nearest, not to blend.
#
# Hue bands rather than RGB distance, with a saturation floor for white:
# a pale accent like rose-pine's #ebbcba is nearer white than red, and
# RGB distance gets that wrong.
chan="$(python3 -c "
import colorsys, sys
r, g, b = (int('$hex'[i:i+2], 16) / 255 for i in (0, 2, 4))
h, s, v = colorsys.rgb_to_hsv(r, g, b)
deg = h * 360
if s < 0.25:
    print('white')
elif deg < 20 or deg >= 340: print('red')
elif deg < 40:  print('amber')     # matte-black calls its accent amber
elif deg < 75:  print('yellow')
elif deg < 160: print('green')
elif deg < 280: print('blue')
else:           print('red')
")"

# multi_index order: red green blue yellow white amber
case "$chan" in
  red)    vals="100 0 0 0 0 0" ;;
  green)  vals="0 100 0 0 0 0" ;;
  blue)   vals="0 0 100 0 0 0" ;;
  yellow) vals="0 0 0 100 0 0" ;;
  white)  vals="0 0 0 0 100 0" ;;
  amber)  vals="0 0 0 0 0 100" ;;
  *)      vals="0 0 0 0 100 0" ;;
esac

# The EC's own trigger repaints this LED on every charge event, so it has
# to be released before a colour will stick.
printf 'none' > "$LED/trigger" 2>/dev/null || true
printf '%s' "$vals" > "$LED/multi_intensity"
printf '%d' "$LEVEL" > "$LED/brightness"
echo "status LED: #$hex -> $chan @ ${LEVEL}%"
