#!/usr/bin/env bash
# Smart launcher for the win11 KVM VM.
#
# Default invocation (`win` or `win attach`) does whatever is needed to
# put a Windows display on screen: start the domain if it's shut off,
# resume it if it's paused, then attach virt-viewer. Idempotent — running
# `win` again when the viewer is already open just opens another viewer
# attached to the same SPICE socket.
#
# Subcommands:
#   stop          — graceful ACPI shutdown (Windows sees a power button press)
#   force         — hard power-off (use only if `stop` hangs)
#   snap [NAME]   — snapshot with optional name (default: timestamped)
#   restore NAME  — revert to a named snapshot
#   snaps         — list snapshots
#   status        — show domain state

set -euo pipefail

VM=win11
URI=qemu:///system

state() { virsh -c "$URI" domstate "$VM" 2>/dev/null || echo undefined; }

require_defined() {
  [[ "$(state)" != "undefined" ]] || { echo "ERROR: domain '$VM' is not defined in libvirt." >&2; exit 1; }
}

case "${1:-attach}" in
  attach|"")
    require_defined

    # Idempotency: if a virt-viewer is already attached to this URI,
    # just focus its window (Hyprland's focuswindow auto-switches to
    # the workspace containing it). This makes Super+W "take me to
    # Windows" on every press, never spawning a second viewer.
    if pgrep -x virt-viewer >/dev/null 2>&1; then
      if command -v hyprctl >/dev/null 2>&1; then
        hyprctl dispatch focuswindow class:virt-viewer >/dev/null 2>&1 || true
      fi
      exit 0
    fi

    case "$(state)" in
      running) ;;
      paused)
        echo "==> Resuming $VM..."
        virsh -c "$URI" resume "$VM" >/dev/null
        ;;
      *)
        echo "==> Starting $VM..."
        virsh -c "$URI" start "$VM" >/dev/null
        ;;
    esac
    # Fullscreen is owned by HYPRLAND, not virt-viewer. On Wayland,
    # virt-viewer's own --full-screen can't tell which monitor it lands
    # on: the compositor places the window via the `workspace 5 silent`
    # rule AFTER virt-viewer has already sized the guest, so virt-viewer
    # uses the PRIMARY monitor's geometry (eDP-1, 1920x1280 logical) for
    # a window that actually lives on the external KA272 (1920x1080).
    # Result: guest framebuffer ~200px too tall -> ~100px black bar at
    # the top, Windows taskbar clipped off the bottom. (Stripping the
    # persisted monitor-mapping did NOT fix this -- the wrong-monitor
    # geometry is chosen independently of the mapping.)
    #
    # Running virt-viewer WINDOWED and letting Hyprland fullscreen the
    # window makes virt-viewer's guest auto-resize follow the real window
    # size on the real monitor -- and Hyprland re-sizes correctly on
    # every plug/unplug. We can't express this as a static
    # `windowrule = fullscreen` because Hyprland 0.55's parser rejects
    # bare action words ("invalid field fullscreen: missing a value"),
    # so we dispatch fullscreen after the window appears.
    #
    # Tradeoff vs. virt-viewer's own fullscreen: virt-viewer no longer
    # uses the keyboard-shortcuts-inhibit grab, so Super-key combos go to
    # Hyprland instead of Windows (Alt+Tab and ordinary keys still reach
    # the guest when focused). WIN_WINDOWED=1 skips the fullscreen kick
    # and leaves a plain window.
    #
    # No --reconnect: that flag tells virt-viewer to wait for the SPICE
    # socket to return after a drop (useful for remote SPICE over flaky
    # networks). For local qemu:///system, drops only happen on actual
    # VM shutdown, and we want the viewer to exit cleanly when qemu
    # does — not linger on workspace 5 as an empty window.
    virt-viewer --connect "$URI" --attach "$VM" &

    if [[ -z "${WIN_WINDOWED:-}" ]] && command -v hyprctl >/dev/null 2>&1; then
      # Wait for the viewer window to be mapped, then fullscreen it on
      # whichever monitor workspace 5 lives on.
      for _ in $(seq 1 50); do
        if hyprctl clients -j 2>/dev/null | grep -q virt-viewer; then break; fi
        sleep 0.1
      done
      hyprctl dispatch focuswindow class:virt-viewer >/dev/null 2>&1 || true
      hyprctl dispatch fullscreen 0 >/dev/null 2>&1 || true
    fi

    wait
    ;;

  stop)
    require_defined
    echo "==> Graceful shutdown of $VM..."
    virsh -c "$URI" shutdown "$VM"
    ;;

  force)
    require_defined
    echo "==> Force-stopping $VM (Windows sees a power-cord yank)..."
    virsh -c "$URI" destroy "$VM"
    ;;

  snap)
    require_defined
    name="${2:-snap-$(date +%Y%m%d-%H%M%S)}"
    desc="${3:-Snapshot taken $(date '+%Y-%m-%d %H:%M:%S') from win launcher.}"
    echo "==> Snapshotting $VM as '$name'..."
    virsh -c "$URI" snapshot-create-as "$VM" "$name" "$desc"
    ;;

  restore)
    require_defined
    [[ "${2:-}" ]] || { echo "Usage: win restore <snapshot-name>" >&2; exit 2; }
    echo "==> Reverting $VM to snapshot '$2'..."
    virsh -c "$URI" snapshot-revert "$VM" "$2"
    ;;

  snaps)
    require_defined
    virsh -c "$URI" snapshot-list "$VM"
    ;;

  status|s)
    if [[ "$(state)" == "undefined" ]]; then
      echo "$VM: undefined (not configured in libvirt)"
      exit 1
    fi
    virsh -c "$URI" list --all | sed -n '1,2p;/'"$VM"'/p'
    ;;

  -h|--help|help)
    sed -n '2,/^set -e/{/^set -e/d;p}' "$0" | sed 's/^# \?//'
    ;;

  *)
    echo "Unknown subcommand: $1" >&2
    echo "Usage: $(basename "$0") [attach|stop|force|snap [NAME]|restore NAME|snaps|status]" >&2
    exit 2
    ;;
esac
