{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
{{ if ne .chezmoi.osRelease.id "arch" }}exit 0  # this laptop's GPU; not a server concern.{{ end }}
# Kernel command line: things that must be set before userspace exists.
#
# i915.enable_dp_mst=0
#   The AV Access KVM presents a DisplayPort MST hub, and i915 fails to
#   allocate the payload for it:
#     [drm] *ERROR* Step 2 of creating MST payload ... failed: -5
#   Twenty seconds later the display pipeline is gone, taking the
#   compositor, xdg-desktop-portal (segfault in libwayland) and the VTs
#   with it — Ctrl+Alt+F2 showed nothing because there was no console left
#   to switch to. Measured 2026-09-05 on linux-lts 6.18.46.
#
#   This is a tourniquet, not a cure: MST is exactly what drives the three
#   desk monitors down one KVM cable, so refusing it costs two of them.
#   It stays the default because a stable laptop beats a frozen one.
#
# THE WAY OUT, and why there is a second menu entry below: kernel 7.1.9 has
# roughly a year of i915 MST fixes that the 6.18 LTS branch will never get.
# Testing that means booting with the parameter removed, which otherwise
# means hand-editing the kernel line at the GRUB prompt on a machine that
# may be about to freeze. So we generate a menu entry that is the ordinary
# 7.1.9 entry minus the parameter — select it, test, and if it locks up,
# reboot and pick the default again. The default is never the risky one.
#
# ESCAPE HATCH regardless: at any GRUB entry press `e`, edit the `linux`
# line, F10 to boot it once.
#
# /boot is the vfat ESP, so it is outside btrfs snapshots — nothing rolls
# grub.cfg back for us. Hence: back it up, build the new one beside it,
# and only move it into place once it verifies. A failed grub-mkconfig
# then costs an error message rather than a bootable machine.

set -euo pipefail

PARAM="i915.enable_dp_mst=0"
GRUB=/etc/default/grub
CFG=/boot/grub/grub.cfg
CUSTOM=/etc/grub.d/42-mst-test
TITLE="Arch Linux (linux) - DisplayPort MST enabled [test]"

# The 10_linux-generated entry for the non-LTS kernel, which we mirror.
SOURCE_ENTRY="menuentry 'Arch Linux, with Linux linux'"

# Lift that entry out of the live grub.cfg rather than hardcoding a root
# UUID here: if the disk is ever reinstalled, this tracks it automatically.
extract_entry() {
  awk -v want="$SOURCE_ENTRY" '
    index($0, want) { inblock = 1 }
    inblock         { print }
    inblock && /^[[:space:]]*\}[[:space:]]*$/ { exit }
  ' "$CFG"
}

want_custom() {
  local body
  body="$(extract_entry)"
  [ -n "$body" ] || return 1
  printf '#!/bin/sh\n'
  printf 'exec tail -n +3 $0\n'
  printf '%s\n' "$body" \
    | sed -e "s| $PARAM||g" \
          -e "s|$SOURCE_ENTRY|menuentry '$TITLE'|" \
          -e "s|gnulinux-linux-advanced-|gnulinux-linux-mst-test-|"
}

# Fast path, NO sudo — the normal case. Theme switches apply headlessly on
# every unlock and must never reach for a password here.
if grep -q "$PARAM" "$GRUB" 2>/dev/null \
   && grep -q "$PARAM" "$CFG" 2>/dev/null \
   && grep -qF "$TITLE" "$CFG" 2>/dev/null \
   && [ -x "$CUSTOM" ] \
   && want_custom 2>/dev/null | cmp -s - "$CUSTOM"; then
  exit 0
fi

run_root() {
  if sudo -n true 2>/dev/null; then sudo "$@"
  elif [ -t 0 ]; then sudo "$@"
  else
    echo "ERROR: kernel params need sudo — run 'chezmoi apply' in a terminal" >&2
    exit 1
  fi
}

STAMP="$(date +%Y%m%d%H%M%S)"
WAS_ENTRIES="$(grep -c '^[[:space:]]*menuentry' "$CFG" 2>/dev/null || echo 0)"

run_root cp -a "$GRUB" "$GRUB.bak.$STAMP"
# vfat can't carry ownership, so a plain copy for the ESP.
run_root cp "$CFG" "$CFG.bak.$STAMP"

if ! grep -q "$PARAM" "$GRUB" 2>/dev/null; then
  echo "==> Adding $PARAM to the kernel command line..."
  # Append inside the existing quotes, preserving whatever hibernate-setup
  # and friends have already put there.
  run_root sed -i "s|^\(GRUB_CMDLINE_LINUX_DEFAULT=\"[^\"]*\)\"|\1 $PARAM\"|" "$GRUB"
  grep -q "$PARAM" "$GRUB" || { echo "ERROR: failed to edit $GRUB" >&2; exit 1; }
fi

if want_custom > /tmp/mst-test.$$ 2>/dev/null && [ -s /tmp/mst-test.$$ ]; then
  echo "==> Installing the MST test boot entry..."
  run_root cp /tmp/mst-test.$$ "$CUSTOM"
  run_root chmod 755 "$CUSTOM"
  rm -f /tmp/mst-test.$$
else
  rm -f /tmp/mst-test.$$
  echo "WARNING: could not find \"$SOURCE_ENTRY\" in $CFG;" >&2
  echo "         skipping the MST test entry (is the 'linux' kernel installed?)" >&2
fi

# Build beside the live config; the running one stays untouched until the
# new one proves itself.
if ! run_root grub-mkconfig -o "$CFG.new"; then
  run_root rm -f "$CFG.new"
  run_root cp -a "$GRUB.bak.$STAMP" "$GRUB"
  echo "ERROR: grub-mkconfig failed; $GRUB and $CFG left as they were" >&2
  exit 1
fi

NOW_ENTRIES="$(grep -c '^[[:space:]]*menuentry' "$CFG.new" 2>/dev/null || echo 0)"
if [ "$NOW_ENTRIES" -lt 1 ] || [ "$NOW_ENTRIES" -lt "$WAS_ENTRIES" ] \
   || ! grep -q "$PARAM" "$CFG.new" \
   || ! grep -q 'vmlinuz' "$CFG.new"; then
  run_root rm -f "$CFG.new"
  run_root cp -a "$GRUB.bak.$STAMP" "$GRUB"
  echo "ERROR: generated grub.cfg failed inspection" >&2
  echo "       (menuentries was $WAS_ENTRIES, now $NOW_ENTRIES)" >&2
  echo "       Nothing was replaced; the working $CFG is still in place." >&2
  exit 1
fi

run_root mv "$CFG.new" "$CFG"
echo "    done ($NOW_ENTRIES boot entries; backup at $CFG.bak.$STAMP)."
if grep -qF "$TITLE" "$CFG"; then
  echo "    To test MST, pick this at the GRUB menu:"
  echo "      $TITLE"
fi
{{ end -}}
